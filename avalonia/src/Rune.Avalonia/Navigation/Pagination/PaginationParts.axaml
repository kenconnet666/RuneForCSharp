<!--
  Pagination 部件的默认外观（vue-tsx-pro 的 paginationStyles）：页码按钮至少一个控件高度宽（翻页时位置不晃）、左右内边距 space.xs；
  省略号次要色（宽度在 Pagination.cs 里按字号算）；总条数次要色。
  Pager 的链接卡片（vue-tsx-pro 的 pagerStyles）：xs 的 border 边框、md 圆角、内边距 space.md，悬停时边框换品牌色；提示一行次要色 sm，标题 accentText、中等字重。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rune="clr-namespace:Rune.Avalonia">
  <Style Selector="rune|Pagination rune|Button#PART_Page">
    <Setter Property="MinWidth" Value="{rune:Em Resource=Rune.Size.Control}" />
    <Setter Property="Padding" Value="{rune:Em 0.25, 0}" />
  </Style>
  <Style Selector="rune|Pagination Border#PART_Ellipsis">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <Style Selector="rune|Pagination TextBlock#PART_Total">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <Style Selector="rune|Pager rune|ButtonBase#PART_Link">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="CornerRadius" Value="{rune:Em Resource=Rune.Radius.Md}" />
    <Setter Property="Padding" Value="{rune:Em Resource=Rune.Space.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
  </Style>
  <Style Selector="rune|Pager rune|ButtonBase#PART_Link:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Accent}" />
  </Style>
  <Style Selector="rune|Pager rune|Flex#PART_Hint">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="rune|Pager TextBlock#PART_Label">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
  </Style>
</Styles>
