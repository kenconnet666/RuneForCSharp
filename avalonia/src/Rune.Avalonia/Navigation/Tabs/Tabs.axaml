<!--
  Tab、TabPanel 的主题（vue-tsx-pro 的 tabsRecipe、tabPanelStyles）：标签中等字重，平时 textMuted、悬停与选中 text，控件高度、左右 space.md、sm 圆角；
  line 时底边留 2 像素的透明边（指示条画在列表上）并压住列表的分隔线（-1），竖排时在结束边；soft 时选中的标签 surface 底。
  面板 sm 圆角，键盘聚焦时外面一圈焦点环。TabList 的分隔线、指示条与 soft 底色在 Tabs.cs 里画。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Tab}" TargetType="rune:Tab" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="MinHeight" Value="{rune:ControlHeight}" />
    <Setter Property="Padding" Value="{rune:Em 0.75, 0}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="CornerRadius" Value="{rune:Em Resource=Rune.Radius.Sm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- 同 ButtonBase 的模板，多一格关闭按钮：叠在结束端（不用另一层容器，标签仍是列表的直接子元素，指示条按它的位置对齐） -->
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <Canvas Name="PART_Ripples" IsHitTestVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_CloseHost" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{rune:Em 0, 0, 0.25, 0}" />
          <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing"><Setter Property="IsVisible" Value="True" /></Style>
    <!-- 可关闭：结束端给关闭按钮留出 1.25em -->
    <Style Selector="^:closable">
      <Setter Property="Padding" Value="{rune:Em 0.75, 0, 2, 0}" />
    </Style>
    <Style Selector="^:dragging">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    </Style>
    <Style Selector="^:line">
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Margin" Value="0,0,0,-1" />
    </Style>
    <Style Selector="^:line:vertical">
      <Setter Property="BorderThickness" Value="0,0,2,0" />
      <Setter Property="Margin" Value="0,0,-1,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
    </Style>
    <Style Selector="^:soft:selected">
      <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type rune:TabPanel}" TargetType="rune:TabPanel">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="CornerRadius" Value="{rune:Em Resource=Rune.Radius.Sm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" />
          <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False" Margin="-4" BorderThickness="2"
                  BorderBrush="{DynamicResource Rune.Brush.FocusRing}" CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
