<!--
  勾选类控件（Checkbox、Radio、Switch）共用的外层与文字（vue-tsx-pro 的 choiceRecipe 的 root、label、description）：
  整块可点，正文色、行高 normal；不可用时整体变淡，只读时不像能点；文字顶端对齐，说明是 muted（0.875em 在代码里按字号给）。
  控件部件（方框、圆、轨道）的外观在各组件的 *Parts.axaml
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rune="clr-namespace:Rune.Avalonia">
  <Style Selector=":is(rune|ChoiceBase)">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(rune|ChoiceBase):readonly">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector=":is(rune|ChoiceBase):disabled">
    <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
  </Style>
  <Style Selector=":is(rune|ChoiceBase) > ContentPresenter#PART_Label">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector=":is(rune|ChoiceBase) > ContentPresenter#PART_Description">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <!-- 焦点环：键盘聚焦时贴着方框、圆、轨道（focusRingStyles.tight） -->
  <Style Selector=":is(rune|ChoiceBase) > #PART_Control > Border#PART_FocusRing">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.FocusRing}" />
  </Style>
  <Style Selector=":is(rune|ChoiceBase):focus-visible > #PART_Control > Border#PART_FocusRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
</Styles>
