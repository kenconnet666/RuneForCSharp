<!--
  按钮家族的主题（vue-tsx-pro 的 ButtonBase 与 button-core）：
  - ButtonBase：没有外观，只有波纹层、内容、焦点环
  - Rune.ButtonCore（Button、IconButton 共用，BasedOn ButtonBase）：色调决定调色板（代码里绑定），样式档位绑定调色板的字段（DESIGN §4 决定 11），
    36 种组合只写 6 条加 5 条悬停；内部尺寸都是 em：内边距 1em × 0.25em、最小高度 max(2.25em, 24px)
  - Button、IconButton：BasedOn Rune.ButtonCore，只写自己的默认值与模板
  部件的外观写在嵌套样式里（DESIGN §7），使用方的 /template/ 样式排在后面能改
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:ButtonBase}" TargetType="rune:ButtonBase">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <Canvas Name="PART_Ripples" IsHitTestVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
          <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="Rune.ButtonCore" TargetType="rune:ButtonCore" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="Radius" Value="md" />
    <!-- 档位解析出的值（ButtonCore 的代码里解析，Resolved）：放在主题这一层，使用方的样式盖得过 -->
    <Setter Property="Palette" Value="{rune:Resolved Palette}" />
    <Setter Property="CornerRadius" Value="{rune:Em Resolved=Radius}" />
    <Setter Property="Padding" Value="{rune:Em 1, 0.25}" />
    <!-- 控件高度：字号的 2.25 倍（xs 档 2 倍）取整到 4px，不低于 24px（vue-tsx-pro 的 sizes.control） -->
    <Setter Property="MinHeight" Value="{rune:ControlHeight}" />
    <!-- borderWidths.xs、sm 是不随主题变的像素 token（资源是 double，Thickness 不能直接引用）；没有描边色时也占位，各样式等高 -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- 界面文字用 medium：600 在微软雅黑上落成粗体（vue-tsx-pro 0.11 S4） -->
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- 一行里与别的控件居中对齐，不被拉高（链接样式没有最小高度，高度是行高加内边距） -->
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- 行高 lineHeights.tight（1.25em）：文字的行盒与 TS 一样高 -->
    <Setter Property="TextBlock.LineHeight" Value="{rune:Em Resource=Rune.LineHeight.Tight}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />

    <!-- 色调 → 调色板在 ButtonCore 的代码里解析（上面的 Palette setter），不写成 6 条伪类样式 -->

    <!-- 样式 → 调色板的字段；悬停只在可用时（不可用的控件收不到指针） -->
    <Style Selector="^:solid">
      <Setter Property="Background" Value="{Binding $self.Palette.Solid}" />
      <Setter Property="Foreground" Value="{Binding $self.Palette.Contrast}" />
    </Style>
    <Style Selector="^:solid:pointerover:not(:soft-disabled)"><Setter Property="Background" Value="{Binding $self.Palette.SolidHover}" /></Style>
    <Style Selector="^:soft">
      <Setter Property="Background" Value="{Binding $self.Palette.Soft}" />
      <Setter Property="Foreground" Value="{Binding $self.Palette.Text}" />
    </Style>
    <Style Selector="^:soft:pointerover:not(:soft-disabled)"><Setter Property="Background" Value="{Binding $self.Palette.SoftHover}" /></Style>
    <Style Selector="^:surface">
      <Setter Property="Background" Value="{Binding $self.Palette.Surface}" />
      <Setter Property="Foreground" Value="{Binding $self.Palette.Text}" />
      <Setter Property="BorderBrush" Value="{Binding $self.Palette.Border}" />
    </Style>
    <Style Selector="^:surface:pointerover:not(:soft-disabled)"><Setter Property="Background" Value="{Binding $self.Palette.SoftHover}" /></Style>
    <Style Selector="^:outline">
      <Setter Property="Foreground" Value="{Binding $self.Palette.Text}" />
      <Setter Property="BorderBrush" Value="{Binding $self.Palette.Border}" />
    </Style>
    <Style Selector="^:outline:pointerover:not(:soft-disabled)"><Setter Property="Background" Value="{Binding $self.Palette.SubtleHover}" /></Style>
    <Style Selector="^:ghost"><Setter Property="Foreground" Value="{Binding $self.Palette.Text}" /></Style>
    <Style Selector="^:ghost:pointerover:not(:soft-disabled)"><Setter Property="Background" Value="{Binding $self.Palette.SubtleHover}" /></Style>
    <!-- 链接样式：无底、左右内边距 0（上下 0.25em 保留）、最小高度 0、字重 medium，悬停下划线 -->
    <Style Selector="^:link">
      <Setter Property="Foreground" Value="{Binding $self.Palette.Text}" />
      <Setter Property="Padding" Value="{rune:Em 0, 0.25}" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="^:link:pointerover:not(:soft-disabled) /template/ TextBlock"><Setter Property="TextDecorations" Value="Underline" /></Style>

    <!-- 不可用（:disabled）与可聚焦的不可用（:soft-disabled）一个样子，光标是"禁止"；悬停变色只在可用时（可聚焦的不可用照样收到悬停，变色会让人以为还能点） -->
    <Style Selector="^:disabled, ^:soft-disabled">
      <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
      <Setter Property="Cursor" Value="No" />
    </Style>
    <!-- 加载中：内容透明（保留宽度与读屏名称），旋转指示盖在中间 -->
    <Style Selector="^:spinner /template/ StackPanel#PART_Content"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:spinner /template/ rune|Spinner#PART_Spinner"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type rune:Button}" TargetType="rune:Button" BasedOn="{StaticResource Rune.ButtonCore}">
    <Setter Property="Variant" Value="solid" />
    <Setter Property="Tone" Value="accent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <Canvas Name="PART_Ripples" IsHitTestVisible="False" />
              <StackPanel Name="PART_Content" Orientation="Horizontal" Spacing="{rune:Em 0.5, Of=TemplatedParent}" Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <rune:Icon Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center"
                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                <rune:Icon Name="PART_IconEnd" Data="{TemplateBinding IconEnd}" VerticalAlignment="Center"
                           IsVisible="{TemplateBinding IconEnd, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <rune:Spinner Name="PART_Spinner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
          <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 图标按钮：宽高相等（宽度 = 最小高度 max(2.25em, 24px)，左右内边距 0），默认 ghost、中性色 -->
  <ControlTheme x:Key="{x:Type rune:IconButton}" TargetType="rune:IconButton" BasedOn="{StaticResource Rune.ButtonCore}">
    <Setter Property="Variant" Value="ghost" />
    <Setter Property="Tone" Value="neutral" />
    <Setter Property="Padding" Value="{rune:Em 0, 0.25}" />
    <Setter Property="Width" Value="{rune:ControlHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <Canvas Name="PART_Ripples" IsHitTestVisible="False" />
              <StackPanel Name="PART_Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <rune:Icon Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center" />
              </StackPanel>
              <rune:Spinner Name="PART_Spinner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
          </Border>
          <Border Name="PART_FocusRing" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 链接按钮：外观同 Button / IconButton；外部链接没写 IconEnd 时显示外链图标（本地值盖过样式） -->
  <ControlTheme x:Key="{x:Type rune:LinkButton}" TargetType="rune:LinkButton" BasedOn="{StaticResource {x:Type rune:Button}}">
    <Style Selector="^[External=True]"><Setter Property="IconEnd" Value="{x:Static rune:Lucide.ArrowUpRight}" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type rune:IconLinkButton}" TargetType="rune:IconLinkButton" BasedOn="{StaticResource {x:Type rune:IconButton}}" />

  <!-- 预设的图标按钮：只换图标，读屏名称在代码里取语言包 -->
  <ControlTheme x:Key="{x:Type rune:CloseButton}" TargetType="rune:CloseButton" BasedOn="{StaticResource {x:Type rune:IconButton}}">
    <Setter Property="Icon" Value="{x:Static rune:Lucide.X}" />
  </ControlTheme>
  <ControlTheme x:Key="{x:Type rune:ClearButton}" TargetType="rune:ClearButton" BasedOn="{StaticResource {x:Type rune:IconButton}}">
    <Setter Property="Icon" Value="{x:Static rune:Lucide.CircleX}" />
  </ControlTheme>
</ResourceDictionary>
