<!--
  Kbd 的主题（vue-tsx-pro 的 kbdStyles.root）：字号在 Kbd.cs 里按外面的 0.85 倍绑定，这里的 em 都按它算
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Kbd}" TargetType="rune:Kbd">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <!-- borderWidths.xs，底边 borderWidths.sm：看起来像一个按键 -->
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Rune.Font.Mono}" />
    <Setter Property="MinWidth" Value="{rune:Em 1.6}" />
    <Setter Property="Padding" Value="{rune:Em 0.25, 0}" />
    <Setter Property="CornerRadius" Value="{rune:Em Resource=Rune.Radius.Sm}" />
    <Setter Property="TextBlock.LineHeight" Value="{rune:Em Resource=Rune.LineHeight.Snug}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Snug}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
