<!-- Blockquote 的主题（vue-tsx-pro 的 blockquoteStyles.root）：起始边的竖线跟着 FlowDirection 镜像 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Blockquote}" TargetType="rune:Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderStrong}" />
    <!-- borderWidths.md -->
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="{rune:Em 1, 0.25, 0, 0.25}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <StackPanel>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- 出处：小一号，和引用隔开 space.xs；书名、作者不用斜体 -->
            <StackPanel Name="PART_Source" Orientation="Horizontal" Margin="{rune:Em 0, 0.25, 0, 0}"
                        IsVisible="{TemplateBinding Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                        TextElement.FontSize="{DynamicResource Rune.FontSize.Sm}">
              <TextBlock Text="— " />
              <ContentPresenter Content="{TemplateBinding Source}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
