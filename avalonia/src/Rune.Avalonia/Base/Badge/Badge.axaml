<!--
  Badge 的主题：只放默认值（vue-tsx-pro 的 badgeRecipe.defaults 与 BadgeOptions 的默认），Provider 的样式能改。
  样式档位的颜色、em 尺寸在 Badge.cs 里（自绘组件，不用模板与嵌套样式，DESIGN §9）；色调解析出的调色板在这里绑过来（使用方的样式盖得过）
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Badge}" TargetType="rune:Badge">
    <Setter Property="Variant" Value="soft" />
    <Setter Property="Tone" Value="neutral" />
    <Setter Property="Size" Value="xs" />
    <Setter Property="Radius" Value="sm" />
    <Setter Property="Padding" Value="{rune:Em 0.5, 0}" />
    <!-- borderWidths.xs：没有描边色时也占位，各样式等高 -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- 文字中等字重、行高 lineHeights.tight（vue-tsx-pro 的 badgeRecipe 的 root） -->
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="TextBlock.LineHeight" Value="{rune:Em Resource=Rune.LineHeight.Tight}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="Palette" Value="{rune:Resolved Palette}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </ControlTheme>
</ResourceDictionary>
