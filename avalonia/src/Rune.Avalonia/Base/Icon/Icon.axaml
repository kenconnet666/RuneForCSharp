<!-- Icon 的主题：线宽取 strokeWidths.md；色调对应 vue-tsx-pro 的 toneStyles（inherit 与不写一样，跟随外面的文字颜色） -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Icon}" TargetType="rune:Icon">
    <Setter Property="StrokeWidth" Value="{DynamicResource Rune.StrokeWidth.Md}" />
    <Style Selector="^:neutral"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Style>
    <Style Selector="^:muted"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" /></Style>
    <Style Selector="^:accent"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Style>
    <Style Selector="^:danger"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /></Style>
    <Style Selector="^:success"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /></Style>
    <Style Selector="^:warning"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /></Style>
    <Style Selector="^:info"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /></Style>
  </ControlTheme>
</ResourceDictionary>
