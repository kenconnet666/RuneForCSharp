<!-- Icon 的主题：线宽取 strokeWidths.md。色调的颜色（vue-tsx-pro 的 toneStyles）在代码里按模板优先级绑定，不写成 7 条伪类样式（每个图标省 7 个激活器） -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Icon}" TargetType="rune:Icon">
    <Setter Property="StrokeWidth" Value="{DynamicResource Rune.StrokeWidth.Md}" />
  </ControlTheme>
</ResourceDictionary>
