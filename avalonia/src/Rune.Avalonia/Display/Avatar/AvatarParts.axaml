<!-- Avatar 部件的默认外观：图片铺满并裁剪（object-fit: cover），后备内容居中（DESIGN §7 代码组合的控件） -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rune="clr-namespace:Rune.Avalonia">
  <Style Selector="rune|Avatar > Border > Panel > Image#PART_Image">
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>
  <Style Selector="rune|Avatar > Border > Panel > ContentPresenter#PART_Fallback">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- 后备文字层自己定字重与行高（上游 fallback：medium、line-height 1）：放进设了行高的容器（条目列表）里也不跟着变 -->
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="TextBlock.LineHeight" Value="{rune:Em 1}" />
  </Style>
</Styles>
