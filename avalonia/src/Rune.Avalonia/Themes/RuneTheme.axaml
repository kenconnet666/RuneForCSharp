<!--
  组件库的入口：使用方把它加到 Application.Styles（放在 FluentTheme 之后）。
  主题 tokens（tools/token-gen 从 vue-tsx-pro 生成）与各组件的 ControlTheme 都合并到这里。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Rune.Avalonia.RuneTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Rune.Avalonia/Config/Generated/Tokens.g.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Icon/Icon.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Text/Text.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Heading/Heading.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Kbd/Kbd.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Code/Code.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Blockquote/Blockquote.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Spinner/Spinner.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Badge/Badge.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Button/Button.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Link/Link.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/List/List.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Base/Indicator/Indicator.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Layout/Separator/Separator.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Layout/Prose/Prose.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Navigation/Toolbar/Toolbar.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Display/Card/Card.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Display/Avatar/Avatar.axaml" />
        <ResourceInclude Source="avares://Rune.Avalonia/Input/Switch/Switch.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- 代码组合控件的部件默认外观（ControlTheme 写不了子选择器，DESIGN §7） -->
  <StyleInclude Source="avares://Rune.Avalonia/Base/Badge/BadgeParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Base/Indicator/IndicatorParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Layout/Separator/SeparatorParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Display/Card/CardParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Display/Avatar/AvatarParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Feedback/Empty/EmptyParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Feedback/Progress/ProgressParts.axaml" />
  <StyleInclude Source="avares://Rune.Avalonia/Input/Switch/SwitchParts.axaml" />
</Styles>
