<!--
  平台 ToolTip 的主题（vue-tsx-pro 的 tooltipStyles.panel）：反色底、sm 字号、行高 normal、sm 圆角，内边距上下 0.25em、左右 0.5em，最宽 20em。
  与触发器的距离是模板根（TooltipLayout）在主轴两侧留的透明边；箭头（PART_Arrow）的位置由 Tooltip.cs 在显示后写。
  淡入在 Tooltip.cs 里（时长取作用域的 token，系统关闭动画时不播）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.InverseSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InverseText}" />
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="TextBlock.LineHeight" Value="{rune:Em Resource=Rune.LineHeight.Normal}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="Padding" Value="{rune:Em 0.5, 0.25}" />
    <Setter Property="CornerRadius" Value="{rune:Em Resource=Rune.Radius.Sm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <rune:TooltipLayout>
          <!-- 箭头在面板后面：伸进面板的一半被盖住，只露出尖角 -->
          <Canvas>
            <Border Name="PART_Arrow" IsVisible="False" Width="{rune:Em 0.625, Of=TemplatedParent}" Height="{rune:Em 0.625, Of=TemplatedParent}"
                    Background="{TemplateBinding Background}" CornerRadius="0,0,2,0" />
          </Canvas>
          <Border Name="PART_Panel" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" MaxWidth="{rune:Em 20, Of=TemplatedParent}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              TextBlock.TextWrapping="Wrap" />
          </Border>
        </rune:TooltipLayout>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
