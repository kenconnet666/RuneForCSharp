<!--
  Dialog 部件的默认外观（vue-tsx-pro 的 modalPartStyles、transitions.backdrop）：遮罩 overlay；面板 surfaceRaised、xs 宽的 border 描边、xl 阴影、文字 text
  （xl 圆角、各部件的内边距按 em 在 Dialog.cs 里算）。弹出层里的元素在逻辑上仍是 Dialog 的后代。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rune="clr-namespace:Rune.Avalonia">
  <Style Selector="rune|Dialog Border#PART_Scrim">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Overlay}" />
  </Style>
  <Style Selector="rune|Dialog Border#PART_Panel">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource Rune.Shadow.Xl}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
</Styles>
