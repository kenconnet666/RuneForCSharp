<!-- Splitter 的主题（vue-tsx-pro 的 splitterStyles）：Bordered 时表面色、边框色（粗细与圆角在代码里按字号算） -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Avalonia">
  <ControlTheme x:Key="{x:Type rune:Splitter}" TargetType="rune:Splitter">
    <Style Selector="^[Bordered=True]">
      <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
