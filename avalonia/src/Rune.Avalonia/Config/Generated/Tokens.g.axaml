    <!-- 薰衣草（lavender，亮色） -->
    <ResourceDictionary x:Key="{x:Static rune:RuneThemeVariants.Lavender}">
      <!-- colors -->
      <Color x:Key="Rune.Color.Background">#FFF7F4FC</Color>
      <SolidColorBrush x:Key="Rune.Brush.Background" Color="#FFF7F4FC" />
      <Color x:Key="Rune.Color.Surface">#FFFFFFFF</Color>
