      <!-- shadows -->
      <BoxShadows x:Key="Rune.Shadow.None">none</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Xs">0 1 1 0 #66000000, 0 2 1 -1 #66000000, 0 1 3 0 #4D000000</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Sm">0 2 3 -2 #26000000, 0 3 8 -2 #66000000, 0 4 12 -4 #80000000</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Md">0 8 40 0 #26000000, 0 12 32 -16 #4D000000</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Lg">0 12 60 0 #4D000000, 0 12 32 -16 #80000000</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Xl">0 12 60 0 #33000000, 0 16 64 0 #66000000, 0 16 36 -20 #E6000000</BoxShadows>

      <!-- fonts -->
      <FontFamily x:Key="Rune.Font.Sans">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>
      <FontFamily x:Key="Rune.Font.Mono">Cascadia Code, JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono</FontFamily>
      <FontFamily x:Key="Rune.Font.Serif">Noto Serif SC, Source Han Serif SC, Songti SC, STSong, SimSun, Georgia</FontFamily>
      <FontFamily x:Key="Rune.Font.Heading">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>

      <!-- radii -->
      <x:Double x:Key="Rune.Radius.None">0</x:Double>
      <x:Double x:Key="Rune.Radius.Xs">0.15</x:Double>
      <x:Double x:Key="Rune.Radius.Sm">0.25</x:Double>
      <x:Double x:Key="Rune.Radius.Md">0.4</x:Double>
      <x:Double x:Key="Rune.Radius.Lg">0.7</x:Double>
      <x:Double x:Key="Rune.Radius.Xl">1</x:Double>
      <x:Double x:Key="Rune.Radius.Full">9999</x:Double>

      <!-- 色调调色板（DESIGN §4）：组件的样式档位引用它的字段 -->
      <rune:TonePalette x:Key="Rune.Palette.Neutral" Solid="{StaticResource Rune.Brush.InverseSurface}" SolidHover="{StaticResource Rune.Brush.InverseSurfaceHover}" Contrast="{StaticResource Rune.Brush.InverseText}" Soft="{StaticResource Rune.Brush.Fill}" SoftHover="{StaticResource Rune.Brush.FillHover}" Surface="{StaticResource Rune.Brush.Surface}" SubtleHover="{StaticResource Rune.Brush.FillHover}" Text="{StaticResource Rune.Brush.Text}" Border="{StaticResource Rune.Brush.Border}" />
      <rune:TonePalette x:Key="Rune.Palette.Accent" Solid="{StaticResource Rune.Brush.Accent}" SolidHover="{StaticResource Rune.Brush.AccentHover}" Contrast="{StaticResource Rune.Brush.AccentContrast}" Soft="{StaticResource Rune.Brush.AccentSoft}" SoftHover="{StaticResource Rune.Brush.AccentSoftHover}" Surface="{StaticResource Rune.Brush.AccentSoft}" SubtleHover="{StaticResource Rune.Brush.AccentSoft}" Text="{StaticResource Rune.Brush.AccentText}" Border="{StaticResource Rune.Brush.AccentBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Info" Solid="{StaticResource Rune.Brush.Info}" SolidHover="{StaticResource Rune.Brush.InfoHover}" Contrast="{StaticResource Rune.Brush.InfoContrast}" Soft="{StaticResource Rune.Brush.InfoSoft}" SoftHover="{StaticResource Rune.Brush.InfoSoftHover}" Surface="{StaticResource Rune.Brush.InfoSoft}" SubtleHover="{StaticResource Rune.Brush.InfoSoft}" Text="{StaticResource Rune.Brush.InfoText}" Border="{StaticResource Rune.Brush.InfoBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Success" Solid="{StaticResource Rune.Brush.Success}" SolidHover="{StaticResource Rune.Brush.SuccessHover}" Contrast="{StaticResource Rune.Brush.SuccessContrast}" Soft="{StaticResource Rune.Brush.SuccessSoft}" SoftHover="{StaticResource Rune.Brush.SuccessSoftHover}" Surface="{StaticResource Rune.Brush.SuccessSoft}" SubtleHover="{StaticResource Rune.Brush.SuccessSoft}" Text="{StaticResource Rune.Brush.SuccessText}" Border="{StaticResource Rune.Brush.SuccessBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Warning" Solid="{StaticResource Rune.Brush.Warning}" SolidHover="{StaticResource Rune.Brush.WarningHover}" Contrast="{StaticResource Rune.Brush.WarningContrast}" Soft="{StaticResource Rune.Brush.WarningSoft}" SoftHover="{StaticResource Rune.Brush.WarningSoftHover}" Surface="{StaticResource Rune.Brush.WarningSoft}" SubtleHover="{StaticResource Rune.Brush.WarningSoft}" Text="{StaticResource Rune.Brush.WarningText}" Border="{StaticResource Rune.Brush.WarningBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Danger" Solid="{StaticResource Rune.Brush.Danger}" SolidHover="{StaticResource Rune.Brush.DangerHover}" Contrast="{StaticResource Rune.Brush.DangerContrast}" Soft="{StaticResource Rune.Brush.DangerSoft}" SoftHover="{StaticResource Rune.Brush.DangerSoftHover}" Surface="{StaticResource Rune.Brush.DangerSoft}" SubtleHover="{StaticResource Rune.Brush.DangerSoft}" Text="{StaticResource Rune.Brush.DangerText}" Border="{StaticResource Rune.Brush.DangerBorder}" />
    </ResourceDictionary>
