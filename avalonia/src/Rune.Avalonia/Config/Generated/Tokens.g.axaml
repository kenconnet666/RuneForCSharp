      <!-- shadows -->
      <BoxShadows x:Key="Rune.Shadow.None">none</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Xs">0 1 1 0 #0A143C34, 0 2 1 -1 #0D143C34, 0 1 3 0 #0D143C34</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Sm">0 2 3 -2 #0F143C34, 0 3 12 -4 #1A143C34, 0 4 16 -8 #1A143C34</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Md">0 8 40 0 #0D143C34, 0 12 32 -16 #14143C34</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Lg">0 12 60 0 #26143C34, 0 12 32 -16 #1F143C34</BoxShadows>
      <BoxShadows x:Key="Rune.Shadow.Xl">0 12 60 0 #26143C34, 0 16 64 0 #0A143C34, 0 16 36 -20 #33143C34</BoxShadows>

