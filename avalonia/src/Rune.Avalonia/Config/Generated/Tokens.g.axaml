<!-- 由 tools/token-gen 从 vue-tsx-pro 的 packages/ui/src/config/theme 生成，不要手改；改了那边的 token 后运行 node tools/token-gen/token-gen.mjs -->
<!-- em 类的长度（间距、圆角、控件高度、字间距）是系数，乘以元素的字号；px、rem 类已换成设备无关像素 -->
<!-- 跳过的 token：sizes.full（100%：平台上用拉伸（Stretch）） -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:rune="clr-namespace:Rune.Avalonia">

  <!-- fontSizes -->
  <!-- xs = 12px（设备无关像素）：`12px`：辅助说明、标签 -->
  <x:Double x:Key="Rune.FontSize.Xs">12</x:Double>
  <!-- sm = 13px（设备无关像素）：`13px`：紧凑控件 -->
  <x:Double x:Key="Rune.FontSize.Sm">13</x:Double>
  <!-- md = 14px（设备无关像素）：`14px`：正文与默认控件；Provider 用它设置区域的基准字号 -->
  <x:Double x:Key="Rune.FontSize.Md">14</x:Double>
  <!-- lg = 16px（设备无关像素）：`16px`：宽松控件、小标题 -->
  <x:Double x:Key="Rune.FontSize.Lg">16</x:Double>
  <!-- xl = 18px（设备无关像素）：`18px`：强调文字、卡片标题 -->
  <x:Double x:Key="Rune.FontSize.Xl">18</x:Double>
  <!-- xxl = 24px（设备无关像素）：`24px`：页面标题 -->
  <x:Double x:Key="Rune.FontSize.Xxl">24</x:Double>
  <!-- xxxl = 30px（设备无关像素）：`30px`：大标题 -->
  <x:Double x:Key="Rune.FontSize.Xxxl">30</x:Double>

  <!-- fontWeights -->
  <!-- light = 300：`300` -->
  <FontWeight x:Key="Rune.FontWeight.Light">Light</FontWeight>
  <!-- normal = 400：`400`：正文 -->
  <FontWeight x:Key="Rune.FontWeight.Normal">Normal</FontWeight>
  <!-- medium = 500：`500`：标签、表头 -->
  <FontWeight x:Key="Rune.FontWeight.Medium">Medium</FontWeight>
  <!-- semibold = 600：`600`：按钮、标题 -->
  <FontWeight x:Key="Rune.FontWeight.Semibold">SemiBold</FontWeight>
  <!-- bold = 700：`700` -->
  <FontWeight x:Key="Rune.FontWeight.Bold">Bold</FontWeight>

  <!-- lineHeights -->
  <!-- none = 1：`1`：图标、单行徽标 -->
  <x:Double x:Key="Rune.LineHeight.None">1</x:Double>
  <!-- tight = 1.25：`1.25`：按钮等单行控件、标题 -->
  <x:Double x:Key="Rune.LineHeight.Tight">1.25</x:Double>
  <!-- snug = 1.375：`1.375`：紧凑的多行文字 -->
  <x:Double x:Key="Rune.LineHeight.Snug">1.375</x:Double>
  <!-- normal = 1.5：`1.5`：正文 -->
  <x:Double x:Key="Rune.LineHeight.Normal">1.5</x:Double>
  <!-- relaxed = 1.75：`1.75`：长文阅读 -->
  <x:Double x:Key="Rune.LineHeight.Relaxed">1.75</x:Double>

  <!-- letterSpacings -->
  <!-- tighter = -0.02em（em 系数）：`-0.02em`：大标题 -->
  <x:Double x:Key="Rune.LetterSpacing.Tighter">-0.02</x:Double>
  <!-- tight = -0.01em（em 系数）：`-0.01em`：小标题 -->
  <x:Double x:Key="Rune.LetterSpacing.Tight">-0.01</x:Double>
  <!-- normal = 0（设备无关像素）：`0`：正文 -->
  <x:Double x:Key="Rune.LetterSpacing.Normal">0</x:Double>
  <!-- wide = 0.02em（em 系数）：`0.02em`：小字号的标签 -->
  <x:Double x:Key="Rune.LetterSpacing.Wide">0.02</x:Double>
  <!-- wider = 0.05em（em 系数）：`0.05em`：全大写的英文标签 -->
  <x:Double x:Key="Rune.LetterSpacing.Wider">0.05</x:Double>

  <!-- space -->
  <!-- none = 0（设备无关像素）：`0` -->
  <x:Double x:Key="Rune.Space.None">0</x:Double>
  <!-- xxs = 0.125em（em 系数）：`0.125em`：紧挨着的两行（标题与说明）、挨在一起的小按钮之间 -->
  <x:Double x:Key="Rune.Space.Xxs">0.125</x:Double>
  <!-- xs = 0.25em（em 系数）：`0.25em`：图标与文字之间、控件的上下内边距 -->
  <x:Double x:Key="Rune.Space.Xs">0.25</x:Double>
  <!-- sm = 0.5em（em 系数）：`0.5em`：控件内部元素之间 -->
  <x:Double x:Key="Rune.Space.Sm">0.5</x:Double>
  <!-- md = 0.75em（em 系数）：`0.75em`：输入框水平内边距、浮层内边距 -->
  <x:Double x:Key="Rune.Space.Md">0.75</x:Double>
  <!-- lg = 1em（em 系数）：`1em`：按钮水平内边距、表单项之间 -->
  <x:Double x:Key="Rune.Space.Lg">1</x:Double>
  <!-- xl = 1.5em（em 系数）：`1.5em`：卡片、对话框内边距 -->
  <x:Double x:Key="Rune.Space.Xl">1.5</x:Double>

  <!-- sizes -->
  <!-- control = round(nearest, 2.25em, 4px)（em 系数）：`round(nearest, 2.25em, 4px)`：单行控件（按钮、输入框、下拉框）的高度。字号的 2.25 倍取整到 4px： 13 / 14 / 16 / 18px 的字号是 28 / 32 / 36 / 40px，整数像素的边框在 1 倍屏上不发虚； 字号档位 xs 另给 2 倍（12px → 24px，见 fontSizeStyles），不与 sm 同高 -->
  <x:Double x:Key="Rune.Size.Control">2.25</x:Double>
  <x:Double x:Key="Rune.Size.ControlRound">4</x:Double>
  <!-- minTarget = 24px（设备无关像素）：`24px`：可点击区域的最小尺寸（WCAG 2.2 目标尺寸 24×24），与 control 取较大值 -->
  <x:Double x:Key="Rune.Size.MinTarget">24</x:Double>
  <!-- xs = 30rem（设备无关像素）：`30rem`（480px）：窄内容，如登录表单 -->
  <x:Double x:Key="Rune.Size.Xs">480</x:Double>
  <!-- sm = 40rem（设备无关像素）：`40rem`（640px）：表单页、设置页 -->
  <x:Double x:Key="Rune.Size.Sm">640</x:Double>
  <!-- md = 48rem（设备无关像素）：`48rem`（768px）：文章、详情页 -->
  <x:Double x:Key="Rune.Size.Md">768</x:Double>
  <!-- lg = 64rem（设备无关像素）：`64rem`（1024px）：常规页面 -->
  <x:Double x:Key="Rune.Size.Lg">1024</x:Double>
  <!-- xl = 80rem（设备无关像素）：`80rem`（1280px）：宽表格、仪表盘 -->
  <x:Double x:Key="Rune.Size.Xl">1280</x:Double>

  <!-- borderWidths -->
  <!-- none = 0（设备无关像素）：`0` -->
  <x:Double x:Key="Rune.BorderWidth.None">0</x:Double>
  <!-- xs = 1px（设备无关像素）：`1px`：边框、分隔线 -->
  <x:Double x:Key="Rune.BorderWidth.Xs">1</x:Double>
  <!-- sm = 2px（设备无关像素）：`2px`：焦点环宽度与间隔、选中态的强调边框 -->
  <x:Double x:Key="Rune.BorderWidth.Sm">2</x:Double>
  <!-- md = 3px（设备无关像素）：`3px`：提示条侧边的色条 -->
  <x:Double x:Key="Rune.BorderWidth.Md">3</x:Double>
  <!-- lg = 4px（设备无关像素）：`4px` -->
  <x:Double x:Key="Rune.BorderWidth.Lg">4</x:Double>
  <!-- xl = 6px（设备无关像素）：`6px` -->
  <x:Double x:Key="Rune.BorderWidth.Xl">6</x:Double>

  <!-- durations -->
  <!-- none = 0ms：`0ms` -->
  <sys:TimeSpan x:Key="Rune.Duration.None">00:00:00</sys:TimeSpan>
  <!-- xs = { default=75ms; [reduce]=0ms }：`75ms`：按下反馈 -->
  <sys:TimeSpan x:Key="Rune.Duration.Xs">00:00:00.075</sys:TimeSpan>
  <!-- sm = { default=120ms; [reduce]=0ms }：`120ms`：悬停的颜色变化 -->
  <sys:TimeSpan x:Key="Rune.Duration.Sm">00:00:00.12</sys:TimeSpan>
  <!-- md = { default=200ms; [reduce]=0ms }：`200ms`：展开、淡入、浮层出现 -->
  <sys:TimeSpan x:Key="Rune.Duration.Md">00:00:00.2</sys:TimeSpan>
  <!-- lg = { default=300ms; [reduce]=0ms }：`300ms`：抽屉滑入、图表的进场、主题切换的展开、波纹与骨架的扫光 -->
  <sys:TimeSpan x:Key="Rune.Duration.Lg">00:00:00.3</sys:TimeSpan>
  <!-- xl = { default=500ms; [reduce]=0ms }：`500ms`：大面积的页面切换 -->
  <sys:TimeSpan x:Key="Rune.Duration.Xl">00:00:00.5</sys:TimeSpan>

  <!-- easings -->
  <!-- standard = cubic-bezier(0.2, 0, 0, 1)：标准：位置与尺寸变化 -->
  <SplineEasing x:Key="Rune.Easing.Standard" X1="0.2" Y1="0" X2="0" Y2="1" />
  <!-- enter = cubic-bezier(0.05, 0.7, 0.1, 1)：进入：元素出现（先快后慢） -->
  <SplineEasing x:Key="Rune.Easing.Enter" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />
  <!-- exit = cubic-bezier(0.3, 0, 0.8, 0.15)：退出：元素消失（先慢后快） -->
  <SplineEasing x:Key="Rune.Easing.Exit" X1="0.3" Y1="0" X2="0.8" Y2="0.15" />

  <!-- opacities -->
  <!-- disabled = 0.5：`0.5`：不可用的元素 -->
  <x:Double x:Key="Rune.Opacity.Disabled">0.5</x:Double>

  <!-- strokeWidths -->
  <!-- xs = 1：`1`：细线图标 -->
  <x:Double x:Key="Rune.StrokeWidth.Xs">1</x:Double>
  <!-- sm = 1.5：`1.5` -->
  <x:Double x:Key="Rune.StrokeWidth.Sm">1.5</x:Double>
  <!-- md = 2：`2`：Lucide 的默认线宽 -->
  <x:Double x:Key="Rune.StrokeWidth.Md">2</x:Double>
  <!-- lg = 2.5：`2.5` -->
  <x:Double x:Key="Rune.StrokeWidth.Lg">2.5</x:Double>
  <!-- xl = 3：`3`：粗线图标 -->
  <x:Double x:Key="Rune.StrokeWidth.Xl">3</x:Double>

  <!-- 随主题变的组（colors、shadows、fonts、radii）：每套内置主题一份；说明只写在亮色里 -->
  <ResourceDictionary.ThemeDictionaries>
    <!-- 亮色（light） -->
    <ResourceDictionary x:Key="Light">
      <!-- colors -->
      <!-- background = #f9f9fb：页面背景。亮色 slate 2 `#f9f9fb`（着一点色，白色的卡片、输入框浮在上面），暗色 slate 1 `#111113` -->
      <Color x:Key="Rune.Color.Background">#FFF9F9FB</Color>
      <SolidColorBrush x:Key="Rune.Brush.Background" Color="#FFF9F9FB" />
      <!-- surface = #ffffff：卡片、输入框等表面。亮色白 `#ffffff`，暗色 slate 2 `#18191b`：都比页面亮一层 -->
      <Color x:Key="Rune.Color.Surface">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.Surface" Color="#FFFFFFFF" />
      <!-- surfaceMuted = #f4f4f7：弱化的区域背景：表头、侧栏、代码块。亮色取 slate 2 与 3 的中间 `#f4f4f7`（放在页面上也看得出），暗色 slate 2 `#18191b` -->
      <Color x:Key="Rune.Color.SurfaceMuted">#FFF4F4F7</Color>
      <SolidColorBrush x:Key="Rune.Brush.SurfaceMuted" Color="#FFF4F4F7" />
      <!-- surfaceRaised = #ffffff：浮层（弹出框、菜单、对话框）表面，靠描边与阴影区分层级。亮色白 `#ffffff`，暗色 slate 2 `#18191b` （暗色不取第 3 级：那是 fill，浮层里的填充会看不见） -->
      <Color x:Key="Rune.Color.SurfaceRaised">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.SurfaceRaised" Color="#FFFFFFFF" />
      <!-- fill = #f0f0f3：填充：标签、开关关闭态、弱按钮。slate 3：亮色 `#f0f0f3`，暗色 `#212225` -->
      <Color x:Key="Rune.Color.Fill">#FFF0F0F3</Color>
      <SolidColorBrush x:Key="Rune.Brush.Fill" Color="#FFF0F0F3" />
      <!-- fillHover = #e8e8ec：填充悬停；也用于幽灵按钮、菜单项的悬停背景。slate 4：亮色 `#e8e8ec`，暗色 `#272a2d` -->
      <Color x:Key="Rune.Color.FillHover">#FFE8E8EC</Color>
      <SolidColorBrush x:Key="Rune.Brush.FillHover" Color="#FFE8E8EC" />
      <!-- fillActive = #e0e1e6：填充按下、选中。slate 5：亮色 `#e0e1e6`，暗色 `#2e3135` -->
      <Color x:Key="Rune.Color.FillActive">#FFE0E1E6</Color>
      <SolidColorBrush x:Key="Rune.Brush.FillActive" Color="#FFE0E1E6" />
      <!-- text = #1c2024：主要文字。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
      <Color x:Key="Rune.Color.Text">#FF1C2024</Color>
      <SolidColorBrush x:Key="Rune.Brush.Text" Color="#FF1C2024" />
      <!-- textMuted = #60646c：次要文字、说明、图标。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
      <Color x:Key="Rune.Color.TextMuted">#FF60646C</Color>
      <SolidColorBrush x:Key="Rune.Brush.TextMuted" Color="#FF60646C" />
      <!-- textPlaceholder = #60646c：输入框占位文字。slate 11（同 textMuted）：亮色 `#60646c`，暗色 `#b0b4ba`。 不用 10 级：在输入框的浅底上只有 3.3:1，占位文字也是要读的文字（WCAG 1.4.3），按 4.5:1；同 GitHub Primer 的做法 -->
      <Color x:Key="Rune.Color.TextPlaceholder">#FF60646C</Color>
      <SolidColorBrush x:Key="Rune.Brush.TextPlaceholder" Color="#FF60646C" />
      <!-- textDisabled = #b9bbc6：不可用的文字。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
      <Color x:Key="Rune.Color.TextDisabled">#FFB9BBC6</Color>
      <SolidColorBrush x:Key="Rune.Brush.TextDisabled" Color="#FFB9BBC6" />
      <!-- borderMuted = #d9d9e0：弱边框：分割线、表格线。slate 6：亮色 `#d9d9e0`，暗色 `#363a3f` -->
      <Color x:Key="Rune.Color.BorderMuted">#FFD9D9E0</Color>
      <SolidColorBrush x:Key="Rune.Brush.BorderMuted" Color="#FFD9D9E0" />
      <!-- border = #cdced6：普通边框：输入框、卡片、浮层。slate 7：亮色 `#cdced6`，暗色 `#43484e` -->
      <Color x:Key="Rune.Color.Border">#FFCDCED6</Color>
      <SolidColorBrush x:Key="Rune.Brush.Border" Color="#FFCDCED6" />
      <!-- borderStrong = #b9bbc6：强调边框：悬停。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
      <Color x:Key="Rune.Color.BorderStrong">#FFB9BBC6</Color>
      <SolidColorBrush x:Key="Rune.Brush.BorderStrong" Color="#FFB9BBC6" />
      <!-- accent = #3e63dd：品牌色实色：主按钮、选中的复选框。indigo 9：两套主题都是 `#3e63dd` -->
      <Color x:Key="Rune.Color.Accent">#FF3E63DD</Color>
      <SolidColorBrush x:Key="Rune.Brush.Accent" Color="#FF3E63DD" />
      <!-- accentHover = #3358d4：品牌色实色悬停。亮色 indigo 10 `#3358d4`；暗色比实色更深一点 `#3758d4`（indigo 10 `#5472e4` 配白字只有 4.28:1） -->
      <Color x:Key="Rune.Color.AccentHover">#FF3358D4</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentHover" Color="#FF3358D4" />
      <!-- accentContrast = #ffffff：品牌色实色上的文字与图标。Radix 规定 indigo 9 上用白字：`#ffffff` -->
      <Color x:Key="Rune.Color.AccentContrast">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentContrast" Color="#FFFFFFFF" />
      <!-- accentText = #3a5bc7：品牌色文字：链接、选中项的文字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
      <Color x:Key="Rune.Color.AccentText">#FF3A5BC7</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentText" Color="#FF3A5BC7" />
      <!-- accentSoft = #edf2fe：品牌色浅底：选中行、弱主按钮。indigo 3：亮色 `#edf2fe`，暗色 `#182449` -->
      <Color x:Key="Rune.Color.AccentSoft">#FFEDF2FE</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentSoft" Color="#FFEDF2FE" />
      <!-- accentSoftHover = #e1e9ff：品牌色浅底悬停。indigo 4：亮色 `#e1e9ff`，暗色 `#1d2e62` -->
      <Color x:Key="Rune.Color.AccentSoftHover">#FFE1E9FF</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentSoftHover" Color="#FFE1E9FF" />
      <!-- accentBorder = #abbdf9：品牌色边框：选中的卡片、弱主按钮描边。indigo 7：亮色 `#abbdf9`，暗色 `#3a4f97` -->
      <Color x:Key="Rune.Color.AccentBorder">#FFABBDF9</Color>
      <SolidColorBrush x:Key="Rune.Brush.AccentBorder" Color="#FFABBDF9" />
      <!-- danger = #ce2c31：危险实色：危险按钮的底色，上面放 dangerContrast（白色）文字，要满足 4.5:1。 red 9 配白字只有 3.91:1，所以亮色用 red 11 `#ce2c31`（5.21:1），暗色用 red 8 `#b54548`（5.37:1） -->
      <Color x:Key="Rune.Color.Danger">#FFCE2C31</Color>
      <SolidColorBrush x:Key="Rune.Brush.Danger" Color="#FFCE2C31" />
      <!-- dangerHover = #b8272c：危险实色悬停：比实色更深一点，白字才满足 4.5:1（red 10 只有 4.37:1）。亮色 `#b8272c`，暗色 `#a33b3e` -->
      <Color x:Key="Rune.Color.DangerHover">#FFB8272C</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerHover" Color="#FFB8272C" />
      <!-- dangerContrast = #ffffff：危险实色上的文字与图标：`#ffffff` -->
      <Color x:Key="Rune.Color.DangerContrast">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerContrast" Color="#FFFFFFFF" />
      <!-- dangerText = #b8272c：危险文字：错误提示。亮色比 red 11 深一点 `#b8272c`（red 11 在 dangerSoftHover 上只有 4.07:1），暗色 red 11 `#ff9592` -->
      <Color x:Key="Rune.Color.DangerText">#FFB8272C</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerText" Color="#FFB8272C" />
      <!-- dangerSoft = #feebec：危险浅底：错误提示条。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
      <Color x:Key="Rune.Color.DangerSoft">#FFFEEBEC</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerSoft" Color="#FFFEEBEC" />
      <!-- dangerSoftHover = #ffdbdc：危险浅底悬停。red 4：亮色 `#ffdbdc`，暗色 `#500f1c` -->
      <Color x:Key="Rune.Color.DangerSoftHover">#FFFFDBDC</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerSoftHover" Color="#FFFFDBDC" />
      <!-- dangerBorder = #f4a9aa：危险边框：校验失败的输入框。red 7：亮色 `#f4a9aa`，暗色 `#8c333a` -->
      <Color x:Key="Rune.Color.DangerBorder">#FFF4A9AA</Color>
      <SolidColorBrush x:Key="Rune.Brush.DangerBorder" Color="#FFF4A9AA" />
      <!-- successText = #17714a：成功文字与图标。亮色 `#17714a`（green 11 与 12 之间），暗色 green 11 `#3dd68c`。 亮色不用 11 级：green 11 在 successSoft（green 3）上只有 4.21:1，标记、提示条里的文字不到 4.5； 也不用 12 级：近黑色与正文分不出（同 dangerText 取中间调），在浅底、浅底悬停、表面上都到 5:1 -->
      <Color x:Key="Rune.Color.SuccessText">#FF17714A</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessText" Color="#FF17714A" />
      <!-- successSoft = #e6f6eb：成功浅底。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
      <Color x:Key="Rune.Color.SuccessSoft">#FFE6F6EB</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessSoft" Color="#FFE6F6EB" />
      <!-- successBorder = #8eceaa：成功边框。green 7：亮色 `#8eceaa`，暗色 `#28684a` -->
      <Color x:Key="Rune.Color.SuccessBorder">#FF8ECEAA</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessBorder" Color="#FF8ECEAA" />
      <!-- success = #008751：成功实色：成功按钮、实底徽标的底色，上面放 successContrast。亮色 `#008751`，暗色 green 9 `#30a46c`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 successText：实色不一定在表面上到 3:1 -->
      <Color x:Key="Rune.Color.Success">#FF008751</Color>
      <SolidColorBrush x:Key="Rune.Brush.Success" Color="#FF008751" />
      <!-- successHover = #007143：成功实色悬停：与 successContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#007143`，暗色 `#52af7d` -->
      <Color x:Key="Rune.Color.SuccessHover">#FF007143</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessHover" Color="#FF007143" />
      <!-- successContrast = #ffffff：成功实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
      <Color x:Key="Rune.Color.SuccessContrast">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessContrast" Color="#FFFFFFFF" />
      <!-- successSoftHover = #d6f1df：成功浅底悬停。green 4：亮色 `#d6f1df`，暗色 `#113b29` -->
      <Color x:Key="Rune.Color.SuccessSoftHover">#FFD6F1DF</Color>
      <SolidColorBrush x:Key="Rune.Brush.SuccessSoftHover" Color="#FFD6F1DF" />
      <!-- warningText = #8a5300：警告文字与图标。亮色 `#8a5300`（amber 11 与 12 之间），暗色 amber 11 `#ffca16`。 亮色不用 11 级：amber 11（`#ab6400`）在页面背景上对比度 4.49，不到 WCAG AA 的 4.5； 也不用 12 级：近黑色与正文分不出，在浅底、浅底悬停、表面上都到 5:1 -->
      <Color x:Key="Rune.Color.WarningText">#FF8A5300</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningText" Color="#FF8A5300" />
      <!-- warningSoft = #fff7c2：警告浅底。amber 3：亮色 `#fff7c2`，暗色 `#302008` -->
      <Color x:Key="Rune.Color.WarningSoft">#FFFFF7C2</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningSoft" Color="#FFFFF7C2" />
      <!-- warningBorder = #e9c162：警告边框。amber 7：亮色 `#e9c162`，暗色 `#714f19` -->
      <Color x:Key="Rune.Color.WarningBorder">#FFE9C162</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningBorder" Color="#FFE9C162" />
      <!-- warning = #ffc53d：警告实色：警告按钮、实底徽标的底色，上面放 warningContrast。亮色 `#ffc53d`，暗色 amber 9 `#ffc53d`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 warningText：实色不一定在表面上到 3:1 -->
      <Color x:Key="Rune.Color.Warning">#FFFFC53D</Color>
      <SolidColorBrush x:Key="Rune.Brush.Warning" Color="#FFFFC53D" />
      <!-- warningHover = #ffcd5f：警告实色悬停：与 warningContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#ffcd5f`，暗色 `#ffcd5f` -->
      <Color x:Key="Rune.Color.WarningHover">#FFFFCD5F</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningHover" Color="#FFFFCD5F" />
      <!-- warningContrast = #4f3422：警告实色上的文字与图标。亮色 `#4f3422`，暗色 `#111113` -->
      <Color x:Key="Rune.Color.WarningContrast">#FF4F3422</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningContrast" Color="#FF4F3422" />
      <!-- warningSoftHover = #ffee9c：警告浅底悬停。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
      <Color x:Key="Rune.Color.WarningSoftHover">#FFFFEE9C</Color>
      <SolidColorBrush x:Key="Rune.Brush.WarningSoftHover" Color="#FFFFEE9C" />
      <!-- infoText = #0c64b3：信息文字与图标。亮色 `#0c64b3`（blue 11 与 12 之间），暗色 blue 11 `#70b8ff`。 亮色不用 11 级：blue 11 在 infoSoft（blue 3）上只有 4.25:1；也不用 12 级：近黑色与正文分不出， 在浅底、浅底悬停、表面上都到 5:1 -->
      <Color x:Key="Rune.Color.InfoText">#FF0C64B3</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoText" Color="#FF0C64B3" />
      <!-- infoSoft = #e6f4fe：信息浅底。blue 3：亮色 `#e6f4fe`，暗色 `#0d2847` -->
      <Color x:Key="Rune.Color.InfoSoft">#FFE6F4FE</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoSoft" Color="#FFE6F4FE" />
      <!-- infoBorder = #8ec8f6：信息边框。blue 7：亮色 `#8ec8f6`，暗色 `#205d9e` -->
      <Color x:Key="Rune.Color.InfoBorder">#FF8EC8F6</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoBorder" Color="#FF8EC8F6" />
      <!-- info = #0073e0：信息实色：信息按钮、实底徽标的底色，上面放 infoContrast。亮色 `#0073e0`，暗色 blue 9 `#0090ff`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 infoText：实色不一定在表面上到 3:1 -->
      <Color x:Key="Rune.Color.Info">#FF0073E0</Color>
      <SolidColorBrush x:Key="Rune.Brush.Info" Color="#FF0073E0" />
      <!-- infoHover = #0060bd：信息实色悬停：与 infoContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#0060bd`，暗色 `#3d9fff` -->
      <Color x:Key="Rune.Color.InfoHover">#FF0060BD</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoHover" Color="#FF0060BD" />
      <!-- infoContrast = #ffffff：信息实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
      <Color x:Key="Rune.Color.InfoContrast">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoContrast" Color="#FFFFFFFF" />
      <!-- infoSoftHover = #d5efff：信息浅底悬停。blue 4：亮色 `#d5efff`，暗色 `#003362` -->
      <Color x:Key="Rune.Color.InfoSoftHover">#FFD5EFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.InfoSoftHover" Color="#FFD5EFFF" />
      <!-- inverseSurface = #1c2024：反色表面。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
      <Color x:Key="Rune.Color.InverseSurface">#FF1C2024</Color>
      <SolidColorBrush x:Key="Rune.Brush.InverseSurface" Color="#FF1C2024" />
      <!-- inverseText = #fcfcfd：反色表面上的文字。slate 1：亮色 `#fcfcfd`，暗色 `#111113` -->
      <Color x:Key="Rune.Color.InverseText">#FFFCFCFD</Color>
      <SolidColorBrush x:Key="Rune.Brush.InverseText" Color="#FFFCFCFD" />
      <!-- focusRing = #3e63dd：焦点环（:focus-visible）。indigo 9：两套主题都是 `#3e63dd`。 Radix 建议 7–8 级，但亮色下对比度不到 3:1（WCAG 2.2 焦点外观要求），所以用 9 级 -->
      <Color x:Key="Rune.Color.FocusRing">#FF3E63DD</Color>
      <SolidColorBrush x:Key="Rune.Brush.FocusRing" Color="#FF3E63DD" />
      <!-- overlay = rgba(0, 0, 0, 0.4)：模态遮罩。亮色 blackA 6 `rgba(0, 0, 0, 0.4)`，暗色 blackA 8 `rgba(0, 0, 0, 0.6)` -->
      <Color x:Key="Rune.Color.Overlay">#66000000</Color>
      <SolidColorBrush x:Key="Rune.Brush.Overlay" Color="#66000000" />
      <!-- scrim = rgba(0, 0, 0, 0.55)：图片、视频上的深色遮罩，上面放 onScrim 的文字（上传的进度与文件名）。 盖在任意图片上，不跟主题变：`rgba(0, 0, 0, 0.55)` -->
      <Color x:Key="Rune.Color.Scrim">#8C000000</Color>
      <SolidColorBrush x:Key="Rune.Brush.Scrim" Color="#8C000000" />
      <!-- scrimStrong = rgba(0, 0, 0, 0.86)：看图时铺满的深色背景（Lightbox）：`rgba(0, 0, 0, 0.86)` -->
      <Color x:Key="Rune.Color.ScrimStrong">#DB000000</Color>
      <SolidColorBrush x:Key="Rune.Brush.ScrimStrong" Color="#DB000000" />
      <!-- onScrim = #ffffff：遮罩上的文字与图标：`#ffffff` -->
      <Color x:Key="Rune.Color.OnScrim">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.OnScrim" Color="#FFFFFFFF" />
      <!-- selection = #d2deff：选中文字的底色（::selection）。indigo 5：亮色 `#d2deff`，暗色 `#253974` -->
      <Color x:Key="Rune.Color.Selection">#FFD2DEFF</Color>
      <SolidColorBrush x:Key="Rune.Brush.Selection" Color="#FFD2DEFF" />
      <!-- highlight = #ffee9c：高亮标记：搜索命中、`<mark>`。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
      <Color x:Key="Rune.Color.Highlight">#FFFFEE9C</Color>
      <SolidColorBrush x:Key="Rune.Brush.Highlight" Color="#FFFFEE9C" />
      <!-- surfaceTranslucent = rgba(249, 249, 251, 0.8)：半透明表面：吸顶的顶栏（配合背景模糊）。页面背景加 80% 不透明 -->
      <Color x:Key="Rune.Color.SurfaceTranslucent">#CCF9F9FB</Color>
      <SolidColorBrush x:Key="Rune.Brush.SurfaceTranslucent" Color="#CCF9F9FB" />
      <!-- codeKeyword = #3a5bc7：关键字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
      <Color x:Key="Rune.Color.CodeKeyword">#FF3A5BC7</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeKeyword" Color="#FF3A5BC7" />
      <!-- codeString = #1c7a51：字符串。亮色比 green 11 深一点 `#1c7a51`（在代码块背景上 green 11 只有 4.49:1），暗色 green 11 `#3dd68c` -->
      <Color x:Key="Rune.Color.CodeString">#FF1C7A51</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeString" Color="#FF1C7A51" />
      <!-- codeNumber = #bb4500：数字、常量。亮色比 orange 11 深一点 `#bb4500`（orange 11 在代码块背景上只有 4.29:1），暗色 orange 11 `#ffa057` -->
      <Color x:Key="Rune.Color.CodeNumber">#FFBB4500</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeNumber" Color="#FFBB4500" />
      <!-- codeFunction = #6550b9：函数名。violet 11：亮色 `#6550b9`，暗色 `#baa7ff` -->
      <Color x:Key="Rune.Color.CodeFunction">#FF6550B9</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeFunction" Color="#FF6550B9" />
      <!-- codeType = #007590：类型、类名。亮色比 cyan 11 深一点 `#007590`（cyan 11 在行内代码的底色上只有 4.19:1），暗色 cyan 11 `#4ccce6` -->
      <Color x:Key="Rune.Color.CodeType">#FF007590</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeType" Color="#FF007590" />
      <!-- codeComment = #60646c：注释、标点。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
      <Color x:Key="Rune.Color.CodeComment">#FF60646C</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeComment" Color="#FF60646C" />
      <!-- codeTag = #cb1d63：标签名（HTML、JSX）。crimson 11：亮色 `#cb1d63`，暗色 `#ff92ad` -->
      <Color x:Key="Rune.Color.CodeTag">#FFCB1D63</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeTag" Color="#FFCB1D63" />
      <!-- codeAttribute = #815e46：属性名。brown 11：亮色 `#815e46`，暗色 `#dbb594` -->
      <Color x:Key="Rune.Color.CodeAttribute">#FF815E46</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeAttribute" Color="#FF815E46" />
      <!-- codeInserted = #e6f6eb：diff 新增行的底色。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
      <Color x:Key="Rune.Color.CodeInserted">#FFE6F6EB</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeInserted" Color="#FFE6F6EB" />
      <!-- codeDeleted = #feebec：diff 删除行的底色。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
      <Color x:Key="Rune.Color.CodeDeleted">#FFFEEBEC</Color>
      <SolidColorBrush x:Key="Rune.Brush.CodeDeleted" Color="#FFFEEBEC" />
      <!-- chart1 = #3e63dd：第 1 个系列：跟随品牌色。indigo 9：两套主题都是 `#3e63dd` -->
      <Color x:Key="Rune.Color.Chart1">#FF3E63DD</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart1" Color="#FF3E63DD" />
      <!-- chart2 = #0d9b8a：第 2 个系列。teal：亮色 10 级 `#0d9b8a`，暗色 9 级 `#12a594` -->
      <Color x:Key="Rune.Color.Chart2">#FF0D9B8A</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart2" Color="#FF0D9B8A" />
      <!-- chart3 = #ef5f00：第 3 个系列。orange：亮色 10 级 `#ef5f00`，暗色 9 级 `#f76b15` -->
      <Color x:Key="Rune.Color.Chart3">#FFEF5F00</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart3" Color="#FFEF5F00" />
      <!-- chart4 = #e93d82：第 4 个系列。crimson 9：两套主题都是 `#e93d82` -->
      <Color x:Key="Rune.Color.Chart4">#FFE93D82</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart4" Color="#FFE93D82" />
      <!-- chart5 = #6e56cf：第 5 个系列。violet 9：两套主题都是 `#6e56cf` -->
      <Color x:Key="Rune.Color.Chart5">#FF6E56CF</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart5" Color="#FF6E56CF" />
      <!-- chart6 = #0797b9：第 6 个系列。cyan：亮色 10 级 `#0797b9`，暗色 9 级 `#00a2c7` -->
      <Color x:Key="Rune.Color.Chart6">#FF0797B9</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart6" Color="#FF0797B9" />
      <!-- chart7 = #3e9b4f：第 7 个系列。grass：亮色 10 级 `#3e9b4f`，暗色 9 级 `#46a758` -->
      <Color x:Key="Rune.Color.Chart7">#FF3E9B4F</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart7" Color="#FF3E9B4F" />
      <!-- chart8 = #ab6400：第 8 个系列。amber：亮色 11 级 `#ab6400`（9、10 级在浅色背景上不到 2:1），暗色 9 级 `#ffc53d` -->
      <Color x:Key="Rune.Color.Chart8">#FFAB6400</Color>
      <SolidColorBrush x:Key="Rune.Brush.Chart8" Color="#FFAB6400" />
      <!-- inverseSurfaceHover = color-mix(in oklab, inverseSurface 85%, background)：中性实底按钮的悬停底色（button-core 的 color-mix(in oklab, inverseSurface 85%, background)）（token-gen 算出） -->
      <Color x:Key="Rune.Color.InverseSurfaceHover">#FF383C40</Color>
      <SolidColorBrush x:Key="Rune.Brush.InverseSurfaceHover" Color="#FF383C40" />

      <!-- shadows -->
      <!-- none = none：无阴影 -->
      <BoxShadows x:Key="Rune.Shadow.None">none</BoxShadows>
      <!-- xs = 0 1px 1px 0 #00005506, 0 2px 1px -1px rgba(0, 0, 0, 0.05), 0 1px 3px 0 rgba(0, 0, 0, 0.05)：贴近表面：卡片 -->
      <BoxShadows x:Key="Rune.Shadow.Xs">0 1 1 0 #06000055, 0 2 1 -1 #0D000000, 0 1 3 0 #0D000000</BoxShadows>
      <!-- sm = 0 2px 3px -2px #0000330f, 0 3px 12px -4px rgba(0, 0, 0, 0.1), 0 4px 16px -8px rgba(0, 0, 0, 0.1)：轻微浮起：悬停的卡片 -->
      <BoxShadows x:Key="Rune.Shadow.Sm">0 2 3 -2 #0F000033, 0 3 12 -4 #1A000000, 0 4 16 -8 #1A000000</BoxShadows>
      <!-- md = 0 8px 40px rgba(0, 0, 0, 0.05), 0 12px 32px -16px #0000330f：浮起：下拉面板 -->
      <BoxShadows x:Key="Rune.Shadow.Md">0 8 40 0 #0D000000, 0 12 32 -16 #0F000033</BoxShadows>
      <!-- lg = 0 12px 60px rgba(0, 0, 0, 0.15), 0 12px 32px -16px #0009321f：浮层：弹出框、菜单、提示 -->
      <BoxShadows x:Key="Rune.Shadow.Lg">0 12 60 0 #26000000, 0 12 32 -16 #1F000932</BoxShadows>
      <!-- xl = 0 12px 60px rgba(0, 0, 0, 0.15), 0 16px 64px #00005506, 0 16px 36px -20px #00062e32：对话框 -->
      <BoxShadows x:Key="Rune.Shadow.Xl">0 12 60 0 #26000000, 0 16 64 0 #06000055, 0 16 36 -20 #3200062E</BoxShadows>

      <!-- fonts -->
      <!-- sans = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：正文字体：西文用系统界面字体；中文在 Windows 上优先“微软雅黑 UI”（界面字号下字距更紧凑）， Linux 上是思源黑体（Noto / Source Han Sans） -->
      <FontFamily x:Key="Rune.Font.Sans">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>
      <!-- mono = ui-monospace, "Cascadia Code", "JetBrains Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace：等宽字体：代码、需要数字对齐的地方。装了 Cascadia Code（Windows 11 自带）、JetBrains Mono 时优先用它们， 字形比 Consolas 清楚 -->
      <FontFamily x:Key="Rune.Font.Mono">Cascadia Code, JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono</FontFamily>
      <!-- serif = "Noto Serif SC", "Source Han Serif SC", "Songti SC", STSong, "SimSun", Georgia, serif：衬线字体：书卷感的标题、引文（纸张主题的标题用它） -->
      <FontFamily x:Key="Rune.Font.Serif">Noto Serif SC, Source Han Serif SC, Songti SC, STSong, SimSun, Georgia</FontFamily>
      <!-- heading = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：标题（H1–H6）的字体：默认同正文，主题可以换成衬线 -->
      <FontFamily x:Key="Rune.Font.Heading">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>

      <!-- radii -->
      <!-- none = 0（设备无关像素）：`0` -->
      <x:Double x:Key="Rune.Radius.None">0</x:Double>
      <!-- xs = 0.15em（em 系数）：`0.15em`：控件内的小元素 -->
      <x:Double x:Key="Rune.Radius.Xs">0.15</x:Double>
      <!-- sm = 0.25em（em 系数）：`0.25em`：标签、复选框 -->
      <x:Double x:Key="Rune.Radius.Sm">0.25</x:Double>
      <!-- md = 0.4em（em 系数）：`0.4em`：按钮、输入框 -->
      <x:Double x:Key="Rune.Radius.Md">0.4</x:Double>
      <!-- lg = 0.7em（em 系数）：`0.7em`：卡片、浮层 -->
      <x:Double x:Key="Rune.Radius.Lg">0.7</x:Double>
      <!-- xl = 1em（em 系数）：`1em`：对话框 -->
      <x:Double x:Key="Rune.Radius.Xl">1</x:Double>
      <!-- full = 9999px（设备无关像素）：全圆：胶囊按钮、头像、开关 -->
      <x:Double x:Key="Rune.Radius.Full">9999</x:Double>

      <!-- 色调调色板（DESIGN §4）：组件的样式档位引用它的字段 -->
      <rune:TonePalette x:Key="Rune.Palette.Neutral" Solid="{StaticResource Rune.Brush.InverseSurface}" SolidHover="{StaticResource Rune.Brush.InverseSurfaceHover}" Contrast="{StaticResource Rune.Brush.InverseText}" Soft="{StaticResource Rune.Brush.Fill}" SoftHover="{StaticResource Rune.Brush.FillHover}" Surface="{StaticResource Rune.Brush.Surface}" SubtleHover="{StaticResource Rune.Brush.FillHover}" Text="{StaticResource Rune.Brush.Text}" Border="{StaticResource Rune.Brush.Border}" />
      <rune:TonePalette x:Key="Rune.Palette.Accent" Solid="{StaticResource Rune.Brush.Accent}" SolidHover="{StaticResource Rune.Brush.AccentHover}" Contrast="{StaticResource Rune.Brush.AccentContrast}" Soft="{StaticResource Rune.Brush.AccentSoft}" SoftHover="{StaticResource Rune.Brush.AccentSoftHover}" Surface="{StaticResource Rune.Brush.AccentSoft}" SubtleHover="{StaticResource Rune.Brush.AccentSoft}" Text="{StaticResource Rune.Brush.AccentText}" Border="{StaticResource Rune.Brush.AccentBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Info" Solid="{StaticResource Rune.Brush.Info}" SolidHover="{StaticResource Rune.Brush.InfoHover}" Contrast="{StaticResource Rune.Brush.InfoContrast}" Soft="{StaticResource Rune.Brush.InfoSoft}" SoftHover="{StaticResource Rune.Brush.InfoSoftHover}" Surface="{StaticResource Rune.Brush.InfoSoft}" SubtleHover="{StaticResource Rune.Brush.InfoSoft}" Text="{StaticResource Rune.Brush.InfoText}" Border="{StaticResource Rune.Brush.InfoBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Success" Solid="{StaticResource Rune.Brush.Success}" SolidHover="{StaticResource Rune.Brush.SuccessHover}" Contrast="{StaticResource Rune.Brush.SuccessContrast}" Soft="{StaticResource Rune.Brush.SuccessSoft}" SoftHover="{StaticResource Rune.Brush.SuccessSoftHover}" Surface="{StaticResource Rune.Brush.SuccessSoft}" SubtleHover="{StaticResource Rune.Brush.SuccessSoft}" Text="{StaticResource Rune.Brush.SuccessText}" Border="{StaticResource Rune.Brush.SuccessBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Warning" Solid="{StaticResource Rune.Brush.Warning}" SolidHover="{StaticResource Rune.Brush.WarningHover}" Contrast="{StaticResource Rune.Brush.WarningContrast}" Soft="{StaticResource Rune.Brush.WarningSoft}" SoftHover="{StaticResource Rune.Brush.WarningSoftHover}" Surface="{StaticResource Rune.Brush.WarningSoft}" SubtleHover="{StaticResource Rune.Brush.WarningSoft}" Text="{StaticResource Rune.Brush.WarningText}" Border="{StaticResource Rune.Brush.WarningBorder}" />
      <rune:TonePalette x:Key="Rune.Palette.Danger" Solid="{StaticResource Rune.Brush.Danger}" SolidHover="{StaticResource Rune.Brush.DangerHover}" Contrast="{StaticResource Rune.Brush.DangerContrast}" Soft="{StaticResource Rune.Brush.DangerSoft}" SoftHover="{StaticResource Rune.Brush.DangerSoftHover}" Surface="{StaticResource Rune.Brush.DangerSoft}" SubtleHover="{StaticResource Rune.Brush.DangerSoft}" Text="{StaticResource Rune.Brush.DangerText}" Border="{StaticResource Rune.Brush.DangerBorder}" />
    </ResourceDictionary>
    <!-- 暗色（dark） -->
    <ResourceDictionary x:Key="Dark">
      <!-- colors -->
      <Color x:Key="Rune.Color.Background">#FF111113</Color>
      <SolidColorBrush x:Key="Rune.Brush.Background" Color="#FF111113" />
      <Color x:Key="Rune.Color.Surface">#FF18191B</Color>
      <SolidColorBrush x:Key="Rune.Brush.Surface" Color="#FF18191B" />
      <Color x:Key="Rune.Color.SurfaceMuted">#FF18191B</Color>
