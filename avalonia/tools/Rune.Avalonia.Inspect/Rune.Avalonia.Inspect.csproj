  <ItemGroup>
    <ProjectReference Include="..\..\apps\Rune.Avalonia.Examples\Rune.Avalonia.Examples.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\tools\inspect\InspectShared.cs" Link="InspectShared.cs" />
  </ItemGroup>

</Project>
