<Project Sdk="Microsoft.NET.Sdk">

  <!-- 组件库的测试：headless 平台上建真实的控件树，检查样式优先级、合并结果与更新次数。xunit v3 的测试项目是可执行程序 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rune.Avalonia.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- 不用 Avalonia.Headless.XUnit：它依赖 xunit v3 的 3.x，这里直接用 Avalonia.Headless 的测试会话 -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rune.Avalonia\Rune.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
