<Project Sdk="Microsoft.NET.Sdk">

  <!-- 文档应用：页面与示例同 vue-tsx-pro 的文档站（docs/site/pages.g.json），每个示例是一张 CodePreview；Debug 构建带 axaml 热重载 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Rune.Avalonia.Docs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="All" />
    <PackageReference Include="HotAvalonia" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rune.Avalonia.Examples\Rune.Avalonia.Examples.csproj" />
  </ItemGroup>

</Project>
