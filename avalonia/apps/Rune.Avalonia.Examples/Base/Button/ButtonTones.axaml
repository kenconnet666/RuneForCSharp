<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.ButtonTones">
  <StackPanel Spacing="12">
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="neutral" Variant="solid">取消</rune:Button><rune:Button Tone="neutral" Variant="soft">取消</rune:Button><rune:Button Tone="neutral" Variant="surface">取消</rune:Button><rune:Button Tone="neutral" Variant="outline">取消</rune:Button><rune:Button Tone="neutral" Variant="ghost">取消</rune:Button><rune:Button Tone="neutral" Variant="link">取消</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="accent" Variant="solid">确定</rune:Button><rune:Button Tone="accent" Variant="soft">确定</rune:Button><rune:Button Tone="accent" Variant="surface">确定</rune:Button><rune:Button Tone="accent" Variant="outline">确定</rune:Button><rune:Button Tone="accent" Variant="ghost">确定</rune:Button><rune:Button Tone="accent" Variant="link">确定</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="info" Variant="solid">详情</rune:Button><rune:Button Tone="info" Variant="soft">详情</rune:Button><rune:Button Tone="info" Variant="surface">详情</rune:Button><rune:Button Tone="info" Variant="outline">详情</rune:Button><rune:Button Tone="info" Variant="ghost">详情</rune:Button><rune:Button Tone="info" Variant="link">详情</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="success" Variant="solid">完成</rune:Button><rune:Button Tone="success" Variant="soft">完成</rune:Button><rune:Button Tone="success" Variant="surface">完成</rune:Button><rune:Button Tone="success" Variant="outline">完成</rune:Button><rune:Button Tone="success" Variant="ghost">完成</rune:Button><rune:Button Tone="success" Variant="link">完成</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="warning" Variant="solid">注意</rune:Button><rune:Button Tone="warning" Variant="soft">注意</rune:Button><rune:Button Tone="warning" Variant="surface">注意</rune:Button><rune:Button Tone="warning" Variant="outline">注意</rune:Button><rune:Button Tone="warning" Variant="ghost">注意</rune:Button><rune:Button Tone="warning" Variant="link">注意</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Tone="danger" Variant="solid">删除</rune:Button><rune:Button Tone="danger" Variant="soft">删除</rune:Button><rune:Button Tone="danger" Variant="surface">删除</rune:Button><rune:Button Tone="danger" Variant="outline">删除</rune:Button><rune:Button Tone="danger" Variant="ghost">删除</rune:Button><rune:Button Tone="danger" Variant="link">删除</rune:Button></WrapPanel>
  </StackPanel>
</UserControl>
