<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.ButtonRadius">
  <!-- 圆角档位与 Badge、Card、输入框共用一套（Radius），对应主题的 radii -->
  <StackPanel Spacing="12">
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Radius="none">none</rune:Button><rune:Button Radius="xs">xs</rune:Button><rune:Button Radius="sm">sm</rune:Button><rune:Button Radius="md">md</rune:Button><rune:Button Radius="lg">lg</rune:Button><rune:Button Radius="xl">xl</rune:Button><rune:Button Radius="full">full</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:Button Radius="none" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">none</rune:Button><rune:Button Radius="xs" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">xs</rune:Button><rune:Button Radius="sm" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">sm</rune:Button><rune:Button Radius="md" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">md</rune:Button><rune:Button Radius="lg" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">lg</rune:Button><rune:Button Radius="xl" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">xl</rune:Button><rune:Button Radius="full" Variant="outline" Icon="{x:Static rune:Lucide.Plus}">full</rune:Button></WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8"><rune:IconButton Radius="none" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（none）" /><rune:IconButton Radius="xs" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（xs）" /><rune:IconButton Radius="sm" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（sm）" /><rune:IconButton Radius="md" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（md）" /><rune:IconButton Radius="lg" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（lg）" /><rune:IconButton Radius="xl" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（xl）" /><rune:IconButton Radius="full" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Heart}" AutomationProperties.Name="收藏（full）" /></WrapPanel>
  </StackPanel>
</UserControl>
