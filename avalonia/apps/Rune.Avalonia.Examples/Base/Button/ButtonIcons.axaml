<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.ButtonIcons">
  <!-- Kbd 做出来后补上第二行的"搜索 Ctrl K" -->
  <StackPanel Spacing="12">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <rune:Button Icon="{x:Static rune:Lucide.Plus}">新建</rune:Button>
      <rune:Button Variant="soft" Icon="{x:Static rune:Lucide.Download}">下载</rune:Button>
      <rune:Button Variant="outline" Tone="neutral" IconEnd="{x:Static rune:Lucide.ChevronDown}">更多</rune:Button>
      <rune:Button Variant="ghost" IconEnd="{x:Static rune:Lucide.ArrowRight}">下一步</rune:Button>
      <rune:Button Variant="link" IconEnd="{x:Static rune:Lucide.ExternalLink}">查看文档</rune:Button>
    </WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <rune:Button Variant="soft" Tone="neutral"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="未读消息" VerticalAlignment="Center" /><rune:Badge Variant="solid" Tone="danger" Radius="full">12</rune:Badge></StackPanel></rune:Button>
      <rune:IconButton Icon="{x:Static rune:Lucide.Pencil}" VerticalAlignment="Center" AutomationProperties.Name="编辑" />
      <rune:IconButton Icon="{x:Static rune:Lucide.Share2}" VerticalAlignment="Center" AutomationProperties.Name="分享" />
      <rune:IconButton Icon="{x:Static rune:Lucide.Trash}" Tone="danger" VerticalAlignment="Center" AutomationProperties.Name="删除" />
    </WrapPanel>
  </StackPanel>
</UserControl>
