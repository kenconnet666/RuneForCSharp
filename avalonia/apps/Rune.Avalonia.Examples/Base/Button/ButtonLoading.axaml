<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.ButtonLoading">
  <!-- 点击后模拟一次请求；很快完成的加载不出现旋转指示（DelayedLoading），宽度始终不变 -->
  <StackPanel Spacing="12">
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <rune:Button Name="Save">保存</rune:Button>
      <rune:Button Name="Submit" Variant="outline" Icon="{x:Static rune:Lucide.Send}">提交审核</rune:Button>
      <rune:Button Name="Delete" Variant="soft" Tone="danger" Icon="{x:Static rune:Lucide.Trash}">删除</rune:Button>
      <rune:IconButton Name="Refresh" Variant="surface" Tone="neutral" Icon="{x:Static rune:Lucide.RefreshCw}" AutomationProperties.Name="刷新" />
    </WrapPanel>
    <WrapPanel ItemSpacing="8" LineSpacing="8">
      <rune:Button Name="Quick" Variant="surface" Tone="neutral">很快完成（0.1 秒）</rune:Button>
      <rune:Small Tone="muted" VerticalAlignment="Center">不到 0.2 秒的操作不换成加载指示，按钮不会闪一下</rune:Small>
    </WrapPanel>
  </StackPanel>
</UserControl>
