<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.SpinnerExample">
  <rune:Flex Direction="column" Gap="xl" VerticalAlignment="Top">
    <rune:Flex Align="center" Gap="xl" Wrap="True">
      <rune:Spinner Size="xs" />
      <rune:Spinner Size="sm" />
      <rune:Spinner Size="md" />
      <rune:Spinner Size="lg" />
      <rune:Spinner Size="xl" />
      <!-- 放在文字里：大小、颜色跟随文字 -->
      <rune:Text Tone="accent"><InlineUIContainer BaselineAlignment="Center"><rune:Spinner /></InlineUIContainer><Run Text=" 跟随文字颜色" /></rune:Text>
      <rune:Text Tone="success" Size="sm"><InlineUIContainer BaselineAlignment="Center"><rune:Spinner /></InlineUIContainer><Run Text=" 同步中" /></rune:Text>
    </rune:Flex>
    <rune:Card HorizontalAlignment="Left" Width="420" Padding="md">
      <rune:Flex Align="center" Gap="sm">
        <!-- 单独出现、旁边没有文字时写 Label：读屏当作进度条念出来 -->
        <rune:Spinner Label="正在生成报表" />
        <rune:Small Tone="muted">正在生成报表，大约需要 30 秒</rune:Small>
      </rune:Flex>
    </rune:Card>
  </rune:Flex>
</UserControl>
