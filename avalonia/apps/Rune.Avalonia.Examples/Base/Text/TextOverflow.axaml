<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             xmlns:local="using:Rune.Avalonia.Examples"
             x:Class="Rune.Avalonia.Examples.TextOverflow">
  <UserControl.Styles>
    <Style Selector="WrapPanel > Border">
      <Setter Property="Width" Value="240" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
      <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    </Style>
  </UserControl.Styles>
  <WrapPanel ItemSpacing="12" LineSpacing="12">
    <Border>
      <StackPanel Spacing="4">
        <rune:Small Tone="muted">truncate：单行省略</rune:Small>
        <rune:Strong Truncate="True">vue-tsx-pro / packages / ui / src / display / VirtualList.tsx</rune:Strong>
        <rune:Text Truncate="True" Tone="muted" Text="{x:Static local:TextOverflow.Long}" />
      </StackPanel>
    </Border>
    <Border>
      <StackPanel Spacing="4">
        <rune:Small Tone="muted">LineClamp="2"：最多两行</rune:Small>
        <rune:Paragraph LineClamp="2" Text="{x:Static local:TextOverflow.Long}" />
      </StackPanel>
    </Border>
    <Border>
      <StackPanel Spacing="4">
        <rune:Small Tone="muted">Wrap="Balance"：桌面上同普通换行</rune:Small>
        <rune:Paragraph Wrap="Balance" Size="lg" Weight="semibold" Align="Center">用更自然的 TSX 写 Vue 组件，符文让状态读写像普通变量</rune:Paragraph>
      </StackPanel>
    </Border>
  </WrapPanel>
</UserControl>
