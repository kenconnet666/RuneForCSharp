<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.IconDirection">
  <rune:Grid MinItemWidth="14rem" Gap="md">
    <rune:Card Padding="sm" FlowDirection="LeftToRight">
      <rune:Flex Direction="column" Gap="sm">
        <rune:Small Tone="muted">从左到右（中文、英文）</rune:Small>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.ChevronLeft}" FlipInRtl="True" /></InlineUIContainer> 返回</rune:Text>
        <rune:Text>下一步 <InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.ArrowRight}" FlipInRtl="True" /></InlineUIContainer></rune:Text>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.Clock}" /></InlineUIContainer> 刚刚更新</rune:Text>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.Check}" /></InlineUIContainer> 已读</rune:Text>
      </rune:Flex>
    </rune:Card>
    <rune:Card Padding="sm" FlowDirection="RightToLeft">
      <rune:Flex Direction="column" Gap="sm">
        <rune:Small Tone="muted">从右到左（阿拉伯语、希伯来语）</rune:Small>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.ChevronLeft}" FlipInRtl="True" /></InlineUIContainer> 返回</rune:Text>
        <rune:Text>下一步 <InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.ArrowRight}" FlipInRtl="True" /></InlineUIContainer></rune:Text>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.Clock}" /></InlineUIContainer> 刚刚更新</rune:Text>
        <rune:Text><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.Check}" /></InlineUIContainer> 已读</rune:Text>
      </rune:Flex>
    </rune:Card>
  </rune:Grid>
</UserControl>
