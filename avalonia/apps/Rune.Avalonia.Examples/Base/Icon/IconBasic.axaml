<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.IconBasic">
  <rune:Grid MinItemWidth="5.5rem" Gap="md">
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Search}" Size="xl" /><rune:Small Tone="muted">Search</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Bell}" Size="xl" /><rune:Small Tone="muted">Bell</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Heart}" Size="xl" /><rune:Small Tone="muted">Heart</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Settings}" Size="xl" /><rune:Small Tone="muted">Settings</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.House}" Size="xl" /><rune:Small Tone="muted">House</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.User}" Size="xl" /><rune:Small Tone="muted">User</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Mail}" Size="xl" /><rune:Small Tone="muted">Mail</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Calendar}" Size="xl" /><rune:Small Tone="muted">Calendar</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Camera}" Size="xl" /><rune:Small Tone="muted">Camera</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Cloud}" Size="xl" /><rune:Small Tone="muted">Cloud</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Download}" Size="xl" /><rune:Small Tone="muted">Download</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Folder}" Size="xl" /><rune:Small Tone="muted">Folder</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.MapPin}" Size="xl" /><rune:Small Tone="muted">MapPin</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.ShoppingCart}" Size="xl" /><rune:Small Tone="muted">ShoppingCart</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="xl" /><rune:Small Tone="muted">Star</rune:Small></rune:Flex>
    <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Zap}" Size="xl" /><rune:Small Tone="muted">Zap</rune:Small></rune:Flex>
  </rune:Grid>
</UserControl>
