<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/avalonia"
             x:Class="Rune.Avalonia.Examples.IconTones">
  <rune:Grid MinItemWidth="9rem" Gap="md">
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="neutral" Size="xl" /><rune:Text Size="sm">中性：正文色</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="muted" Size="xl" /><rune:Text Size="sm">次要</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.Sparkles}" Tone="accent" Size="xl" /><rune:Text Size="sm">品牌色</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.Info}" Tone="info" Size="xl" /><rune:Text Size="sm">信息</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.CircleCheck}" Tone="success" Size="xl" /><rune:Text Size="sm">成功</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.TriangleExclamationPoint}" Tone="warning" Size="xl" /><rune:Text Size="sm">警告</rune:Text></rune:Flex>
    <rune:Flex Align="center" Gap="sm"><rune:Icon Data="{x:Static rune:Lucide.CircleExclamationPoint}" Tone="danger" Size="xl" /><rune:Text Size="sm">危险</rune:Text></rune:Flex>
  </rune:Grid>
</UserControl>
