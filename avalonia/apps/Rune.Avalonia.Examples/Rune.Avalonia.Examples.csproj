<Project Sdk="Microsoft.NET.Sdk">

  <!-- 组件示例与登记表：Gallery 列出它们，inspect 按"组件/示例名"渲染与检查它们。示例名同 vue-tsx-pro 文档站上那一节的 id -->
  <PropertyGroup>
    <RootNamespace>Rune.Avalonia.Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="HotAvalonia" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rune.Avalonia\Rune.Avalonia.csproj" />
  </ItemGroup>

  <!-- 示例的源文件作为嵌入资源：文档站的"显示代码"按示例切出来（ExampleSources） -->
  <ItemGroup>
    <EmbeddedResource Include="**\*.cs;**\*.axaml" Exclude="bin\**;obj\**" LogicalName="Source/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <!-- 文档站的页面与示例清单（tools/docs-gen 生成，DocSite 读它） -->
    <EmbeddedResource Include="..\..\..\docs\site\pages.g.json" LogicalName="pages.g.json" WithCulture="false" />
  </ItemGroup>

</Project>
