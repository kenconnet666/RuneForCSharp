<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Rune.Avalonia.Gallery.MainWindow"
        Title="Rune.Avalonia 组件示例" Width="1200" Height="800"
        Background="{DynamicResource Rune.Brush.Background}"
        Foreground="{DynamicResource Rune.Brush.Text}"
        FontSize="{DynamicResource Rune.FontSize.Md}">
  <!-- 左侧：主题与示例列表（Examples 项目的登记表，inspect 用同一张）；右侧：选中的示例。组件做出来后换成组件库自己的导航 -->
  <DockPanel>
    <Border DockPanel.Dock="Left" Width="260" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Rune.Brush.Border}">
      <DockPanel>
        <ComboBox x:Name="Themes" DockPanel.Dock="Top" Margin="12" HorizontalAlignment="Stretch" />
        <ListBox x:Name="ExampleList" Background="Transparent" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="32" Spacing="8">
        <TextBlock x:Name="ExampleTitle" FontSize="{DynamicResource Rune.FontSize.Xxl}" FontWeight="SemiBold" />
        <TextBlock x:Name="ExampleDescription" TextWrapping="Wrap" Foreground="{DynamicResource Rune.Brush.TextMuted}" />
        <ContentControl x:Name="Stage" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
