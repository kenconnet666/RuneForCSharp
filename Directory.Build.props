<Project>
  <!--
    全仓库共用的构建设置；各平台目录（avalonia/、wpf/、winforms/）的 Directory.Build.props 导入本文件后再写平台差异，
    各项目只写自己不同的部分。按项目属性（IsLibrary）区分的设置在 Directory.Build.targets
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 版本要在 props 里定：SDK 在导入 Directory.Build.targets 之前就算好了版本 -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <!-- CI 上做确定性构建（路径规范化，包可复现） -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
