<Project Sdk="Microsoft.NET.Sdk">

  <!-- 组件库的测试：信号运行时是纯逻辑测试；控件相关的在专用的 STA 线程（带消息循环）上跑。xunit v3 的测试项目是可执行程序 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rune.WinForms.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rune.WinForms\Rune.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
