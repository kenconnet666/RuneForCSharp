<!--
  CodePreview 部件的默认外观（vue-tsx-pro 的 codePreviewStyles）：工具栏与源码上边各一道 borderMuted 的分隔线。
  排布的外边距、工具栏的内边距随字号，在 CodePreview.cs 里
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <Style x:Key="{x:Static rune:CodePreviewParts.Toolbar}" TargetType="Border">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
  </Style>
  <Style x:Key="{x:Static rune:CodePreviewParts.CodeFrame}" TargetType="Border">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
  </Style>
</ResourceDictionary>
