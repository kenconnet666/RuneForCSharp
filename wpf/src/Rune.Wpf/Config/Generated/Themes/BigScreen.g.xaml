<!-- 由 tools/token-gen 从 vue-tsx-pro 的 packages/ui/src/config/theme 生成，不要手改；改了那边的 token 后运行 node tools/token-gen/token-gen.mjs -->
<!-- 大屏（big-screen，暗色）：随主题变的 token（colors、shadows、fonts、radii）；阴影取最显眼的一层做 DropShadowEffect -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:rune="clr-namespace:Rune.Wpf"
                    mc:Ignorable="po">

  <!-- colors -->
  <!-- background = #061332：页面背景。亮色 slate 2 `#f9f9fb`（着一点色，白色的卡片、输入框浮在上面），暗色 slate 1 `#111113` -->
  <Color x:Key="Rune.Color.Background">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.Background" po:Freeze="True" Color="#FF061332" />
  <!-- surface = #0b1e47：卡片、输入框等表面。亮色白 `#ffffff`，暗色 slate 2 `#18191b`：都比页面亮一层 -->
  <Color x:Key="Rune.Color.Surface">#FF0B1E47</Color>
  <SolidColorBrush x:Key="Rune.Brush.Surface" po:Freeze="True" Color="#FF0B1E47" />
  <!-- surfaceMuted = #0b1e47：弱化的区域背景：表头、侧栏、代码块。亮色取 slate 2 与 3 的中间 `#f4f4f7`（放在页面上也看得出），暗色 slate 2 `#18191b` -->
  <Color x:Key="Rune.Color.SurfaceMuted">#FF0B1E47</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceMuted" po:Freeze="True" Color="#FF0B1E47" />
  <!-- surfaceRaised = #0f2655：浮层（弹出框、菜单、对话框）表面，靠描边与阴影区分层级。亮色白 `#ffffff`，暗色 slate 2 `#18191b` （暗色不取第 3 级：那是 fill，浮层里的填充会看不见） -->
  <Color x:Key="Rune.Color.SurfaceRaised">#FF0F2655</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceRaised" po:Freeze="True" Color="#FF0F2655" />
  <!-- fill = #132c60：填充：标签、开关关闭态、弱按钮。slate 3：亮色 `#f0f0f3`，暗色 `#212225` -->
  <Color x:Key="Rune.Color.Fill">#FF132C60</Color>
  <SolidColorBrush x:Key="Rune.Brush.Fill" po:Freeze="True" Color="#FF132C60" />
  <!-- fillHover = #19356f：填充悬停；也用于幽灵按钮、菜单项的悬停背景。slate 4：亮色 `#e8e8ec`，暗色 `#272a2d` -->
  <Color x:Key="Rune.Color.FillHover">#FF19356F</Color>
  <SolidColorBrush x:Key="Rune.Brush.FillHover" po:Freeze="True" Color="#FF19356F" />
  <!-- fillActive = #1f3e7e：填充按下、选中。slate 5：亮色 `#e0e1e6`，暗色 `#2e3135` -->
  <Color x:Key="Rune.Color.FillActive">#FF1F3E7E</Color>
  <SolidColorBrush x:Key="Rune.Brush.FillActive" po:Freeze="True" Color="#FF1F3E7E" />
  <!-- text = #f0f6ff：主要文字。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
  <Color x:Key="Rune.Color.Text">#FFF0F6FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Text" po:Freeze="True" Color="#FFF0F6FF" />
  <!-- textMuted = #b4c7e6：次要文字、说明、图标。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
  <Color x:Key="Rune.Color.TextMuted">#FFB4C7E6</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextMuted" po:Freeze="True" Color="#FFB4C7E6" />
  <!-- textPlaceholder = #b4c7e6：输入框占位文字。slate 11（同 textMuted）：亮色 `#60646c`，暗色 `#b0b4ba`。 不用 10 级：在输入框的浅底上只有 3.3:1，占位文字也是要读的文字（WCAG 1.4.3），按 4.5:1；同 GitHub Primer 的做法 -->
  <Color x:Key="Rune.Color.TextPlaceholder">#FFB4C7E6</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextPlaceholder" po:Freeze="True" Color="#FFB4C7E6" />
  <!-- textDisabled = #5c749f：不可用的文字。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
  <Color x:Key="Rune.Color.TextDisabled">#FF5C749F</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextDisabled" po:Freeze="True" Color="#FF5C749F" />
  <!-- borderMuted = #1f3b73：弱边框：分割线、表格线。slate 6：亮色 `#d9d9e0`，暗色 `#363a3f` -->
  <Color x:Key="Rune.Color.BorderMuted">#FF1F3B73</Color>
  <SolidColorBrush x:Key="Rune.Brush.BorderMuted" po:Freeze="True" Color="#FF1F3B73" />
  <!-- border = #2c4c8c：普通边框：输入框、卡片、浮层。slate 7：亮色 `#cdced6`，暗色 `#43484e` -->
  <Color x:Key="Rune.Color.Border">#FF2C4C8C</Color>
  <SolidColorBrush x:Key="Rune.Brush.Border" po:Freeze="True" Color="#FF2C4C8C" />
  <!-- borderStrong = #4a6dab：强调边框：悬停。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
  <Color x:Key="Rune.Color.BorderStrong">#FF4A6DAB</Color>
  <SolidColorBrush x:Key="Rune.Brush.BorderStrong" po:Freeze="True" Color="#FF4A6DAB" />
  <!-- accent = #22b8ff：品牌色实色：主按钮、选中的复选框。indigo 9：两套主题都是 `#3e63dd` -->
  <Color x:Key="Rune.Color.Accent">#FF22B8FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Accent" po:Freeze="True" Color="#FF22B8FF" />
  <!-- accentHover = #55c8ff：品牌色实色悬停。亮色 indigo 10 `#3358d4`；暗色比实色更深一点 `#3758d4`（indigo 10 `#5472e4` 配白字只有 4.28:1） -->
  <Color x:Key="Rune.Color.AccentHover">#FF55C8FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentHover" po:Freeze="True" Color="#FF55C8FF" />
  <!-- accentContrast = #061332：品牌色实色上的文字与图标。Radix 规定 indigo 9 上用白字：`#ffffff` -->
  <Color x:Key="Rune.Color.AccentContrast">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentContrast" po:Freeze="True" Color="#FF061332" />
  <!-- accentText = #6ed3ff：品牌色文字：链接、选中项的文字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
  <Color x:Key="Rune.Color.AccentText">#FF6ED3FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentText" po:Freeze="True" Color="#FF6ED3FF" />
  <!-- accentSoft = #0c2f5e：品牌色浅底：选中行、弱主按钮。indigo 3：亮色 `#edf2fe`，暗色 `#182449` -->
  <Color x:Key="Rune.Color.AccentSoft">#FF0C2F5E</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentSoft" po:Freeze="True" Color="#FF0C2F5E" />
  <!-- accentSoftHover = #103a72：品牌色浅底悬停。indigo 4：亮色 `#e1e9ff`，暗色 `#1d2e62` -->
  <Color x:Key="Rune.Color.AccentSoftHover">#FF103A72</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentSoftHover" po:Freeze="True" Color="#FF103A72" />
  <!-- accentBorder = #1f6aa8：品牌色边框：选中的卡片、弱主按钮描边。indigo 7：亮色 `#abbdf9`，暗色 `#3a4f97` -->
  <Color x:Key="Rune.Color.AccentBorder">#FF1F6AA8</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentBorder" po:Freeze="True" Color="#FF1F6AA8" />
  <!-- danger = #cf3f47：危险实色：危险按钮的底色，上面放 dangerContrast（白色）文字，要满足 4.5:1。 red 9 配白字只有 3.91:1，所以亮色用 red 11 `#ce2c31`（5.21:1），暗色用 red 8 `#b54548`（5.37:1） -->
  <Color x:Key="Rune.Color.Danger">#FFCF3F47</Color>
  <SolidColorBrush x:Key="Rune.Brush.Danger" po:Freeze="True" Color="#FFCF3F47" />
  <!-- dangerHover = #b8353d：危险实色悬停：比实色更深一点，白字才满足 4.5:1（red 10 只有 4.37:1）。亮色 `#b8272c`，暗色 `#a33b3e` -->
  <Color x:Key="Rune.Color.DangerHover">#FFB8353D</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerHover" po:Freeze="True" Color="#FFB8353D" />
  <!-- dangerContrast = #ffffff：危险实色上的文字与图标：`#ffffff` -->
  <Color x:Key="Rune.Color.DangerContrast">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerContrast" po:Freeze="True" Color="#FFFFFFFF" />
  <!-- dangerText = #ff9a97：危险文字：错误提示。亮色比 red 11 深一点 `#b8272c`（red 11 在 dangerSoftHover 上只有 4.07:1），暗色 red 11 `#ff9592` -->
  <Color x:Key="Rune.Color.DangerText">#FFFF9A97</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerText" po:Freeze="True" Color="#FFFF9A97" />
  <!-- dangerSoft = #3d1630：危险浅底：错误提示条。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
  <Color x:Key="Rune.Color.DangerSoft">#FF3D1630</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerSoft" po:Freeze="True" Color="#FF3D1630" />
  <!-- dangerSoftHover = #511a38：危险浅底悬停。red 4：亮色 `#ffdbdc`，暗色 `#500f1c` -->
  <Color x:Key="Rune.Color.DangerSoftHover">#FF511A38</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerSoftHover" po:Freeze="True" Color="#FF511A38" />
  <!-- dangerBorder = #94384a：危险边框：校验失败的输入框。red 7：亮色 `#f4a9aa`，暗色 `#8c333a` -->
  <Color x:Key="Rune.Color.DangerBorder">#FF94384A</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerBorder" po:Freeze="True" Color="#FF94384A" />
  <!-- successText = #4ee3a0：成功文字与图标。亮色 `#17714a`（green 11 与 12 之间），暗色 green 11 `#3dd68c`。 亮色不用 11 级：green 11 在 successSoft（green 3）上只有 4.21:1，标记、提示条里的文字不到 4.5； 也不用 12 级：近黑色与正文分不出（同 dangerText 取中间调），在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.SuccessText">#FF4EE3A0</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessText" po:Freeze="True" Color="#FF4EE3A0" />
  <!-- successSoft = #0c3338：成功浅底。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
  <Color x:Key="Rune.Color.SuccessSoft">#FF0C3338</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessSoft" po:Freeze="True" Color="#FF0C3338" />
  <!-- successBorder = #1f7560：成功边框。green 7：亮色 `#8eceaa`，暗色 `#28684a` -->
  <Color x:Key="Rune.Color.SuccessBorder">#FF1F7560</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessBorder" po:Freeze="True" Color="#FF1F7560" />
  <!-- success = #2fc98a：成功实色：成功按钮、实底徽标的底色，上面放 successContrast。亮色 `#008751`，暗色 green 9 `#30a46c`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 successText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Success">#FF2FC98A</Color>
  <SolidColorBrush x:Key="Rune.Brush.Success" po:Freeze="True" Color="#FF2FC98A" />
  <!-- successHover = #52d7a0：成功实色悬停：与 successContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#007143`，暗色 `#52af7d` -->
  <Color x:Key="Rune.Color.SuccessHover">#FF52D7A0</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessHover" po:Freeze="True" Color="#FF52D7A0" />
  <!-- successContrast = #061332：成功实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.SuccessContrast">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessContrast" po:Freeze="True" Color="#FF061332" />
  <!-- successSoftHover = #0e4043：成功浅底悬停。green 4：亮色 `#d6f1df`，暗色 `#113b29` -->
  <Color x:Key="Rune.Color.SuccessSoftHover">#FF0E4043</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessSoftHover" po:Freeze="True" Color="#FF0E4043" />
  <!-- warningText = #ffd24a：警告文字与图标。亮色 `#8a5300`（amber 11 与 12 之间），暗色 amber 11 `#ffca16`。 亮色不用 11 级：amber 11（`#ab6400`）在页面背景上对比度 4.49，不到 WCAG AA 的 4.5； 也不用 12 级：近黑色与正文分不出，在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.WarningText">#FFFFD24A</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningText" po:Freeze="True" Color="#FFFFD24A" />
  <!-- warningSoft = #2f2a2a：警告浅底。amber 3：亮色 `#fff7c2`，暗色 `#302008` -->
  <Color x:Key="Rune.Color.WarningSoft">#FF2F2A2A</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningSoft" po:Freeze="True" Color="#FF2F2A2A" />
  <!-- warningBorder = #7a6020：警告边框。amber 7：亮色 `#e9c162`，暗色 `#714f19` -->
  <Color x:Key="Rune.Color.WarningBorder">#FF7A6020</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningBorder" po:Freeze="True" Color="#FF7A6020" />
  <!-- warning = #ffc53d：警告实色：警告按钮、实底徽标的底色，上面放 warningContrast。亮色 `#ffc53d`，暗色 amber 9 `#ffc53d`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 warningText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Warning">#FFFFC53D</Color>
  <SolidColorBrush x:Key="Rune.Brush.Warning" po:Freeze="True" Color="#FFFFC53D" />
  <!-- warningHover = #ffcd5f：警告实色悬停：与 warningContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#ffcd5f`，暗色 `#ffcd5f` -->
  <Color x:Key="Rune.Color.WarningHover">#FFFFCD5F</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningHover" po:Freeze="True" Color="#FFFFCD5F" />
  <!-- warningContrast = #061332：警告实色上的文字与图标。亮色 `#4f3422`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.WarningContrast">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningContrast" po:Freeze="True" Color="#FF061332" />
  <!-- warningSoftHover = #3d3528：警告浅底悬停。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
  <Color x:Key="Rune.Color.WarningSoftHover">#FF3D3528</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningSoftHover" po:Freeze="True" Color="#FF3D3528" />
  <!-- infoText = #8ab9ff：信息文字与图标。亮色 `#0c64b3`（blue 11 与 12 之间），暗色 blue 11 `#70b8ff`。 亮色不用 11 级：blue 11 在 infoSoft（blue 3）上只有 4.25:1；也不用 12 级：近黑色与正文分不出， 在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.InfoText">#FF8AB9FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoText" po:Freeze="True" Color="#FF8AB9FF" />
  <!-- infoSoft = #102c63：信息浅底。blue 3：亮色 `#e6f4fe`，暗色 `#0d2847` -->
  <Color x:Key="Rune.Color.InfoSoft">#FF102C63</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoSoft" po:Freeze="True" Color="#FF102C63" />
  <!-- infoBorder = #2f5fb0：信息边框。blue 7：亮色 `#8ec8f6`，暗色 `#205d9e` -->
  <Color x:Key="Rune.Color.InfoBorder">#FF2F5FB0</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoBorder" po:Freeze="True" Color="#FF2F5FB0" />
  <!-- info = #5a9bff：信息实色：信息按钮、实底徽标的底色，上面放 infoContrast。亮色 `#0073e0`，暗色 blue 9 `#0090ff`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 infoText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Info">#FF5A9BFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Info" po:Freeze="True" Color="#FF5A9BFF" />
  <!-- infoHover = #7aafff：信息实色悬停：与 infoContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#0060bd`，暗色 `#3d9fff` -->
  <Color x:Key="Rune.Color.InfoHover">#FF7AAFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoHover" po:Freeze="True" Color="#FF7AAFFF" />
  <!-- infoContrast = #061332：信息实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.InfoContrast">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoContrast" po:Freeze="True" Color="#FF061332" />
  <!-- infoSoftHover = #143674：信息浅底悬停。blue 4：亮色 `#d5efff`，暗色 `#003362` -->
  <Color x:Key="Rune.Color.InfoSoftHover">#FF143674</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoSoftHover" po:Freeze="True" Color="#FF143674" />
  <!-- inverseSurface = #f0f6ff：反色表面。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
  <Color x:Key="Rune.Color.InverseSurface">#FFF0F6FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseSurface" po:Freeze="True" Color="#FFF0F6FF" />
  <!-- inverseText = #061332：反色表面上的文字。slate 1：亮色 `#fcfcfd`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.InverseText">#FF061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseText" po:Freeze="True" Color="#FF061332" />
  <!-- focusRing = #22b8ff：焦点环（:focus-visible）。indigo 9：两套主题都是 `#3e63dd`。 Radix 建议 7–8 级，但亮色下对比度不到 3:1（WCAG 2.2 焦点外观要求），所以用 9 级 -->
  <Color x:Key="Rune.Color.FocusRing">#FF22B8FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.FocusRing" po:Freeze="True" Color="#FF22B8FF" />
  <!-- overlay = rgba(2, 8, 26, 0.7)：模态遮罩。亮色 blackA 6 `rgba(0, 0, 0, 0.4)`，暗色 blackA 8 `rgba(0, 0, 0, 0.6)` -->
  <Color x:Key="Rune.Color.Overlay">#B302081A</Color>
  <SolidColorBrush x:Key="Rune.Brush.Overlay" po:Freeze="True" Color="#B302081A" />
  <!-- scrim = rgba(0, 0, 0, 0.55)：图片、视频上的深色遮罩，上面放 onScrim 的文字（上传的进度与文件名）。 盖在任意图片上，不跟主题变：`rgba(0, 0, 0, 0.55)` -->
  <Color x:Key="Rune.Color.Scrim">#8C000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.Scrim" po:Freeze="True" Color="#8C000000" />
  <!-- scrimStrong = rgba(0, 0, 0, 0.86)：看图时铺满的深色背景（Lightbox）：`rgba(0, 0, 0, 0.86)` -->
  <Color x:Key="Rune.Color.ScrimStrong">#DB000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.ScrimStrong" po:Freeze="True" Color="#DB000000" />
  <!-- onScrim = #ffffff：遮罩上的文字与图标：`#ffffff` -->
  <Color x:Key="Rune.Color.OnScrim">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.OnScrim" po:Freeze="True" Color="#FFFFFFFF" />
  <!-- selection = #14508f：选中文字的底色（::selection）。indigo 5：亮色 `#d2deff`，暗色 `#253974` -->
  <Color x:Key="Rune.Color.Selection">#FF14508F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Selection" po:Freeze="True" Color="#FF14508F" />
  <!-- highlight = #4a3c12：高亮标记：搜索命中、`<mark>`。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
  <Color x:Key="Rune.Color.Highlight">#FF4A3C12</Color>
  <SolidColorBrush x:Key="Rune.Brush.Highlight" po:Freeze="True" Color="#FF4A3C12" />
  <!-- surfaceTranslucent = rgba(6, 19, 50, 0.8)：半透明表面：吸顶的顶栏（配合背景模糊）。页面背景加 80% 不透明 -->
  <Color x:Key="Rune.Color.SurfaceTranslucent">#CC061332</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceTranslucent" po:Freeze="True" Color="#CC061332" />
  <!-- codeKeyword = #6ed3ff：关键字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
  <Color x:Key="Rune.Color.CodeKeyword">#FF6ED3FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeKeyword" po:Freeze="True" Color="#FF6ED3FF" />
  <!-- codeString = #4ee3a0：字符串。亮色比 green 11 深一点 `#1c7a51`（在代码块背景上 green 11 只有 4.49:1），暗色 green 11 `#3dd68c` -->
  <Color x:Key="Rune.Color.CodeString">#FF4EE3A0</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeString" po:Freeze="True" Color="#FF4EE3A0" />
  <!-- codeNumber = #ffb26b：数字、常量。亮色比 orange 11 深一点 `#bb4500`（orange 11 在代码块背景上只有 4.29:1），暗色 orange 11 `#ffa057` -->
  <Color x:Key="Rune.Color.CodeNumber">#FFFFB26B</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeNumber" po:Freeze="True" Color="#FFFFB26B" />
  <!-- codeFunction = #c0b0ff：函数名。violet 11：亮色 `#6550b9`，暗色 `#baa7ff` -->
  <Color x:Key="Rune.Color.CodeFunction">#FFC0B0FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeFunction" po:Freeze="True" Color="#FFC0B0FF" />
  <!-- codeType = #8ab9ff：类型、类名。亮色比 cyan 11 深一点 `#007590`（cyan 11 在行内代码的底色上只有 4.19:1），暗色 cyan 11 `#4ccce6` -->
  <Color x:Key="Rune.Color.CodeType">#FF8AB9FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeType" po:Freeze="True" Color="#FF8AB9FF" />
  <!-- codeComment = #b4c7e6：注释、标点。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
  <Color x:Key="Rune.Color.CodeComment">#FFB4C7E6</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeComment" po:Freeze="True" Color="#FFB4C7E6" />
  <!-- codeTag = #ff9ab8：标签名（HTML、JSX）。crimson 11：亮色 `#cb1d63`，暗色 `#ff92ad` -->
  <Color x:Key="Rune.Color.CodeTag">#FFFF9AB8</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeTag" po:Freeze="True" Color="#FFFF9AB8" />
  <!-- codeAttribute = #ffd24a：属性名。brown 11：亮色 `#815e46`，暗色 `#dbb594` -->
  <Color x:Key="Rune.Color.CodeAttribute">#FFFFD24A</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeAttribute" po:Freeze="True" Color="#FFFFD24A" />
  <!-- codeInserted = #0c3338：diff 新增行的底色。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
  <Color x:Key="Rune.Color.CodeInserted">#FF0C3338</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeInserted" po:Freeze="True" Color="#FF0C3338" />
  <!-- codeDeleted = #3d1630：diff 删除行的底色。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
  <Color x:Key="Rune.Color.CodeDeleted">#FF3D1630</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeDeleted" po:Freeze="True" Color="#FF3D1630" />
  <!-- chart1 = #22b8ff：第 1 个系列：跟随品牌色。indigo 9：两套主题都是 `#3e63dd` -->
  <Color x:Key="Rune.Color.Chart1">#FF22B8FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart1" po:Freeze="True" Color="#FF22B8FF" />
  <!-- chart2 = #2fe0b0：第 2 个系列。teal：亮色 10 级 `#0d9b8a`，暗色 9 级 `#12a594` -->
  <Color x:Key="Rune.Color.Chart2">#FF2FE0B0</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart2" po:Freeze="True" Color="#FF2FE0B0" />
  <!-- chart3 = #ffc53d：第 3 个系列。orange：亮色 10 级 `#ef5f00`，暗色 9 级 `#f76b15` -->
  <Color x:Key="Rune.Color.Chart3">#FFFFC53D</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart3" po:Freeze="True" Color="#FFFFC53D" />
  <!-- chart4 = #ff7d6b：第 4 个系列。crimson 9：两套主题都是 `#e93d82` -->
  <Color x:Key="Rune.Color.Chart4">#FFFF7D6B</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart4" po:Freeze="True" Color="#FFFF7D6B" />
  <!-- chart5 = #a78bff：第 5 个系列。violet 9：两套主题都是 `#6e56cf` -->
  <Color x:Key="Rune.Color.Chart5">#FFA78BFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart5" po:Freeze="True" Color="#FFA78BFF" />
  <!-- chart6 = #5a9bff：第 6 个系列。cyan：亮色 10 级 `#0797b9`，暗色 9 级 `#00a2c7` -->
  <Color x:Key="Rune.Color.Chart6">#FF5A9BFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart6" po:Freeze="True" Color="#FF5A9BFF" />
  <!-- chart7 = #ff77c8：第 7 个系列。grass：亮色 10 级 `#3e9b4f`，暗色 9 级 `#46a758` -->
  <Color x:Key="Rune.Color.Chart7">#FFFF77C8</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart7" po:Freeze="True" Color="#FFFF77C8" />
  <!-- chart8 = #9be15d：第 8 个系列。amber：亮色 11 级 `#ab6400`（9、10 级在浅色背景上不到 2:1），暗色 9 级 `#ffc53d` -->
  <Color x:Key="Rune.Color.Chart8">#FF9BE15D</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart8" po:Freeze="True" Color="#FF9BE15D" />
  <!-- inverseSurfaceHover = color-mix(in oklab, inverseSurface 85%, background)：中性实底按钮的悬停底色（button-core 的 color-mix(in oklab, inverseSurface 85%, background)）（token-gen 算出） -->
  <Color x:Key="Rune.Color.InverseSurfaceHover">#FFC8D0DE</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseSurfaceHover" po:Freeze="True" Color="#FFC8D0DE" />

  <!-- shadows -->
  <!-- none = none：无阴影 -->
  <x:Null x:Key="Rune.Shadow.None" />
  <!-- xs = 0 0 0 1px rgba(34, 184, 255, 0.12), 0 1px 3px 0 rgba(0, 0, 0, 0.5)：贴近表面：卡片 -->
  <DropShadowEffect x:Key="Rune.Shadow.Xs" po:Freeze="True" BlurRadius="3" ShadowDepth="1" Direction="270" Color="#FF000000" Opacity="0.5" />
  <!-- sm = 0 0 0 1px rgba(34, 184, 255, 0.16), 0 0 10px -2px rgba(34, 184, 255, 0.2), 0 4px 12px -4px rgba(0, 0, 0, 0.6)：轻微浮起：悬停的卡片 -->
  <DropShadowEffect x:Key="Rune.Shadow.Sm" po:Freeze="True" BlurRadius="12" ShadowDepth="4" Direction="270" Color="#FF000000" Opacity="0.6" />
  <!-- md = 0 0 0 1px rgba(34, 184, 255, 0.18), 0 0 24px -4px rgba(34, 184, 255, 0.22), 0 12px 32px -16px rgba(0, 0, 0, 0.7)：浮起：下拉面板 -->
  <DropShadowEffect x:Key="Rune.Shadow.Md" po:Freeze="True" BlurRadius="32" ShadowDepth="12" Direction="270" Color="#FF000000" Opacity="0.7" />
  <!-- lg = 0 0 0 1px rgba(34, 184, 255, 0.22), 0 0 40px -6px rgba(34, 184, 255, 0.26), 0 12px 32px -16px rgba(0, 0, 0, 0.8)：浮层：弹出框、菜单、提示 -->
  <DropShadowEffect x:Key="Rune.Shadow.Lg" po:Freeze="True" BlurRadius="40" ShadowDepth="0" Direction="0" Color="#FF22B8FF" Opacity="0.26" />
  <!-- xl = 0 0 0 1px rgba(34, 184, 255, 0.26), 0 0 60px -8px rgba(34, 184, 255, 0.3), 0 16px 36px -20px rgba(0, 0, 0, 0.9)：对话框 -->
  <DropShadowEffect x:Key="Rune.Shadow.Xl" po:Freeze="True" BlurRadius="60" ShadowDepth="0" Direction="0" Color="#FF22B8FF" Opacity="0.3" />

  <!-- fonts -->
  <!-- sans = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：正文字体：西文用系统界面字体；中文在 Windows 上优先“微软雅黑 UI”（界面字号下字距更紧凑）， Linux 上是思源黑体（Noto / Source Han Sans） -->
  <FontFamily x:Key="Rune.Font.Sans">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>
  <!-- mono = ui-monospace, "Cascadia Code", "JetBrains Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace：等宽字体：代码、需要数字对齐的地方。装了 Cascadia Code（Windows 11 自带）、JetBrains Mono 时优先用它们， 字形比 Consolas 清楚 -->
  <FontFamily x:Key="Rune.Font.Mono">Cascadia Code, JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono</FontFamily>
  <!-- serif = "Noto Serif SC", "Source Han Serif SC", "Songti SC", STSong, "SimSun", Georgia, serif：衬线字体：书卷感的标题、引文（纸张主题的标题用它） -->
  <FontFamily x:Key="Rune.Font.Serif">Noto Serif SC, Source Han Serif SC, Songti SC, STSong, SimSun, Georgia</FontFamily>
  <!-- heading = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：标题（H1–H6）的字体：默认同正文，主题可以换成衬线 -->
  <FontFamily x:Key="Rune.Font.Heading">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>

  <!-- radii -->
  <!-- none = 0（设备无关像素）：`0` -->
  <sys:Double x:Key="Rune.Radius.None">0</sys:Double>
  <!-- xs = 0.1em（em 系数）：`0.15em`：控件内的小元素 -->
  <sys:Double x:Key="Rune.Radius.Xs">0.1</sys:Double>
  <!-- sm = 0.2em（em 系数）：`0.25em`：标签、复选框 -->
  <sys:Double x:Key="Rune.Radius.Sm">0.2</sys:Double>
  <!-- md = 0.3em（em 系数）：`0.4em`：按钮、输入框 -->
  <sys:Double x:Key="Rune.Radius.Md">0.3</sys:Double>
  <!-- lg = 0.45em（em 系数）：`0.7em`：卡片、浮层 -->
  <sys:Double x:Key="Rune.Radius.Lg">0.45</sys:Double>
  <!-- xl = 0.65em（em 系数）：`1em`：对话框 -->
  <sys:Double x:Key="Rune.Radius.Xl">0.65</sys:Double>
  <!-- full = 9999px（设备无关像素）：全圆：胶囊按钮、头像、开关 -->
  <sys:Double x:Key="Rune.Radius.Full">9999</sys:Double>
</ResourceDictionary>
