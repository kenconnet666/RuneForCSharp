<!-- 由 tools/token-gen 从 vue-tsx-pro 的 packages/ui/src/config/theme 生成，不要手改；改了那边的 token 后运行 node tools/token-gen/token-gen.mjs -->
<!-- 高对比暗色（high-contrast-dark，暗色）：随主题变的 token（colors、shadows、fonts、radii）；阴影取最显眼的一层做 DropShadowEffect -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:rune="clr-namespace:Rune.Wpf"
                    mc:Ignorable="po">

  <!-- colors -->
  <!-- background = #000000：页面背景。亮色 slate 2 `#f9f9fb`（着一点色，白色的卡片、输入框浮在上面），暗色 slate 1 `#111113` -->
  <Color x:Key="Rune.Color.Background">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.Background" po:Freeze="True" Color="#FF000000" />
  <!-- surface = #000000：卡片、输入框等表面。亮色白 `#ffffff`，暗色 slate 2 `#18191b`：都比页面亮一层 -->
  <Color x:Key="Rune.Color.Surface">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.Surface" po:Freeze="True" Color="#FF000000" />
  <!-- surfaceMuted = #0d0d0d：弱化的区域背景：表头、侧栏、代码块。亮色取 slate 2 与 3 的中间 `#f4f4f7`（放在页面上也看得出），暗色 slate 2 `#18191b` -->
  <Color x:Key="Rune.Color.SurfaceMuted">#FF0D0D0D</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceMuted" po:Freeze="True" Color="#FF0D0D0D" />
  <!-- surfaceRaised = #0d0d0d：浮层（弹出框、菜单、对话框）表面，靠描边与阴影区分层级。亮色白 `#ffffff`，暗色 slate 2 `#18191b` （暗色不取第 3 级：那是 fill，浮层里的填充会看不见） -->
  <Color x:Key="Rune.Color.SurfaceRaised">#FF0D0D0D</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceRaised" po:Freeze="True" Color="#FF0D0D0D" />
  <!-- fill = #1f1f1f：填充：标签、开关关闭态、弱按钮。slate 3：亮色 `#f0f0f3`，暗色 `#212225` -->
  <Color x:Key="Rune.Color.Fill">#FF1F1F1F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Fill" po:Freeze="True" Color="#FF1F1F1F" />
  <!-- fillHover = #2e2e2e：填充悬停；也用于幽灵按钮、菜单项的悬停背景。slate 4：亮色 `#e8e8ec`，暗色 `#272a2d` -->
  <Color x:Key="Rune.Color.FillHover">#FF2E2E2E</Color>
  <SolidColorBrush x:Key="Rune.Brush.FillHover" po:Freeze="True" Color="#FF2E2E2E" />
  <!-- fillActive = #3d3d3d：填充按下、选中。slate 5：亮色 `#e0e1e6`，暗色 `#2e3135` -->
  <Color x:Key="Rune.Color.FillActive">#FF3D3D3D</Color>
  <SolidColorBrush x:Key="Rune.Brush.FillActive" po:Freeze="True" Color="#FF3D3D3D" />
  <!-- text = #ffffff：主要文字。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
  <Color x:Key="Rune.Color.Text">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Text" po:Freeze="True" Color="#FFFFFFFF" />
  <!-- textMuted = #e0e0e0：次要文字、说明、图标。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
  <Color x:Key="Rune.Color.TextMuted">#FFE0E0E0</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextMuted" po:Freeze="True" Color="#FFE0E0E0" />
  <!-- textPlaceholder = #e0e0e0：输入框占位文字。slate 11（同 textMuted）：亮色 `#60646c`，暗色 `#b0b4ba`。 不用 10 级：在输入框的浅底上只有 3.3:1，占位文字也是要读的文字（WCAG 1.4.3），按 4.5:1；同 GitHub Primer 的做法 -->
  <Color x:Key="Rune.Color.TextPlaceholder">#FFE0E0E0</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextPlaceholder" po:Freeze="True" Color="#FFE0E0E0" />
  <!-- textDisabled = #8a8a8a：不可用的文字。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
  <Color x:Key="Rune.Color.TextDisabled">#FF8A8A8A</Color>
  <SolidColorBrush x:Key="Rune.Brush.TextDisabled" po:Freeze="True" Color="#FF8A8A8A" />
  <!-- borderMuted = #8f8f8f：弱边框：分割线、表格线。slate 6：亮色 `#d9d9e0`，暗色 `#363a3f` -->
  <Color x:Key="Rune.Color.BorderMuted">#FF8F8F8F</Color>
  <SolidColorBrush x:Key="Rune.Brush.BorderMuted" po:Freeze="True" Color="#FF8F8F8F" />
  <!-- border = #b8b8b8：普通边框：输入框、卡片、浮层。slate 7：亮色 `#cdced6`，暗色 `#43484e` -->
  <Color x:Key="Rune.Color.Border">#FFB8B8B8</Color>
  <SolidColorBrush x:Key="Rune.Brush.Border" po:Freeze="True" Color="#FFB8B8B8" />
  <!-- borderStrong = #ebebeb：强调边框：悬停。slate 8：亮色 `#b9bbc6`，暗色 `#5a6169` -->
  <Color x:Key="Rune.Color.BorderStrong">#FFEBEBEB</Color>
  <SolidColorBrush x:Key="Rune.Brush.BorderStrong" po:Freeze="True" Color="#FFEBEBEB" />
  <!-- accent = #9ebcff：品牌色实色：主按钮、选中的复选框。indigo 9：两套主题都是 `#3e63dd` -->
  <Color x:Key="Rune.Color.Accent">#FF9EBCFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Accent" po:Freeze="True" Color="#FF9EBCFF" />
  <!-- accentHover = #bccfff：品牌色实色悬停。亮色 indigo 10 `#3358d4`；暗色比实色更深一点 `#3758d4`（indigo 10 `#5472e4` 配白字只有 4.28:1） -->
  <Color x:Key="Rune.Color.AccentHover">#FFBCCFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentHover" po:Freeze="True" Color="#FFBCCFFF" />
  <!-- accentContrast = #000000：品牌色实色上的文字与图标。Radix 规定 indigo 9 上用白字：`#ffffff` -->
  <Color x:Key="Rune.Color.AccentContrast">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentContrast" po:Freeze="True" Color="#FF000000" />
  <!-- accentText = #a8c3ff：品牌色文字：链接、选中项的文字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
  <Color x:Key="Rune.Color.AccentText">#FFA8C3FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentText" po:Freeze="True" Color="#FFA8C3FF" />
  <!-- accentSoft = #0f1f45：品牌色浅底：选中行、弱主按钮。indigo 3：亮色 `#edf2fe`，暗色 `#182449` -->
  <Color x:Key="Rune.Color.AccentSoft">#FF0F1F45</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentSoft" po:Freeze="True" Color="#FF0F1F45" />
  <!-- accentSoftHover = #182c5e：品牌色浅底悬停。indigo 4：亮色 `#e1e9ff`，暗色 `#1d2e62` -->
  <Color x:Key="Rune.Color.AccentSoftHover">#FF182C5E</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentSoftHover" po:Freeze="True" Color="#FF182C5E" />
  <!-- accentBorder = #7396ea：品牌色边框：选中的卡片、弱主按钮描边。indigo 7：亮色 `#abbdf9`，暗色 `#3a4f97` -->
  <Color x:Key="Rune.Color.AccentBorder">#FF7396EA</Color>
  <SolidColorBrush x:Key="Rune.Brush.AccentBorder" po:Freeze="True" Color="#FF7396EA" />
  <!-- danger = #ff8f8f：危险实色：危险按钮的底色，上面放 dangerContrast（白色）文字，要满足 4.5:1。 red 9 配白字只有 3.91:1，所以亮色用 red 11 `#ce2c31`（5.21:1），暗色用 red 8 `#b54548`（5.37:1） -->
  <Color x:Key="Rune.Color.Danger">#FFFF8F8F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Danger" po:Freeze="True" Color="#FFFF8F8F" />
  <!-- dangerHover = #ffadad：危险实色悬停：比实色更深一点，白字才满足 4.5:1（red 10 只有 4.37:1）。亮色 `#b8272c`，暗色 `#a33b3e` -->
  <Color x:Key="Rune.Color.DangerHover">#FFFFADAD</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerHover" po:Freeze="True" Color="#FFFFADAD" />
  <!-- dangerContrast = #000000：危险实色上的文字与图标：`#ffffff` -->
  <Color x:Key="Rune.Color.DangerContrast">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerContrast" po:Freeze="True" Color="#FF000000" />
  <!-- dangerText = #ffa3a3：危险文字：错误提示。亮色比 red 11 深一点 `#b8272c`（red 11 在 dangerSoftHover 上只有 4.07:1），暗色 red 11 `#ff9592` -->
  <Color x:Key="Rune.Color.DangerText">#FFFFA3A3</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerText" po:Freeze="True" Color="#FFFFA3A3" />
  <!-- dangerSoft = #3d0a10：危险浅底：错误提示条。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
  <Color x:Key="Rune.Color.DangerSoft">#FF3D0A10</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerSoft" po:Freeze="True" Color="#FF3D0A10" />
  <!-- dangerSoftHover = #541019：危险浅底悬停。red 4：亮色 `#ffdbdc`，暗色 `#500f1c` -->
  <Color x:Key="Rune.Color.DangerSoftHover">#FF541019</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerSoftHover" po:Freeze="True" Color="#FF541019" />
  <!-- dangerBorder = #e8606f：危险边框：校验失败的输入框。red 7：亮色 `#f4a9aa`，暗色 `#8c333a` -->
  <Color x:Key="Rune.Color.DangerBorder">#FFE8606F</Color>
  <SolidColorBrush x:Key="Rune.Brush.DangerBorder" po:Freeze="True" Color="#FFE8606F" />
  <!-- successText = #7fe5a3：成功文字与图标。亮色 `#17714a`（green 11 与 12 之间），暗色 green 11 `#3dd68c`。 亮色不用 11 级：green 11 在 successSoft（green 3）上只有 4.21:1，标记、提示条里的文字不到 4.5； 也不用 12 级：近黑色与正文分不出（同 dangerText 取中间调），在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.SuccessText">#FF7FE5A3</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessText" po:Freeze="True" Color="#FF7FE5A3" />
  <!-- successSoft = #0a2e17：成功浅底。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
  <Color x:Key="Rune.Color.SuccessSoft">#FF0A2E17</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessSoft" po:Freeze="True" Color="#FF0A2E17" />
  <!-- successBorder = #3fb26b：成功边框。green 7：亮色 `#8eceaa`，暗色 `#28684a` -->
  <Color x:Key="Rune.Color.SuccessBorder">#FF3FB26B</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessBorder" po:Freeze="True" Color="#FF3FB26B" />
  <!-- success = #62da8f：成功实色：成功按钮、实底徽标的底色，上面放 successContrast。亮色 `#008751`，暗色 green 9 `#30a46c`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 successText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Success">#FF62DA8F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Success" po:Freeze="True" Color="#FF62DA8F" />
  <!-- successHover = #86e7a9：成功实色悬停：与 successContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#007143`，暗色 `#52af7d` -->
  <Color x:Key="Rune.Color.SuccessHover">#FF86E7A9</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessHover" po:Freeze="True" Color="#FF86E7A9" />
  <!-- successContrast = #000000：成功实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.SuccessContrast">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessContrast" po:Freeze="True" Color="#FF000000" />
  <!-- successSoftHover = #0f4021：成功浅底悬停。green 4：亮色 `#d6f1df`，暗色 `#113b29` -->
  <Color x:Key="Rune.Color.SuccessSoftHover">#FF0F4021</Color>
  <SolidColorBrush x:Key="Rune.Brush.SuccessSoftHover" po:Freeze="True" Color="#FF0F4021" />
  <!-- warningText = #ffd970：警告文字与图标。亮色 `#8a5300`（amber 11 与 12 之间），暗色 amber 11 `#ffca16`。 亮色不用 11 级：amber 11（`#ab6400`）在页面背景上对比度 4.49，不到 WCAG AA 的 4.5； 也不用 12 级：近黑色与正文分不出，在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.WarningText">#FFFFD970</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningText" po:Freeze="True" Color="#FFFFD970" />
  <!-- warningSoft = #332400：警告浅底。amber 3：亮色 `#fff7c2`，暗色 `#302008` -->
  <Color x:Key="Rune.Color.WarningSoft">#FF332400</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningSoft" po:Freeze="True" Color="#FF332400" />
  <!-- warningBorder = #cc9c1f：警告边框。amber 7：亮色 `#e9c162`，暗色 `#714f19` -->
  <Color x:Key="Rune.Color.WarningBorder">#FFCC9C1F</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningBorder" po:Freeze="True" Color="#FFCC9C1F" />
  <!-- warning = #ffd25f：警告实色：警告按钮、实底徽标的底色，上面放 warningContrast。亮色 `#ffc53d`，暗色 amber 9 `#ffc53d`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 warningText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Warning">#FFFFD25F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Warning" po:Freeze="True" Color="#FFFFD25F" />
  <!-- warningHover = #ffdf8a：警告实色悬停：与 warningContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#ffcd5f`，暗色 `#ffcd5f` -->
  <Color x:Key="Rune.Color.WarningHover">#FFFFDF8A</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningHover" po:Freeze="True" Color="#FFFFDF8A" />
  <!-- warningContrast = #000000：警告实色上的文字与图标。亮色 `#4f3422`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.WarningContrast">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningContrast" po:Freeze="True" Color="#FF000000" />
  <!-- warningSoftHover = #473300：警告浅底悬停。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
  <Color x:Key="Rune.Color.WarningSoftHover">#FF473300</Color>
  <SolidColorBrush x:Key="Rune.Brush.WarningSoftHover" po:Freeze="True" Color="#FF473300" />
  <!-- infoText = #8fd0ff：信息文字与图标。亮色 `#0c64b3`（blue 11 与 12 之间），暗色 blue 11 `#70b8ff`。 亮色不用 11 级：blue 11 在 infoSoft（blue 3）上只有 4.25:1；也不用 12 级：近黑色与正文分不出， 在浅底、浅底悬停、表面上都到 5:1 -->
  <Color x:Key="Rune.Color.InfoText">#FF8FD0FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoText" po:Freeze="True" Color="#FF8FD0FF" />
  <!-- infoSoft = #06223d：信息浅底。blue 3：亮色 `#e6f4fe`，暗色 `#0d2847` -->
  <Color x:Key="Rune.Color.InfoSoft">#FF06223D</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoSoft" po:Freeze="True" Color="#FF06223D" />
  <!-- infoBorder = #4194db：信息边框。blue 7：亮色 `#8ec8f6`，暗色 `#205d9e` -->
  <Color x:Key="Rune.Color.InfoBorder">#FF4194DB</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoBorder" po:Freeze="True" Color="#FF4194DB" />
  <!-- info = #7cc4ff：信息实色：信息按钮、实底徽标的底色，上面放 infoContrast。亮色 `#0073e0`，暗色 blue 9 `#0090ff`。 黄、绿、蓝的 9 级很亮：配白字不到 4.5:1 时亮色加深到够，暗色改配深色字。图形（勾选框、进度条）的填充仍用 infoText：实色不一定在表面上到 3:1 -->
  <Color x:Key="Rune.Color.Info">#FF7CC4FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Info" po:Freeze="True" Color="#FF7CC4FF" />
  <!-- infoHover = #a1d4ff：信息实色悬停：与 infoContrast 的对比度只升不降（白字时加深，深色字时调亮）。亮色 `#0060bd`，暗色 `#3d9fff` -->
  <Color x:Key="Rune.Color.InfoHover">#FFA1D4FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoHover" po:Freeze="True" Color="#FFA1D4FF" />
  <!-- infoContrast = #000000：信息实色上的文字与图标。亮色 `#ffffff`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.InfoContrast">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoContrast" po:Freeze="True" Color="#FF000000" />
  <!-- infoSoftHover = #0b3257：信息浅底悬停。blue 4：亮色 `#d5efff`，暗色 `#003362` -->
  <Color x:Key="Rune.Color.InfoSoftHover">#FF0B3257</Color>
  <SolidColorBrush x:Key="Rune.Brush.InfoSoftHover" po:Freeze="True" Color="#FF0B3257" />
  <!-- inverseSurface = #ffffff：反色表面。slate 12：亮色 `#1c2024`，暗色 `#edeef0` -->
  <Color x:Key="Rune.Color.InverseSurface">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseSurface" po:Freeze="True" Color="#FFFFFFFF" />
  <!-- inverseText = #000000：反色表面上的文字。slate 1：亮色 `#fcfcfd`，暗色 `#111113` -->
  <Color x:Key="Rune.Color.InverseText">#FF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseText" po:Freeze="True" Color="#FF000000" />
  <!-- focusRing = #ffd60a：焦点环（:focus-visible）。indigo 9：两套主题都是 `#3e63dd`。 Radix 建议 7–8 级，但亮色下对比度不到 3:1（WCAG 2.2 焦点外观要求），所以用 9 级 -->
  <Color x:Key="Rune.Color.FocusRing">#FFFFD60A</Color>
  <SolidColorBrush x:Key="Rune.Brush.FocusRing" po:Freeze="True" Color="#FFFFD60A" />
  <!-- overlay = rgba(0, 0, 0, 0.75)：模态遮罩。亮色 blackA 6 `rgba(0, 0, 0, 0.4)`，暗色 blackA 8 `rgba(0, 0, 0, 0.6)` -->
  <Color x:Key="Rune.Color.Overlay">#BF000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.Overlay" po:Freeze="True" Color="#BF000000" />
  <!-- scrim = rgba(0, 0, 0, 0.55)：图片、视频上的深色遮罩，上面放 onScrim 的文字（上传的进度与文件名）。 盖在任意图片上，不跟主题变：`rgba(0, 0, 0, 0.55)` -->
  <Color x:Key="Rune.Color.Scrim">#8C000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.Scrim" po:Freeze="True" Color="#8C000000" />
  <!-- scrimStrong = rgba(0, 0, 0, 0.86)：看图时铺满的深色背景（Lightbox）：`rgba(0, 0, 0, 0.86)` -->
  <Color x:Key="Rune.Color.ScrimStrong">#DB000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.ScrimStrong" po:Freeze="True" Color="#DB000000" />
  <!-- onScrim = #ffffff：遮罩上的文字与图标：`#ffffff` -->
  <Color x:Key="Rune.Color.OnScrim">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.OnScrim" po:Freeze="True" Color="#FFFFFFFF" />
  <!-- selection = #264aa0：选中文字的底色（::selection）。indigo 5：亮色 `#d2deff`，暗色 `#253974` -->
  <Color x:Key="Rune.Color.Selection">#FF264AA0</Color>
  <SolidColorBrush x:Key="Rune.Brush.Selection" po:Freeze="True" Color="#FF264AA0" />
  <!-- highlight = #5c4500：高亮标记：搜索命中、`<mark>`。amber 4：亮色 `#ffee9c`，暗色 `#3f2700` -->
  <Color x:Key="Rune.Color.Highlight">#FF5C4500</Color>
  <SolidColorBrush x:Key="Rune.Brush.Highlight" po:Freeze="True" Color="#FF5C4500" />
  <!-- surfaceTranslucent = rgba(0, 0, 0, 0.92)：半透明表面：吸顶的顶栏（配合背景模糊）。页面背景加 80% 不透明 -->
  <Color x:Key="Rune.Color.SurfaceTranslucent">#EB000000</Color>
  <SolidColorBrush x:Key="Rune.Brush.SurfaceTranslucent" po:Freeze="True" Color="#EB000000" />
  <!-- codeKeyword = #a8c3ff：关键字。indigo 11：亮色 `#3a5bc7`，暗色 `#9eb1ff` -->
  <Color x:Key="Rune.Color.CodeKeyword">#FFA8C3FF</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeKeyword" po:Freeze="True" Color="#FFA8C3FF" />
  <!-- codeString = #7fe5a3：字符串。亮色比 green 11 深一点 `#1c7a51`（在代码块背景上 green 11 只有 4.49:1），暗色 green 11 `#3dd68c` -->
  <Color x:Key="Rune.Color.CodeString">#FF7FE5A3</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeString" po:Freeze="True" Color="#FF7FE5A3" />
  <!-- codeNumber = #ffb27a：数字、常量。亮色比 orange 11 深一点 `#bb4500`（orange 11 在代码块背景上只有 4.29:1），暗色 orange 11 `#ffa057` -->
  <Color x:Key="Rune.Color.CodeNumber">#FFFFB27A</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeNumber" po:Freeze="True" Color="#FFFFB27A" />
  <!-- codeFunction = #d4bcff：函数名。violet 11：亮色 `#6550b9`，暗色 `#baa7ff` -->
  <Color x:Key="Rune.Color.CodeFunction">#FFD4BCFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeFunction" po:Freeze="True" Color="#FFD4BCFF" />
  <!-- codeType = #80e2f2：类型、类名。亮色比 cyan 11 深一点 `#007590`（cyan 11 在行内代码的底色上只有 4.19:1），暗色 cyan 11 `#4ccce6` -->
  <Color x:Key="Rune.Color.CodeType">#FF80E2F2</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeType" po:Freeze="True" Color="#FF80E2F2" />
  <!-- codeComment = #d1d1d1：注释、标点。slate 11：亮色 `#60646c`，暗色 `#b0b4ba` -->
  <Color x:Key="Rune.Color.CodeComment">#FFD1D1D1</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeComment" po:Freeze="True" Color="#FFD1D1D1" />
  <!-- codeTag = #ffa3c4：标签名（HTML、JSX）。crimson 11：亮色 `#cb1d63`，暗色 `#ff92ad` -->
  <Color x:Key="Rune.Color.CodeTag">#FFFFA3C4</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeTag" po:Freeze="True" Color="#FFFFA3C4" />
  <!-- codeAttribute = #f2cc9e：属性名。brown 11：亮色 `#815e46`，暗色 `#dbb594` -->
  <Color x:Key="Rune.Color.CodeAttribute">#FFF2CC9E</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeAttribute" po:Freeze="True" Color="#FFF2CC9E" />
  <!-- codeInserted = #0d3319：diff 新增行的底色。green 3：亮色 `#e6f6eb`，暗色 `#132d21` -->
  <Color x:Key="Rune.Color.CodeInserted">#FF0D3319</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeInserted" po:Freeze="True" Color="#FF0D3319" />
  <!-- codeDeleted = #4a0f18：diff 删除行的底色。red 3：亮色 `#feebec`，暗色 `#3b1219` -->
  <Color x:Key="Rune.Color.CodeDeleted">#FF4A0F18</Color>
  <SolidColorBrush x:Key="Rune.Brush.CodeDeleted" po:Freeze="True" Color="#FF4A0F18" />
  <!-- chart1 = #9ebcff：第 1 个系列：跟随品牌色。indigo 9：两套主题都是 `#3e63dd` -->
  <Color x:Key="Rune.Color.Chart1">#FF9EBCFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart1" po:Freeze="True" Color="#FF9EBCFF" />
  <!-- chart2 = #4fe0c9：第 2 个系列。teal：亮色 10 级 `#0d9b8a`，暗色 9 级 `#12a594` -->
  <Color x:Key="Rune.Color.Chart2">#FF4FE0C9</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart2" po:Freeze="True" Color="#FF4FE0C9" />
  <!-- chart3 = #ffa066：第 3 个系列。orange：亮色 10 级 `#ef5f00`，暗色 9 级 `#f76b15` -->
  <Color x:Key="Rune.Color.Chart3">#FFFFA066</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart3" po:Freeze="True" Color="#FFFFA066" />
  <!-- chart4 = #ff85b8：第 4 个系列。crimson 9：两套主题都是 `#e93d82` -->
  <Color x:Key="Rune.Color.Chart4">#FFFF85B8</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart4" po:Freeze="True" Color="#FFFF85B8" />
  <!-- chart5 = #c4abff：第 5 个系列。violet 9：两套主题都是 `#6e56cf` -->
  <Color x:Key="Rune.Color.Chart5">#FFC4ABFF</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart5" po:Freeze="True" Color="#FFC4ABFF" />
  <!-- chart6 = #5ad8f2：第 6 个系列。cyan：亮色 10 级 `#0797b9`，暗色 9 级 `#00a2c7` -->
  <Color x:Key="Rune.Color.Chart6">#FF5AD8F2</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart6" po:Freeze="True" Color="#FF5AD8F2" />
  <!-- chart7 = #8fe293：第 7 个系列。grass：亮色 10 级 `#3e9b4f`，暗色 9 级 `#46a758` -->
  <Color x:Key="Rune.Color.Chart7">#FF8FE293</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart7" po:Freeze="True" Color="#FF8FE293" />
  <!-- chart8 = #ffd25f：第 8 个系列。amber：亮色 11 级 `#ab6400`（9、10 级在浅色背景上不到 2:1），暗色 9 级 `#ffc53d` -->
  <Color x:Key="Rune.Color.Chart8">#FFFFD25F</Color>
  <SolidColorBrush x:Key="Rune.Brush.Chart8" po:Freeze="True" Color="#FFFFD25F" />
  <!-- inverseSurfaceHover = color-mix(in oklab, inverseSurface 85%, background)：中性实底按钮的悬停底色（button-core 的 color-mix(in oklab, inverseSurface 85%, background)）（token-gen 算出） -->
  <Color x:Key="Rune.Color.InverseSurfaceHover">#FFCECECE</Color>
  <SolidColorBrush x:Key="Rune.Brush.InverseSurfaceHover" po:Freeze="True" Color="#FFCECECE" />

  <!-- shadows -->
  <!-- none = none：无阴影 -->
  <x:Null x:Key="Rune.Shadow.None" />
  <!-- xs = 0 0 0 1px rgba(255, 255, 255, 0.4)：贴近表面：卡片 -->
  <DropShadowEffect x:Key="Rune.Shadow.Xs" po:Freeze="True" BlurRadius="0" ShadowDepth="0" Direction="0" Color="#FFFFFFFF" Opacity="0.4" />
  <!-- sm = 0 0 0 1px rgba(255, 255, 255, 0.5)：轻微浮起：悬停的卡片 -->
  <DropShadowEffect x:Key="Rune.Shadow.Sm" po:Freeze="True" BlurRadius="0" ShadowDepth="0" Direction="0" Color="#FFFFFFFF" Opacity="0.5" />
  <!-- md = 0 0 0 1px rgba(255, 255, 255, 0.6)：浮起：下拉面板 -->
  <DropShadowEffect x:Key="Rune.Shadow.Md" po:Freeze="True" BlurRadius="0" ShadowDepth="0" Direction="0" Color="#FFFFFFFF" Opacity="0.6" />
  <!-- lg = 0 0 0 1px rgba(255, 255, 255, 0.6)：浮层：弹出框、菜单、提示 -->
  <DropShadowEffect x:Key="Rune.Shadow.Lg" po:Freeze="True" BlurRadius="0" ShadowDepth="0" Direction="0" Color="#FFFFFFFF" Opacity="0.6" />
  <!-- xl = 0 0 0 1px rgba(255, 255, 255, 0.7)：对话框 -->
  <DropShadowEffect x:Key="Rune.Shadow.Xl" po:Freeze="True" BlurRadius="0" ShadowDepth="0" Direction="0" Color="#FFFFFFFF" Opacity="0.7" />

  <!-- fonts -->
  <!-- sans = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：正文字体：西文用系统界面字体；中文在 Windows 上优先“微软雅黑 UI”（界面字号下字距更紧凑）， Linux 上是思源黑体（Noto / Source Han Sans） -->
  <FontFamily x:Key="Rune.Font.Sans">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>
  <!-- mono = ui-monospace, "Cascadia Code", "JetBrains Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace：等宽字体：代码、需要数字对齐的地方。装了 Cascadia Code（Windows 11 自带）、JetBrains Mono 时优先用它们， 字形比 Consolas 清楚 -->
  <FontFamily x:Key="Rune.Font.Mono">Cascadia Code, JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono</FontFamily>
  <!-- serif = "Noto Serif SC", "Source Han Serif SC", "Songti SC", STSong, "SimSun", Georgia, serif：衬线字体：书卷感的标题、引文（纸张主题的标题用它） -->
  <FontFamily x:Key="Rune.Font.Serif">Noto Serif SC, Source Han Serif SC, Songti SC, STSong, SimSun, Georgia</FontFamily>
  <!-- heading = system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", "Noto Sans SC", "Source Han Sans SC", sans-serif：标题（H1–H6）的字体：默认同正文，主题可以换成衬线 -->
  <FontFamily x:Key="Rune.Font.Heading">Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei UI, Microsoft YaHei, Noto Sans SC, Source Han Sans SC</FontFamily>

  <!-- radii -->
  <!-- none = 0（设备无关像素）：`0` -->
  <sys:Double x:Key="Rune.Radius.None">0</sys:Double>
  <!-- xs = 0.15em（em 系数）：`0.15em`：控件内的小元素 -->
  <sys:Double x:Key="Rune.Radius.Xs">0.15</sys:Double>
  <!-- sm = 0.25em（em 系数）：`0.25em`：标签、复选框 -->
  <sys:Double x:Key="Rune.Radius.Sm">0.25</sys:Double>
  <!-- md = 0.4em（em 系数）：`0.4em`：按钮、输入框 -->
  <sys:Double x:Key="Rune.Radius.Md">0.4</sys:Double>
  <!-- lg = 0.7em（em 系数）：`0.7em`：卡片、浮层 -->
  <sys:Double x:Key="Rune.Radius.Lg">0.7</sys:Double>
  <!-- xl = 1em（em 系数）：`1em`：对话框 -->
  <sys:Double x:Key="Rune.Radius.Xl">1</sys:Double>
  <!-- full = 9999px（设备无关像素）：全圆：胶囊按钮、头像、开关 -->
  <sys:Double x:Key="Rune.Radius.Full">9999</sys:Double>
</ResourceDictionary>
