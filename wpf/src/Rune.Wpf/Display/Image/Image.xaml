<!--
  Image 的主题样式（vue-tsx-pro 的 imageStyles）：框的底色 fill、文字与图标 textMuted（读不了时的占位）；不写尺寸时靠左上（按图片的大小）。
  部件：图片铺满框（Stretch 由 Fit 在代码里定），读不了时的占位居中（内边距 sm 按字号在代码里算）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Image">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="{x:Static rune:ImageParts.Image}" TargetType="Image" />
  <Style x:Key="{x:Static rune:ImageParts.Fallback}" TargetType="ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
