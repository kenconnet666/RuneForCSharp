<!-- 手风琴标题按钮的主题样式（vue-tsx-pro 的 accordionStyles.trigger）：整行宽、上下 space.md、左右 space.sm、sm 圆角，悬停 fill 底，medium 字重 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:AccordionTrigger" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="rune:EmSize.Padding" Value="0.5,0.75" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
