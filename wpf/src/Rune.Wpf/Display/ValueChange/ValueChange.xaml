<!-- ValueChange 的主题样式（vue-tsx-pro 的 valueChangeStyles）：原值次要色（删除线在文字上，见 ValueChange.cs），箭头次要色、竖直居中，新值正文色、中等字重 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:ValueChange">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <Style x:Key="{x:Static rune:ValueChangeParts.Before}" TargetType="Border">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <Style x:Key="{x:Static rune:ValueChangeParts.Arrow}" TargetType="rune:Icon">
    <Setter Property="Tone" Value="muted" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Static rune:ValueChangeParts.After}" TargetType="Border">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
  </Style>
</ResourceDictionary>
