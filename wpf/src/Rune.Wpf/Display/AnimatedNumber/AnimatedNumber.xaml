<!-- AnimatedNumber 的主题样式（vue-tsx-pro 的 animatedNumberStyles）：等宽数字、不换行在 AnimatedNumber.cs 里；色调的颜色按 Tone、Trend 设 Foreground -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:AnimatedNumber">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <Style x:Key="{x:Static rune:AnimatedNumberParts.Prefix}" TargetType="ContentPresenter" />
  <Style x:Key="{x:Static rune:AnimatedNumberParts.Value}" TargetType="rune:Text" />
  <Style x:Key="{x:Static rune:AnimatedNumberParts.Suffix}" TargetType="ContentPresenter" />
</ResourceDictionary>
