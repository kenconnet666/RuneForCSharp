<!--
  FormSection 的部件样式（vue-tsx-pro 的 formSectionStyles）：标题栏下面一条 xs 宽的 borderMuted 细线（下边距 sm 在代码里按字号给）；
  标题 md 字号、medium 字重、行高 tight、正文色；可折叠时标题是按钮：左右 xs、sm 圆角、悬停 fill 底；展开箭头 textMuted。
  使用方同键的样式叠在上面（DESIGN §7）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="{x:Static rune:FormSectionParts.Header}" TargetType="Border">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
  </Style>

  <Style x:Key="{x:Static rune:FormSectionParts.Heading}" TargetType="rune:Text">
    <Setter Property="Size" Value="md" />
    <Setter Property="Weight" Value="medium" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />
  </Style>

  <Style x:Key="{x:Static rune:FormSectionParts.Trigger}" TargetType="rune:ButtonBase" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="rune:EmSize.Padding" Value="0.25,0" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static rune:FormSectionParts.Chevron}" TargetType="rune:Icon" />

  <Style x:Key="{x:Static rune:FormSectionParts.Description}" TargetType="rune:Text" />

  <Style x:Key="{x:Static rune:FormSectionParts.Body}" TargetType="rune:Grid" />

  <Style x:Key="{x:Static rune:FormSectionParts.Collapse}" TargetType="rune:Collapse" />
</ResourceDictionary>
