<!--
  CommandPalette 部件的默认外观（vue-tsx-pro 的 commandPaletteStyles）：搜索行下边一条 border 分隔线。
  搜索行的内边距、字号与列表的高度按 em 在 CommandPalette.cs 里算。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="{x:Static rune:CommandPaletteParts.Search}" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</ResourceDictionary>
