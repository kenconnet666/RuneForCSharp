<!--
  Popover 部件的默认外观（vue-tsx-pro 的 floatingStyles.surface、popoverStyles.panel、floatingStyles.arrow）：面板 surfaceRaised、xs 宽的 border 描边、
  文字 text；lg 阴影画在面板后面的一层上；箭头是 0.625em 的小方块，底色同面板，只画右、下两条边（旋转后朝外），压在面板的描边上。
  lg 圆角、space.md 内边距、箭头的大小按 em 在 Popover.cs 里算。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="{x:Static rune:PopoverParts.Panel}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
  </Style>
  <Style x:Key="{x:Static rune:PopoverParts.Shadow}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="Effect" Value="{DynamicResource Rune.Shadow.Lg}" />
  </Style>
  <Style x:Key="{x:Static rune:PopoverParts.Arrow}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="CornerRadius" Value="0,0,2,0" />
  </Style>
</ResourceDictionary>
