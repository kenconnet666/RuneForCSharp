<!--
  Progress 的主题样式（vue-tsx-pro 的 progressRecipe）：默认 accent、圆角 full，字号档位是触发器，环形按内容宽（TS 是 inline-grid）。
  部件的默认外观写在部件样式里（使用方同键的样式叠在上面）：条形的进度按色调着色（中性用次要文字色、accent 用强调色、
  其余状态色用各自的文字色，与轨道之间有 3:1）；数值等宽，条形的次要色、环形的半粗；环形下方的标签次要色、居中
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Progress">
    <Setter Property="Tone" Value="accent" />
    <Setter Property="Radius" Value="full" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
      <Trigger Property="Shape" Value="circle"><Setter Property="HorizontalAlignment" Value="Left" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:ProgressParts.Indicator}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Accent}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="neutral"><Setter Property="Background" Value="{DynamicResource Rune.Brush.TextMuted}" /></DataTrigger>
      <DataTrigger Binding="{Binding Tone.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="info"><Setter Property="Background" Value="{DynamicResource Rune.Brush.InfoText}" /></DataTrigger>
      <DataTrigger Binding="{Binding Tone.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="success"><Setter Property="Background" Value="{DynamicResource Rune.Brush.SuccessText}" /></DataTrigger>
      <DataTrigger Binding="{Binding Tone.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="warning"><Setter Property="Background" Value="{DynamicResource Rune.Brush.WarningText}" /></DataTrigger>
      <DataTrigger Binding="{Binding Tone.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="danger"><Setter Property="Background" Value="{DynamicResource Rune.Brush.DangerText}" /></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:ProgressParts.Header}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:ProgressParts.Label}" TargetType="rune:Text">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Shape.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="circle">
        <Setter Property="Tone" Value="muted" />
        <Setter Property="Align" Value="center" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:ProgressParts.ValueLabel}" TargetType="rune:Text">
    <Setter Property="Numeric" Value="True" />
    <Setter Property="Tone" Value="muted" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Shape.Value, RelativeSource={RelativeSource AncestorType=rune:Progress}}" Value="circle">
        <Setter Property="Tone" Value="inherit" />
        <Setter Property="Weight" Value="semibold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
