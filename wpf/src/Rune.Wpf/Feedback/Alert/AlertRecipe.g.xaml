<!-- 由 tools/recipe-gen 按调色板表（tools/token-gen/palette.mjs）生成，不要手改；运行 node tools/recipe-gen/recipe-gen.mjs -->
<!-- Alert 的样式 × 色调（vue-tsx-pro 的配方 compound）：先 18 条组合，再 0 条悬停（排在后面的触发器优先）。组件的主题样式 BasedOn 它 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="Rune.Recipe.Alert" TargetType="rune:Alert">
    <Style.Triggers>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="neutral" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="accent" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="info" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.InfoSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="success" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.SuccessSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="warning" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.WarningSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="Tone" Value="danger" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.DangerSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="neutral" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="accent" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.AccentBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="info" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.InfoSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.InfoBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="success" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.SuccessSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.SuccessBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="warning" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.WarningSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.WarningBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="surface" /><Condition Property="Tone" Value="danger" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Rune.Brush.DangerSoft}" /><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.DangerBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="neutral" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="accent" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.AccentBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="info" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.InfoBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="success" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.SuccessBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="warning" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.WarningBorder}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="Variant" Value="outline" /><Condition Property="Tone" Value="danger" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.DangerBorder}" /></MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
