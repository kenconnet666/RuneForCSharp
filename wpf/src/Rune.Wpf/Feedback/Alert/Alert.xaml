<!--
  Alert 的主题样式（vue-tsx-pro 的 alertRecipe）：样式 × 色调的颜色是生成的 AlertRecipe.g.xaml（同 Badge 的色表），字号档位是触发器；
  em 尺寸在 Alert.cs 里。部件样式：标题中等字重，说明是正文色（标题、图标随色调）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Feedback/Alert/AlertRecipe.g.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Alert" BasedOn="{StaticResource Rune.Recipe.Alert}">
    <Setter Property="rune:EmSize.Padding" Value="0.75" />
    <!-- borderWidths.xs：每种样式都留出边框的位置（浅色底时透明），切换样式时尺寸不变 -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <Style x:Key="{x:Static rune:AlertParts.Icon}" TargetType="rune:Icon" />
  <Style x:Key="{x:Static rune:AlertParts.Spinner}" TargetType="rune:Spinner" />
  <Style x:Key="{x:Static rune:AlertParts.Body}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:AlertParts.Title}" TargetType="rune:Text">
    <Setter Property="Weight" Value="medium" />
  </Style>
  <Style x:Key="{x:Static rune:AlertParts.Description}" TargetType="ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
  </Style>
  <Style x:Key="{x:Static rune:AlertParts.Content}" TargetType="ContentPresenter" />
  <Style x:Key="{x:Static rune:AlertParts.Action}" TargetType="ContentPresenter" />
  <Style x:Key="{x:Static rune:AlertParts.Close}" TargetType="rune:CloseButton" BasedOn="{StaticResource {x:Type rune:CloseButton}}" />
</ResourceDictionary>
