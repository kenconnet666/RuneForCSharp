<!--
  日期、时间选择器的部件样式（vue-tsx-pro 的 usePickerPopover、datePickerStyles、pickerPresetStyles）：
  打开按钮同输入框里的清空按钮（大小在 PickerPopover 里按字号给）；弹层同 Select 的弹层（surfaceRaised、border 描边，阴影画在后面的一层上；
  lg 圆角与 space.sm 内边距按外壳的字号在代码里算）；快捷选项一列，靠日历那边一条 borderMuted 分隔线；"今天"居中，上边一条 borderMuted 分隔线。
  使用方同键的样式叠在上面（DESIGN §7）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static rune:PickerParts.Button}" TargetType="rune:IconButton" BasedOn="{StaticResource {x:Type rune:IconButton}}" />
  <Style x:Key="{x:Static rune:PickerParts.Popover}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
  </Style>
  <Style x:Key="{x:Static rune:PickerParts.PopoverShadow}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceRaised}" />
    <Setter Property="Effect" Value="{DynamicResource Rune.Shadow.Lg}" />
  </Style>
  <Style x:Key="{x:Static rune:PickerParts.Presets}" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style x:Key="{x:Static rune:PickerParts.Preset}" TargetType="rune:Button" BasedOn="{StaticResource {x:Type rune:Button}}" />
  <Style x:Key="{x:Static rune:PickerParts.Today}" TargetType="rune:Button" BasedOn="{StaticResource {x:Type rune:Button}}" />
  <Style x:Key="{x:Static rune:PickerParts.Footer}" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
</ResourceDictionary>
