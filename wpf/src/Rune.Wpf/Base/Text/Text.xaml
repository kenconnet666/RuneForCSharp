<!--
  Text 家族的主题样式：只放各组件自己的默认值（vue-tsx-pro 的 createText 的 defaults），使用方的样式能改。
  档位是基础样式的触发器：在主题这一层，使用方任何样式都盖得过（DESIGN §4"档位的优先级"）；没写档位时继承外面
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <!-- 浏览器里的文字放不下就换行；TextBlock 默认不换行 -->
  <Style TargetType="rune:Text">
    <Setter Property="TextWrapping" Value="Wrap" />
    <!-- 行高就是行盒的高度（同 CSS），不按字体的行距再加（行高本身在 Text 里按 Leading 算） -->
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
      <Trigger Property="Weight" Value="light"><Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Light}" /></Trigger>
      <Trigger Property="Weight" Value="normal"><Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Normal}" /></Trigger>
      <Trigger Property="Weight" Value="medium"><Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" /></Trigger>
      <Trigger Property="Weight" Value="semibold"><Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" /></Trigger>
      <Trigger Property="Weight" Value="bold"><Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Bold}" /></Trigger>
      <Trigger Property="Tone" Value="neutral"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="Tone" Value="muted"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" /></Trigger>
      <Trigger Property="Tone" Value="accent"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Trigger>
      <Trigger Property="Tone" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /></Trigger>
      <Trigger Property="Tone" Value="success"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /></Trigger>
      <Trigger Property="Tone" Value="warning"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /></Trigger>
      <Trigger Property="Tone" Value="info"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /></Trigger>
      <Trigger Property="Mono" Value="True"><Setter Property="FontFamily" Value="{DynamicResource Rune.Font.Mono}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="rune:Paragraph" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="Wrap" Value="Pretty" />
  </Style>
  <Style TargetType="rune:Strong" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="Weight" Value="semibold" />
  </Style>
  <Style TargetType="rune:Em" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style TargetType="rune:Small" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="Size" Value="xs" />
  </Style>
</ResourceDictionary>
