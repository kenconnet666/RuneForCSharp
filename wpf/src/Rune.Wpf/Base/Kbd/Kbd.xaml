<!-- Kbd 的主题样式（vue-tsx-pro 的 kbdStyles.root）：字号由 EmSize 按外面的 0.85 倍强制，这里的 em 系数都按它算 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Kbd">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <!-- borderWidths.xs，底边 borderWidths.sm：看起来像一个按键 -->
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Rune.Font.Mono}" />
    <Setter Property="rune:EmSize.MinWidth" Value="1.6" />
    <Setter Property="rune:EmSize.Padding" Value="0.25,0" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Snug}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Snug}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:Kbd">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
