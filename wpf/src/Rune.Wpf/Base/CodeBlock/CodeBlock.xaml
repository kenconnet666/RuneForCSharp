<!--
  CodeBlock 的部件样式（vue-tsx-pro 的 codeBlockStyles）：外层 borderMuted 边框、surface 底色；标题栏 surfaceMuted、textMuted、等宽，下边一道分隔线；
  pre 等宽、text 颜色；行号 codeComment；复制按钮在代码区时不透明的 surface 底色（悬停 fill）；展开按钮 surfaceMuted、sm 字号，上边一道分隔线。
  em 尺寸（字号倍数、内边距、圆角、行高、行号宽度）与按行的底色在 CodeBlock.cs 里。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <!-- 复制、展开按钮与箭头的部件样式在它们的主题样式上改：StaticResource 只认本字典与合并进来的字典 -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Icon/Icon.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Layout/ScrollArea/ScrollArea.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static rune:CodeBlockParts.Root}" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Header}" TargetType="Border">
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceMuted}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource Rune.Font.Mono}" />
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Title}" TargetType="ContentPresenter">
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Pre}" TargetType="Border">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="TextElement.FontFamily" Value="{DynamicResource Rune.Font.Mono}" />
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Body}" TargetType="Grid" />
  <Style x:Key="{x:Static rune:CodeBlockParts.Scroll}" TargetType="rune:ScrollArea" BasedOn="{StaticResource {x:Type rune:ScrollArea}}" />
  <Style x:Key="{x:Static rune:CodeBlockParts.Code}" TargetType="TextBlock" />
  <Style x:Key="{x:Static rune:CodeBlockParts.Line}" TargetType="DockPanel" />
  <Style x:Key="{x:Static rune:CodeBlockParts.LineNumber}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.CodeComment}" />
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Copy}" TargetType="rune:CopyButton" BasedOn="{StaticResource {x:Type rune:CopyButton}}">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.Expand}" TargetType="rune:ButtonBase" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.SurfaceMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:CodeBlockParts.ExpandIcon}" TargetType="rune:Icon" BasedOn="{StaticResource {x:Type rune:Icon}}" />
</ResourceDictionary>
