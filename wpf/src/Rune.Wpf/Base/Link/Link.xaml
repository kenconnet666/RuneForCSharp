<!--
  Link 的主题样式（vue-tsx-pro 的 linkRecipe）：色调（默认 accent）与下划线（默认 always）是触发器；悬停下划线只在 hover 档；
  外链图标的部件样式（LinkParts.Icon）：末尾 0.1em 的间距
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Link">
    <Setter Property="Tone" Value="accent" />
    <Setter Property="Underline" Value="always" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="Tone" Value="neutral"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="Tone" Value="muted"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" /></Trigger>
      <Trigger Property="Tone" Value="accent"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Trigger>
      <Trigger Property="Tone" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /></Trigger>
      <Trigger Property="Tone" Value="success"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /></Trigger>
      <Trigger Property="Tone" Value="warning"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /></Trigger>
      <Trigger Property="Tone" Value="info"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /></Trigger>
      <Trigger Property="Underline" Value="always"><Setter Property="TextDecorations" Value="Underline" /></Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="Underline" Value="hover" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="TextDecorations" Value="Underline" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:LinkParts.Icon}" TargetType="rune:Icon">
    <Setter Property="Margin" Value="1,0,0,0" />
  </Style>
</ResourceDictionary>
