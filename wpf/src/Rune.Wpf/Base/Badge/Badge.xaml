<!--
  Badge 的主题样式：只放默认值（vue-tsx-pro 的 badgeRecipe.defaults 与 BadgeOptions 的默认），Provider 的样式能改。
  样式 × 色调的颜色是生成的 BadgeRecipe.g.xaml（与按钮同一张调色板表），字号档位是这里的触发器：都在主题这一层，使用方的样式盖得过。
  em 尺寸在 Badge.cs 里（自绘组件，不用模板，DESIGN §9）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Badge/BadgeRecipe.g.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Badge" BasedOn="{StaticResource Rune.Recipe.Badge}">
    <Setter Property="Variant" Value="soft" />
    <Setter Property="Tone" Value="neutral" />
    <Setter Property="Size" Value="xs" />
    <Setter Property="Radius" Value="sm" />
    <Setter Property="rune:EmSize.Padding" Value="0.5,0" />
    <!-- borderWidths.xs：没有描边色时也占位，各样式等高 -->
    <Setter Property="BorderThickness" Value="1" />
    <!-- 文字中等字重、行高 lineHeights.tight（vue-tsx-pro 的 badgeRecipe 的 root） -->
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <Style x:Key="{x:Static rune:BadgeParts.Icon}" TargetType="rune:Icon" />
  <!-- 圆点与文字同色 -->
  <Style x:Key="{x:Static rune:BadgeParts.Dot}" TargetType="Border">
    <Setter Property="Background" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=rune:Badge}}" />
  </Style>
  <!-- 标签：外观同 Badge（BasedOn 主题样式）；移除按钮的尺寸按字号在 Tag.cs 里算，部件样式默认是空的 -->
  <!-- 可选中（IsSelected 不是 null）：没写的色调 accent、字号 sm；没选中 surface，选中 solid、前面一个对勾（触发器：写了的照用） -->
  <Style TargetType="rune:Tag" BasedOn="{StaticResource {x:Type rune:Badge}}">
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="False">
        <Setter Property="Variant" Value="surface" />
        <Setter Property="Tone" Value="accent" />
        <Setter Property="Size" Value="sm" />
        <Setter Property="Cursor" Value="Hand" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Variant" Value="solid" />
        <Setter Property="Tone" Value="accent" />
        <Setter Property="Size" Value="sm" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Icon" Value="{x:Static rune:Lucide.Check}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:TagParts.Remove}" TargetType="rune:CloseButton" BasedOn="{StaticResource {x:Type rune:CloseButton}}" />
</ResourceDictionary>
