<!-- 由 tools/recipe-gen 按调色板表（tools/token-gen/palette.mjs）生成，不要手改；运行 node tools/recipe-gen/recipe-gen.mjs -->
<!-- Indicator 的色调（6 条）。组件的主题样式 BasedOn 它 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="Rune.Recipe.Indicator" TargetType="rune:Indicator">
    <Style.Triggers>
      <Trigger Property="Tone" Value="neutral"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.InverseSurface}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.InverseText}" /></Trigger>
      <Trigger Property="Tone" Value="accent"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.Accent}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.AccentContrast}" /></Trigger>
      <Trigger Property="Tone" Value="info"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.Info}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.InfoContrast}" /></Trigger>
      <Trigger Property="Tone" Value="success"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.Success}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.SuccessContrast}" /></Trigger>
      <Trigger Property="Tone" Value="warning"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.Warning}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.WarningContrast}" /></Trigger>
      <Trigger Property="Tone" Value="danger"><Setter Property="BadgeBackground" Value="{DynamicResource Rune.Brush.Danger}" /><Setter Property="BadgeForeground" Value="{DynamicResource Rune.Brush.DangerContrast}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
