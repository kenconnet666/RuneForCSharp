<!--
  Indicator 的主题样式：只放默认值（vue-tsx-pro 的 IndicatorOptions 与 indicatorRecipe 的默认档位），Provider 的样式能改。
  色调的颜色是生成的 IndicatorRecipe.g.xaml；角标的尺寸、位置在 Indicator.cs 里（代码组合的部件）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Indicator/IndicatorRecipe.g.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Indicator" BasedOn="{StaticResource Rune.Recipe.Indicator}">
    <Setter Property="Tone" Value="danger" />
    <Setter Property="Placement" Value="top-end" />
    <Setter Property="Overlap" Value="rectangular" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <!-- 部件的默认外观写在部件样式里（DESIGN §7），使用方同键的样式叠在上面，盖得过 -->
  <!-- 角标：色调的实底，外面一圈页面底色（borderWidths.sm）和被标记的元素分开 -->
  <Style x:Key="{x:Static rune:IndicatorParts.Badge}" TargetType="Border">
    <Setter Property="Background" Value="{Binding BadgeBackground, RelativeSource={RelativeSource AncestorType=rune:Indicator}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Background}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- 计数：对比色、半粗、等宽数字、居中 -->
  <Style x:Key="{x:Static rune:IndicatorParts.Count}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{Binding BadgeForeground, RelativeSource={RelativeSource AncestorType=rune:Indicator}}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
