<!--
  按钮家族的主题样式（vue-tsx-pro 的 ButtonBase 与 button-core）：
  - ButtonBase：没有外观，只有波纹层、内容、焦点环
  - Rune.ButtonCore（Button、IconButton 共用）：样式 × 色调的颜色在生成的 ButtonRecipe.g.xaml 里（BasedOn 它）；
    这里是共有的默认值、em 尺寸与状态。内部尺寸都是 em：内边距 1em × 0.25em、最小高度 max(2.25em, 24px)
  - Button、IconButton：BasedOn Rune.ButtonCore，只写自己的默认值与模板
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/ButtonRecipe.g.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style TargetType="rune:ButtonBase">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- 焦点环在模板里（只在键盘聚焦时，圆角跟着按钮），不用 WPF 的焦点虚线框 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:ButtonBase">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Border>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Rune.ButtonCore" TargetType="rune:ButtonCore" BasedOn="{StaticResource Rune.Recipe.Button}">
    <Setter Property="Radius" Value="md" />
    <Setter Property="rune:EmSize.Padding" Value="1,0.25" />
    <!-- 控件高度：字号的 2.25 倍（xs 档 2 倍）取整到 4px，不低于 24px（vue-tsx-pro 的 sizes.control） -->
    <Setter Property="rune:ControlHeight.MinHeight" Value="True" />
    <!-- borderWidths.xs：没有描边色时也占位，各样式等高 -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <!-- 界面文字用 medium：600 在微软雅黑上落成粗体（vue-tsx-pro 0.11 S4） -->
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- 一行里与别的控件居中对齐，不被拉高（链接样式没有最小高度，高度是行高加内边距） -->
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- 行高 lineHeights.tight（1.25em）：文字的行盒与 TS 一样高 -->
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <!-- 字号、圆角档位：主题样式的触发器，使用方任何样式都盖得过（DESIGN §4"档位的优先级"）；字号写成像素数时是本地值 -->
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
      <Trigger Property="Radius" Value="none"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.None}" /></Trigger>
      <Trigger Property="Radius" Value="xs"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Xs}" /></Trigger>
      <Trigger Property="Radius" Value="sm"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" /></Trigger>
      <Trigger Property="Radius" Value="md"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Md}" /></Trigger>
      <Trigger Property="Radius" Value="lg"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Lg}" /></Trigger>
      <Trigger Property="Radius" Value="xl"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Xl}" /></Trigger>
      <Trigger Property="Radius" Value="full"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Full}" /></Trigger>
      <!-- 链接样式：无底、左右内边距 0（上下 0.25em 保留）、最小高度 0（颜色在配方里，悬停下划线在代码里） -->
      <Trigger Property="Variant" Value="link">
        <Setter Property="rune:EmSize.Padding" Value="0,0.25" />
        <Setter Property="rune:ControlHeight.MinHeight" Value="False" />
      </Trigger>
      <!-- 不可用（含可聚焦的不可用）：变淡、光标是"禁止"；配方里的悬停色也只在可用时 -->
      <Trigger Property="IsDisabled" Value="True">
        <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
        <Setter Property="Cursor" Value="No" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:Button" BasedOn="{StaticResource Rune.ButtonCore}">
    <Setter Property="Variant" Value="solid" />
    <Setter Property="Tone" Value="accent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:Button">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <StackPanel x:Name="PART_Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}" Style="{DynamicResource {x:Static rune:ButtonParts.Content}}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <rune:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.Icon}}" />
                  <ContentPresenter x:Name="PART_ContentPresenter" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  <rune:Icon x:Name="PART_IconEnd" Data="{TemplateBinding IconEnd}" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.IconEnd}}" />
                </StackPanel>
                <rune:Spinner x:Name="PART_Spinner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.Spinner}}" />
              </Grid>
            </Border>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- 只切部件的可见性与透明度（模板里的元素只能在这里按名字设）；颜色、尺寸的状态都在 Style.Triggers 里 -->
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="ShowsSpinner" Value="True">
              <Setter TargetName="PART_Content" Property="Opacity" Value="0" />
              <Setter TargetName="PART_Spinner" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 图标按钮：宽高相等（宽度 = 最小高度 max(2.25em, 24px)，左右内边距 0），默认 ghost、中性色 -->
  <Style TargetType="rune:IconButton" BasedOn="{StaticResource Rune.ButtonCore}">
    <Setter Property="Variant" Value="ghost" />
    <Setter Property="Tone" Value="neutral" />
    <Setter Property="rune:EmSize.Padding" Value="0,0.25" />
    <Setter Property="rune:ControlHeight.Width" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:IconButton">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <StackPanel x:Name="PART_Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}" Style="{DynamicResource {x:Static rune:IconButtonParts.Content}}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <rune:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:IconButtonParts.Icon}}" />
                </StackPanel>
                <rune:Spinner x:Name="PART_Spinner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:IconButtonParts.Spinner}}" />
              </Grid>
            </Border>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="ShowsSpinner" Value="True">
              <Setter TargetName="PART_Content" Property="Opacity" Value="0" />
              <Setter TargetName="PART_Spinner" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 链接按钮：外观同 Button / IconButton；外部链接没写 IconEnd 时显示外链图标（本地值盖过样式触发器） -->
  <Style TargetType="rune:LinkButton" BasedOn="{StaticResource {x:Type rune:Button}}">
    <Style.Triggers>
      <Trigger Property="External" Value="True"><Setter Property="IconEnd" Value="{x:Static rune:Lucide.ArrowUpRight}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="rune:IconLinkButton" BasedOn="{StaticResource {x:Type rune:IconButton}}" />

  <!-- 预设的图标按钮：只换图标，读屏名称在代码里取语言包 -->
  <Style TargetType="rune:CloseButton" BasedOn="{StaticResource {x:Type rune:IconButton}}">
    <Setter Property="Icon" Value="{x:Static rune:Lucide.X}" />
  </Style>
  <Style TargetType="rune:ClearButton" BasedOn="{StaticResource {x:Type rune:IconButton}}">
    <Setter Property="Icon" Value="{x:Static rune:Lucide.CircleX}" />
  </Style>
</ResourceDictionary>
