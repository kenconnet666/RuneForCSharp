<!--
  Button 的主题样式（vue-tsx-pro 的 button-core）：样式 × 色调的颜色在生成的 ButtonRecipe.g.xaml 里（BasedOn 它）；
  这里是默认值、em 尺寸、模板与状态。内部尺寸都是 em：内边距 1em × 0.25em、最小高度 max(2.25em, 24px)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/ButtonRecipe.g.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style TargetType="rune:Button" BasedOn="{StaticResource Rune.Recipe.Button}">
    <Setter Property="Variant" Value="solid" />
    <Setter Property="Tone" Value="accent" />
    <Setter Property="Radius" Value="md" />
    <Setter Property="rune:EmSize.Padding" Value="1,0.25" />
    <Setter Property="rune:EmSize.MinHeight" Value="2.25" />
    <Setter Property="rune:EmSize.MinHeightFloor" Value="24" />
    <!-- borderWidths.xs：没有描边色时也占位，各样式等高 -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- 焦点环在模板里（只在键盘聚焦时，圆角跟着按钮），不用 WPF 的焦点虚线框 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:Button">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <StackPanel x:Name="PART_Content" Orientation="Horizontal" Margin="{TemplateBinding Padding}" Style="{DynamicResource {x:Static rune:ButtonParts.Content}}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <rune:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.Icon}}" />
                  <ContentPresenter x:Name="PART_ContentPresenter" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  <rune:Icon x:Name="PART_IconEnd" Data="{TemplateBinding IconEnd}" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.IconEnd}}" />
                </StackPanel>
                <rune:Spinner x:Name="PART_Spinner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:ButtonParts.Spinner}}" />
              </Grid>
            </Border>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <!-- 只切部件的可见性与透明度（模板里的元素只能在这里按名字设）；颜色、尺寸的状态都在 Style.Triggers 里 -->
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="ShowsSpinner" Value="True">
              <Setter TargetName="PART_Content" Property="Opacity" Value="0" />
              <Setter TargetName="PART_Spinner" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 链接样式：无底、无内边距、最小高度 0、字重 medium（颜色在配方里，悬停下划线在代码里） -->
      <Trigger Property="Variant" Value="link">
        <Setter Property="rune:EmSize.Padding" Value="0" />
        <Setter Property="rune:EmSize.MinHeight" Value="0" />
        <Setter Property="rune:EmSize.MinHeightFloor" Value="0" />
        <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
