<!-- Blockquote 的主题样式（vue-tsx-pro 的 blockquoteStyles.root）：起始边的竖线跟着 FlowDirection 镜像 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderStrong}" />
    <!-- borderWidths.md -->
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="rune:EmSize.Padding" Value="1,0.25,0,0.25" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:Blockquote">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <StackPanel>
              <ContentPresenter />
              <!-- 出处：小一号，和引用隔开 space.xs；书名、作者不用斜体 -->
              <StackPanel x:Name="PART_Source" Style="{DynamicResource {x:Static rune:BlockquoteParts.Source}}" Orientation="Horizontal" TextElement.FontSize="{DynamicResource Rune.FontSize.Sm}" Margin="0,4,0,0">
                <TextBlock Text="— " />
                <ContentPresenter Content="{TemplateBinding Source}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Source" Value="{x:Null}"><Setter TargetName="PART_Source" Property="Visibility" Value="Collapsed" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
