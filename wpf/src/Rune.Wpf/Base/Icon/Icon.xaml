<!-- Icon 的主题样式：线宽取 strokeWidths.md；色调对应 vue-tsx-pro 的 toneStyles（inherit 与不写一样，跟随外面的文字颜色） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Icon">
    <Setter Property="StrokeWidth" Value="{DynamicResource Rune.StrokeWidth.Md}" />
    <Style.Triggers>
      <Trigger Property="Tone" Value="neutral"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="Tone" Value="muted"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" /></Trigger>
      <Trigger Property="Tone" Value="accent"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Trigger>
      <Trigger Property="Tone" Value="danger"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.DangerText}" /></Trigger>
      <Trigger Property="Tone" Value="success"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.SuccessText}" /></Trigger>
      <Trigger Property="Tone" Value="warning"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.WarningText}" /></Trigger>
      <Trigger Property="Tone" Value="info"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.InfoText}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
