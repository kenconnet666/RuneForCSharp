<!--
  Table 单元格与标题的主题样式（vue-tsx-pro 的 tableRecipe、tablePartStyles）：单元格 text 颜色、行高 normal；表头 textMuted、sm、中等字重；
  表体、表尾里的行标题中等字重；表尾加粗。标题 textMuted、sm，上下 space.sm、左右 space.md。
  内边距（左右 space.md、上下按密度）、行底色与分隔线、外框在 Table.cs 里。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:TableCell">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:TableCell">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="SectionKind" Value="head">
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
        <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
      </Trigger>
      <Trigger Property="SectionKind" Value="foot">
        <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 表体里的行标题中等字重；表尾里的照表尾加粗 -->
  <Style TargetType="rune:TableHeaderCell" BasedOn="{StaticResource {x:Type rune:TableCell}}">
    <Style.Triggers>
      <Trigger Property="SectionKind" Value="body">
        <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:TableCaption">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="rune:EmSize.Padding" Value="0.75,0.5" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:TableCaption">
          <ContentPresenter Margin="{TemplateBinding Padding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
