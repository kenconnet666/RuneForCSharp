<!--
  Steps 的主题样式（vue-tsx-pro 的 stepsStyles、stepsStateStyles）：圆圈加粗；已完成品牌色底与边、accentContrast 字，当前品牌色边、accentText 字，
  未开始 border 边、次要色字，出错 danger 边、dangerSoft 底、dangerText 字；标题中等字重、说明次要色；可点回的步骤悬停时 fillHover 底。
  尺寸（直径、字号、间距、圆角、边框）按字号在 Steps.cs 里，连接线在 Steps 的 OnRender 里画。部件的默认外观写在部件样式里（DESIGN §7）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Static rune:StepsParts.List}" TargetType="rune:Grid" />
  <Style x:Key="{x:Static rune:StepsParts.Item}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:StepsParts.Text}" TargetType="StackPanel" />
  <Style x:Key="{x:Static rune:StepsParts.Indicator}" TargetType="Border">
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" />
    <Style.Triggers>
      <Trigger Property="rune:Steps.State" Value="complete">
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Accent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.AccentContrast}" />
      </Trigger>
      <Trigger Property="rune:Steps.State" Value="current">
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Accent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.AccentText}" />
      </Trigger>
      <Trigger Property="rune:Steps.State" Value="upcoming">
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
      </Trigger>
      <Trigger Property="rune:Steps.State" Value="error">
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.DangerSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.DangerText}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:StepsParts.Title}" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
  </Style>
  <Style x:Key="{x:Static rune:StepsParts.Description}" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <Style x:Key="{x:Static rune:StepsParts.Trigger}" TargetType="rune:ButtonBase" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.FillHover}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
