<!--
  Tab、TabPanel 的主题样式（vue-tsx-pro 的 tabsRecipe、tabPanelStyles）：标签中等字重，平时 textMuted、悬停与选中 text，控件高度、左右 space.md、sm 圆角；
  line 时底边留 2 像素的透明边（指示条画在列表上）并压住列表的分隔线（-1），竖排时在结束边；soft 时选中的标签 surface 底；不可用时半透明。
  可关闭时结束端给关闭按钮留出 1.25em，拖动中半透明。面板 sm 圆角，键盘聚焦时外面一圈焦点环。TabList 的分隔线、指示条与 soft 底色在 TabList.cs 里组合。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Tab" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="rune:ControlHeight.MinHeight" Value="True" />
    <Setter Property="rune:EmSize.Padding" Value="0.75,0" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Margin" Value="0,0,0,-1" />
    <!-- 同 ButtonBase 的模板，多一格关闭按钮：叠在结束端（不用另一层容器，标签仍是列表的直接子元素，指示条按它的位置对齐） -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:Tab">
          <Grid>
            <!-- 底色单独一层、铺到边框下面（CSS 的 background-clip: border-box）：WPF 的 Border 只在边框里面填底色，透明边框的实底按钮会窄一圈 -->
            <Border x:Name="PART_Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True" />
            <Border x:Name="PART_Root" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
            </Border>
            <ContentPresenter x:Name="PART_CloseHost" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="Orientation" Value="vertical">
        <Setter Property="BorderThickness" Value="0,0,2,0" />
        <Setter Property="Margin" Value="0,0,-1,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Trigger>
      <Trigger Property="Variant" Value="soft">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Variant" Value="soft" />
          <Condition Property="IsSelected" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
      </MultiTrigger>
      <!-- 可关闭：结束端给关闭按钮留出 1.25em -->
      <Trigger Property="IsClosable" Value="True"><Setter Property="rune:EmSize.Padding" Value="0.75,0,2,0" /></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter Property="Opacity" Value="0.6" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:TabPanel">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:TabPanel">
          <Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}" />
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" Margin="-4" BorderThickness="2" CornerRadius="4"
                    BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
