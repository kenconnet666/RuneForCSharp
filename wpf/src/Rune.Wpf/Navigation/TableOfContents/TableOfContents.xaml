<!--
  TableOfContents 的主题样式（vue-tsx-pro 的 tableOfContentsStyles）：目录链接 sm 字号、行高 snug、xs 圆角，平时 textMuted、悬停 text，当前节 accentText（悬停也是）；
  内边距（左边按级别缩进）在 TableOfContents.cs 里按字号算。部件：标题 sm、加粗、下面留 space.sm；列表左边一条 xs 宽的 border 细线；
  指示条 sm 宽、圆角、品牌色，盖住细线（往左挪一个细线宽）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Text/Text.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- 目录链接是 TableOfContents 自己建的：外观就写在部件样式里 -->
  <Style x:Key="{x:Static rune:TableOfContentsParts.Link}" TargetType="rune:TableOfContentsLink" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Snug}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Snug}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Xs}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Ripple" Value="False" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" /></Trigger>
      <Trigger Property="IsCurrent" Value="True"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- 部件的默认外观写在部件样式里（DESIGN §7）；标题替掉了 Text 的隐式样式，基于它。标题下面的 space.sm 在 TableOfContents.cs 里按字号算 -->
  <Style x:Key="{x:Static rune:TableOfContentsParts.Title}" TargetType="rune:Text" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
  </Style>
  <Style x:Key="{x:Static rune:TableOfContentsParts.List}" TargetType="Border">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
  </Style>
  <Style x:Key="{x:Static rune:TableOfContentsParts.Indicator}" TargetType="Border">
    <Setter Property="Width" Value="2" />
    <Setter Property="Margin" Value="-1,0,0,0" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Accent}" />
  </Style>
</ResourceDictionary>
