<!--
  Breadcrumbs 的主题样式（vue-tsx-pro 的 breadcrumbsStyles）：整条 sm 字号；当前页正文色、中等字重；分隔符次要色。
  链接是次要色、悬停下划线（Breadcrumbs.cs 里写在 Link 上），折叠按钮 sm。部件的默认外观写在部件样式里（DESIGN §7）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Icon/Icon.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Link/Link.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Breadcrumbs">
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
  </Style>
  <Style x:Key="{x:Static rune:BreadcrumbsParts.List}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Item}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.CollapsedItem}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Link}" TargetType="rune:Link" BasedOn="{StaticResource {x:Type rune:Link}}" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Button}" TargetType="rune:Button" BasedOn="{StaticResource {x:Type rune:Button}}" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Menu}" TargetType="rune:Menu" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Label}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Current}" TargetType="Border">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
  </Style>
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Separator}" TargetType="rune:Icon" BasedOn="{StaticResource {x:Type rune:Icon}}">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <Style x:Key="{x:Static rune:BreadcrumbsParts.Expand}" TargetType="rune:IconButton" BasedOn="{StaticResource {x:Type rune:IconButton}}" />
</ResourceDictionary>
