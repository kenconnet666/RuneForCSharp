<!--
  NavList 的主题样式（vue-tsx-pro 的 itemStyles.row、navListStyles）：导航行控件高度、上下 space.xs、左右 space.md、md 圆角、图标与文字隔 space.sm，
  中等字重、行高 normal，平时 textMuted，悬停 text 与 fillHover 底；当前页 accentSoft 底（悬停 accentSoftHover）、accentText；不可用时半透明、没有悬停底色。
  只剩图标时居中、左右不留内边距，文字与尾部内容隐藏（名称留给读屏与提示）。分组标题的箭头在 NavList.cs 里显示、转动。
  小节标题：文字 sm、中等字重、text 颜色（WPF 的 TextBlock 没有字距，wide 的 0.02em 不做），图标 textMuted；紧凑时上面一条 borderMuted 的细线。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Text/Text.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="Rune.NavRow" TargetType="rune:NavRow" BasedOn="{StaticResource {x:Type rune:ButtonBase}}">
    <Setter Property="rune:ControlHeight.MinHeight" Value="True" />
    <Setter Property="rune:EmSize.Padding" Value="0.75,0.25" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="rune:EmSize.LineHeight" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:NavRow">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" rune:BrushTransition.Enabled="True">
              <Grid>
                <Canvas x:Name="PART_Ripples" IsHitTestVisible="False" />
                <rune:Flex x:Name="PART_Row" Align="center" Gap="sm" Margin="{TemplateBinding Padding}">
                  <rune:Indicator x:Name="PART_Indicator" VerticalAlignment="Center">
                    <rune:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" Style="{DynamicResource {x:Static rune:NavRowParts.Icon}}" />
                  </rune:Indicator>
                  <ContentPresenter x:Name="PART_Label" rune:Flex.Grow="True" VerticalAlignment="Center" Style="{DynamicResource {x:Static rune:NavRowParts.Label}}">
                    <ContentPresenter.Resources>
                      <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                  <ContentPresenter x:Name="PART_End" Content="{TemplateBinding End}" VerticalAlignment="Center" />
                  <rune:Badge x:Name="PART_Badge" Size="xs" Variant="solid" Radius="full" Visibility="Collapsed" />
                  <rune:Icon x:Name="PART_Chevron" Data="{x:Static rune:Lucide.ChevronRight}" Visibility="Collapsed" />
                </rune:Flex>
              </Grid>
            </Border>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" BorderBrush="{DynamicResource Rune.Brush.FocusRing}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocusVisible" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="IsIconOnly" Value="True">
              <Setter TargetName="PART_Row" Property="Justify" Value="center" />
              <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_End" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 只剩图标：左右不留内边距，图标居中（navListStateStyles.compactRow） -->
      <Trigger Property="IsIconOnly" Value="True"><Setter Property="rune:EmSize.Padding" Value="0,0.25" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.FillHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
      </Trigger>
      <Trigger Property="IsCurrent" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsCurrent" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.AccentSoftHover}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
        <Setter Property="Background" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="rune:NavItem" BasedOn="{StaticResource Rune.NavRow}" />
  <Style TargetType="rune:NavGroupHeader" BasedOn="{StaticResource Rune.NavRow}" />

  <!-- 部件的默认外观写在部件样式里（DESIGN §7）；替掉隐式样式的部件基于它 -->
  <Style x:Key="{x:Static rune:NavRowParts.Icon}" TargetType="rune:Icon" />
  <Style x:Key="{x:Static rune:NavRowParts.Label}" TargetType="ContentPresenter" />
  <Style x:Key="{x:Static rune:NavGroupParts.Trigger}" TargetType="rune:NavGroupHeader" BasedOn="{StaticResource Rune.NavRow}" />
  <Style x:Key="{x:Static rune:NavGroupParts.Content}" TargetType="rune:Collapse" />
  <Style x:Key="{x:Static rune:NavGroupParts.List}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:NavSectionParts.List}" TargetType="rune:Flex" />
  <Style x:Key="{x:Static rune:NavSectionParts.Label}" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
  </Style>
  <Style x:Key="{x:Static rune:NavSectionParts.Icon}" TargetType="rune:Icon">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>
  <!-- 部件样式替掉了 Text 的隐式样式：基于它，行高照样按块 -->
  <Style x:Key="{x:Static rune:NavSectionParts.Text}" TargetType="rune:Text" BasedOn="{StaticResource {x:Type rune:Text}}">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
  </Style>
</ResourceDictionary>
