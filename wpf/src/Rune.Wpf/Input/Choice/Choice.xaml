<!--
  勾选类控件（Switch、Checkbox、Radio）与复选组、单选组的主题样式（vue-tsx-pro 的 choiceRecipe 的 root、label、description、group 与 defaults）：
  整块可点，正文色、行高 normal，字号档位是触发器；不可用时整体变淡，只读时不像能点；Switch、Checkbox、RadioGroup 的色调默认 accent。
  文字顶端对齐，说明是 muted（0.875em 在代码里按字号给）。组竖排时 gap xs，横排时换行、列距 lg、行距 xs。
  共用的设置写在 Rune.ChoiceStyle 里，各组件的主题样式 BasedOn 它（同一个文件里 StaticResource 才找得到）。控件部件的外观在各组件的 xaml
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="Rune.ChoiceStyle" TargetType="rune:ChoiceBase">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Normal}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- 焦点环是部件，不用 WPF 的焦点虚线框 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsEffectivelyReadOnly" Value="True"><Setter Property="Cursor" Value="Arrow" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:Switch" BasedOn="{StaticResource Rune.ChoiceStyle}">
    <Setter Property="Tone" Value="accent" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:Checkbox" BasedOn="{StaticResource Rune.ChoiceStyle}">
    <Setter Property="Tone" Value="accent" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:Radio" BasedOn="{StaticResource Rune.ChoiceStyle}" />

  <Style x:Key="{x:Static rune:ChoiceBaseParts.Label}" TargetType="ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="{x:Static rune:ChoiceBaseParts.Description}" TargetType="ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
  </Style>

  <Style x:Key="Rune.ChoiceGroupStyle" TargetType="rune:ChoiceGroup">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:ChoiceGroup">
          <ItemsPresenter Margin="{TemplateBinding Padding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <rune:Flex Direction="column" Gap="xs" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <rune:Flex Wrap="True" ColumnGap="lg" RowGap="xs" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:CheckboxGroup" BasedOn="{StaticResource Rune.ChoiceGroupStyle}" />

  <Style TargetType="rune:RadioGroup" BasedOn="{StaticResource Rune.ChoiceGroupStyle}">
    <Setter Property="Tone" Value="accent" />
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Size" Value="xxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxl}" /></Trigger>
      <Trigger Property="Size" Value="xxxl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xxxl}" /></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
