<!--
  NativeSelect 的主题样式（vue-tsx-pro 的 controlParts、nativeSelectStyles）：外壳同输入框（同 Select：控件高度、左右 space.md、xs 宽的 border 描边、悬停 borderStrong、
  md 圆角、surface 底；soft 时 fill 底、没有描边；只读 borderMuted 描边、fill 底；出错 danger；不可用半透明；聚焦时焦点环压住边框），指针是手形。
  里面依次是前置图标、选中的文字（没选时是 textMuted 的占位文字）、下拉箭头（打开时翻转）。弹出的列表是平台 ComboBox 的弹出层：
  面板 surfaceRaised、xs 描边、md 圆角（按字号在 NativeSelect.cs 里算），lg 阴影画在后面一层，里面留 space.xs；
  选项一行（上下 space.xs、左右 space.sm、sm 圆角），悬停 fillHover、已选 accentText、不可用半透明。分组标题 sm、textMuted、medium，组里的选项缩进一档。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:NativeSelectItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="rune:EmSize.Padding" Value="0.5,0.25" />
    <Setter Property="rune:ControlHeight.MinHeight" Value="True" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:NativeSelectItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Rune.Brush.FillHover}" /></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Rune.Brush.AccentText}" /></Trigger>
      <!-- 组里的选项缩进一档 -->
      <Trigger Property="Row" Value="Grouped"><Setter Property="rune:EmSize.Padding" Value="1.25,0.25,0.5,0.25" /></Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <Trigger Property="Row" Value="Group">
        <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
        <Setter Property="FontWeight" Value="{DynamicResource Rune.FontWeight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="rune:ControlHeight.MinHeight" Value="False" />
        <Setter Property="rune:EmSize.Padding" Value="0.5,0.5,0.5,0.25" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="rune:NativeSelect">
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="rune:EmSize.Padding" Value="0.75,0" />
    <Setter Property="rune:ControlHeight.MinHeight" Value="True" />
    <Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Md}" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rune:NativeSelect">
          <Grid>
            <Border x:Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <rune:Flex Align="center" Gap="sm">
                <rune:Icon x:Name="PART_Icon" Data="{TemplateBinding Icon}" Foreground="{DynamicResource Rune.Brush.TextMuted}" />
                <Grid rune:Flex.Grow="True" VerticalAlignment="Center">
                  <TextBlock x:Name="PART_Placeholder" Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource Rune.Brush.TextMuted}"
                             TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                  <ContentPresenter x:Name="PART_Value" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                </Grid>
                <rune:Icon x:Name="PART_Chevron" Data="{x:Static rune:Lucide.ChevronDown}" Foreground="{DynamicResource Rune.Brush.TextMuted}" RenderTransformOrigin="0.5,0.5" />
              </rune:Flex>
            </Border>
            <!-- 平台的 ComboBox 不在自己身上处理点击打开：整块盖一个透明的开关 -->
            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="PART_FocusRing" Visibility="Collapsed" IsHitTestVisible="False" Margin="-1" BorderThickness="2"
                    BorderBrush="{DynamicResource Rune.Brush.FocusRing}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" Focusable="False"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   PopupAnimation="None">
              <!-- 外面留出阴影的位置；阴影画在面板后面一层（DropShadowEffect 不放在面板上：面板里的文字不走软件渲染） -->
              <Grid Margin="8,6,8,12" MinWidth="{Binding ActualWidth, ElementName=PART_Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border x:Name="PART_PopoverShadow" Background="{DynamicResource Rune.Brush.SurfaceRaised}" Effect="{DynamicResource Rune.Shadow.Lg}" />
                <Border x:Name="PART_Popover" Background="{DynamicResource Rune.Brush.SurfaceRaised}" BorderBrush="{DynamicResource Rune.Brush.Border}" BorderThickness="1"
                        TextElement.Foreground="{DynamicResource Rune.Brush.Text}">
                  <rune:ScrollArea>
                    <ItemsPresenter x:Name="PART_Items" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </rune:ScrollArea>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="ShowsPlaceholder" Value="True"><Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="PART_Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="ShowsReadOnly" Value="True"><Setter TargetName="PART_Toggle" Property="IsHitTestVisible" Value="False" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="ShowsInvalid" Value="True"><Setter TargetName="PART_FocusRing" Property="BorderBrush" Value="{DynamicResource Rune.Brush.Danger}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Size" Value="xs"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xs}" /></Trigger>
      <Trigger Property="Size" Value="sm"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" /></Trigger>
      <Trigger Property="Size" Value="md"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Md}" /></Trigger>
      <Trigger Property="Size" Value="lg"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Lg}" /></Trigger>
      <Trigger Property="Size" Value="xl"><Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Xl}" /></Trigger>
      <Trigger Property="Radius" Value="none"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.None}" /></Trigger>
      <Trigger Property="Radius" Value="xs"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Xs}" /></Trigger>
      <Trigger Property="Radius" Value="sm"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Sm}" /></Trigger>
      <Trigger Property="Radius" Value="lg"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Lg}" /></Trigger>
      <Trigger Property="Radius" Value="xl"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Xl}" /></Trigger>
      <Trigger Property="Radius" Value="full"><Setter Property="rune:EmSize.CornerRadius" Value="{DynamicResource Rune.Radius.Full}" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderStrong}" /></Trigger>
      <Trigger Property="Variant" Value="soft">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="Variant" Value="soft" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.FillHover}" />
      </MultiTrigger>
      <Trigger Property="ShowsReadOnly" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.BorderMuted}" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Fill}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <Trigger Property="ShowsInvalid" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Danger}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="{DynamicResource Rune.Opacity.Disabled}" />
        <Setter Property="Cursor" Value="No" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
