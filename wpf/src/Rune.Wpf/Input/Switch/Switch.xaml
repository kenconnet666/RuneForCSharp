<!--
  Switch 的部件样式（主题样式与外层在 Input/Choice/Choice.xaml）。
  部件的默认外观写在部件样式里（switchStyles 与 choiceInputStyles；使用方同键的样式叠在上面，DESIGN §7），随状态变的用祖先绑定的 DataTrigger：
  关时轨道是 borderStrong、滑块是页面底色加小阴影；开时轨道是色调实底（ToneFill）、滑块是其上的颜色（ToneOnFill）；出错时轨道描边是危险色。
  轨道里的文字 fontSizes.xs、半粗，只显示当前状态那份，所以颜色只看是否打开：开时是实底上的颜色，关时是正文色
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style x:Key="{x:Static rune:SwitchParts.Control}" TargetType="Panel" />

  <Style x:Key="{x:Static rune:SwitchParts.Track}" TargetType="Border">
    <!-- TS 的轨道有 2px 透明描边、底色铺在描边下面；WPF 的 Border 底色只铺在描边里面，且同色的底与描边接缝处有一道浅线，
         所以平时不要描边，出错时才有 2px 的危险色描边（外沿大小不变） -->
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=rune:Switch}}" Value="True">
        <Setter Property="Background" Value="{Binding ToneFill, RelativeSource={RelativeSource AncestorType=rune:Switch}}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsInvalid, RelativeSource={RelativeSource AncestorType=rune:Switch}}" Value="True">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Danger}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 焦点环：键盘聚焦时贴着轨道（focusRingStyles.tight） -->
  <Style x:Key="{x:Static rune:SwitchParts.FocusRing}" TargetType="Border">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.FocusRing}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFocusVisible, RelativeSource={RelativeSource AncestorType=rune:Switch}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static rune:SwitchParts.Thumb}" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.Background}" />
    <!-- 上游是 shadows.sm（几层紧贴的阴影）；WPF 的 Sm 是给卡片用的一整片软阴影（blur 16），放在 0.875em 的滑块上成了光晕，所以用 Xs -->
    <Setter Property="Effect" Value="{DynamicResource Rune.Shadow.Xs}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=rune:Switch}}" Value="True">
        <Setter Property="Background" Value="{Binding ToneOnFill, RelativeSource={RelativeSource AncestorType=rune:Switch}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static rune:SwitchParts.Spinner}" TargetType="rune:Spinner">
    <Setter Property="Foreground" Value="{Binding ToneFill, RelativeSource={RelativeSource AncestorType=rune:Switch}}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="{x:Static rune:SwitchParts.Content}" TargetType="Border">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rune.Brush.Text}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=rune:Switch}}" Value="True">
        <Setter Property="TextElement.Foreground" Value="{Binding ToneOnFill, RelativeSource={RelativeSource AncestorType=rune:Switch}}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static rune:SwitchParts.ContentText}" TargetType="ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Rune.FontSize.Xs}" />
    <Setter Property="TextElement.FontWeight" Value="{DynamicResource Rune.FontWeight.Semibold}" />
  </Style>

</ResourceDictionary>
