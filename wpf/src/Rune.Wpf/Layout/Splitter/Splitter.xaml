<!--
  Splitter 的主题样式（vue-tsx-pro 的 splitterStyles）：Bordered 时表面色、边框色（粗细与圆角在代码里按字号算）。
  部件的默认外观写在部件样式里（DESIGN §7）：收起按钮叠在分隔线上，要不透明的底遮住线（surface）；
  悬停换成同样不透明的 fillHover（描边按钮自己的悬停色是半透明的，会透出线）。触发器排在 IconButton 的配方后面，同条件时优先
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Rune.Wpf;component/Base/Button/Button.xaml" />
    <ResourceDictionary Source="/Rune.Wpf;component/Layout/ScrollArea/ScrollArea.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="rune:Splitter">
    <Style.Triggers>
      <Trigger Property="Bordered" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static rune:SplitterParts.Start}" TargetType="rune:ScrollArea" BasedOn="{StaticResource {x:Type rune:ScrollArea}}" />
  <Style x:Key="{x:Static rune:SplitterParts.End}" TargetType="rune:ScrollArea" BasedOn="{StaticResource {x:Type rune:ScrollArea}}" />
  <Style x:Key="{x:Static rune:SplitterParts.Handle}" TargetType="rune:SplitterHandle" />
  <Style x:Key="{x:Static rune:SplitterParts.Toggle}" TargetType="rune:IconButton" BasedOn="{StaticResource {x:Type rune:IconButton}}">
    <Style.Triggers>
      <Trigger Property="Variant" Value="outline">
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.FillHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
