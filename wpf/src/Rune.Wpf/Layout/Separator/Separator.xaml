<!--
  Separator 的主题样式（vue-tsx-pro 的 separatorStyles）：线色 borderMuted、线宽 borderWidths.xs；带文字时文字是次要文字色、行高 tight。
  竖线在 Flex 里随行高拉伸（align-self: stretch），在其他面板里竖向拉伸
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rune="clr-namespace:Rune.Wpf">
  <Style TargetType="rune:Separator">
    <Setter Property="Background" Value="{DynamicResource Rune.Brush.BorderMuted}" />
    <Setter Property="Thickness" Value="{DynamicResource Rune.BorderWidth.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
    <Setter Property="rune:Leading.Factor" Value="{DynamicResource Rune.LineHeight.Tight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="vertical">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="rune:Flex.AlignSelf" Value="stretch" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 部件样式键总要有一个样式（同 SpinnerParts.Icon），使用方同键的样式叠在上面 -->
  <Style x:Key="{x:Static rune:SeparatorParts.Label}" TargetType="rune:Text" />
  <Style x:Key="{x:Static rune:SeparatorParts.Line}" TargetType="Border" />
</ResourceDictionary>
