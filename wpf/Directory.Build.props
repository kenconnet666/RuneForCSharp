<Project>
  <!-- WPF 组件库（src）、示例（apps）、测试（tests）共用：先导入仓库根的设置，再改成 Windows 目标 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
</Project>
