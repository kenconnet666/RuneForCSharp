<Window x:Class="Rune.Wpf.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf"
        Title="Rune.Wpf 组件示例" Width="1200" Height="800"
        Background="{DynamicResource Rune.Brush.Background}"
        TextElement.Foreground="{DynamicResource Rune.Brush.Text}"
        TextElement.FontSize="{DynamicResource Rune.FontSize.Md}"
        TextElement.FontFamily="{DynamicResource Rune.Font.Sans}">
  <!-- 左侧：主题与示例列表（Examples 项目的登记表，inspect 用同一张）；右侧：选中的示例。组件做出来后换成组件库自己的导航 -->
  <rune:Provider>
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="260" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Rune.Brush.Border}">
        <DockPanel>
          <ComboBox x:Name="Themes" DockPanel.Dock="Top" Margin="12" DisplayMemberPath="Label" />
          <ListBox x:Name="ExampleList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Rune.Brush.Text}" />
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
          <TextBlock x:Name="ExampleTitle" FontSize="{DynamicResource Rune.FontSize.Xxl}" FontWeight="SemiBold" />
          <TextBlock x:Name="ExampleDescription" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Rune.Brush.TextMuted}" />
          <ContentControl x:Name="Stage" Margin="0,24,0,0" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </rune:Provider>
</Window>
