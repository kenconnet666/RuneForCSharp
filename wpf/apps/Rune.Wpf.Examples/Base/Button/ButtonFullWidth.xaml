<UserControl x:Class="Rune.Wpf.Examples.ButtonFullWidth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <StackPanel>
    <rune:Button FullWidth="True" Size="lg" Icon="{x:Static rune:Lucide.LogIn}">登录</rune:Button>
    <rune:Small Tone="muted" Align="Center" Margin="0,8">或者</rune:Small>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <rune:Button FullWidth="True" Variant="surface" Tone="neutral" Icon="{x:Static rune:Lucide.Smartphone}">手机验证码</rune:Button>
      <rune:Button Grid.Column="2" FullWidth="True" Variant="surface" Tone="neutral" Icon="{x:Static rune:Lucide.Mail}">邮箱验证码</rune:Button>
    </Grid>
    <rune:Button FullWidth="True" Variant="link" Tone="neutral" Margin="0,8,0,0">忘记密码？</rune:Button>
  </StackPanel>
</UserControl>
