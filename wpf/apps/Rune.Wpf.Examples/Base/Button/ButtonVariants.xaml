<UserControl x:Class="Rune.Wpf.Examples.ButtonVariants"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <UserControl.Resources>
    <Style TargetType="rune:Button"><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Resources>
  <WrapPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="solid" HorizontalAlignment="Left">solid</rune:Button><rune:Small Tone="muted" Text="主要操作，每组最多一个" /></StackPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="soft" HorizontalAlignment="Left">soft</rune:Button><rune:Small Tone="muted" Text="需要突出的次要操作" /></StackPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="surface" HorizontalAlignment="Left">surface</rune:Button><rune:Small Tone="muted" Text="表单、设置页里的次要操作" /></StackPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="outline" HorizontalAlignment="Left">outline</rune:Button><rune:Small Tone="muted" Text="次要操作" /></StackPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="ghost" HorizontalAlignment="Left">ghost</rune:Button><rune:Small Tone="muted" Text="工具栏、行内操作" /></StackPanel>
    <StackPanel Width="160" Margin="0,0,16,16"><rune:Button Variant="link" HorizontalAlignment="Left">link</rune:Button><rune:Small Tone="muted" Text="句子中间的操作" /></StackPanel>
  </WrapPanel>
</UserControl>
