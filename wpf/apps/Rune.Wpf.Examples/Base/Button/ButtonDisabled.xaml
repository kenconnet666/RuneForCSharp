<UserControl x:Class="Rune.Wpf.Examples.ButtonDisabled"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <UserControl.Resources>
    <Style TargetType="rune:Button"><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Resources>
  <!-- Tooltip 做出来后补上第二行：不可用但能聚焦（focusableWhenDisabled），悬停说明为什么不能点 -->
  <StackPanel>
    <WrapPanel><rune:Button Variant="solid" IsEnabled="False">solid</rune:Button><rune:Button Variant="soft" IsEnabled="False">soft</rune:Button><rune:Button Variant="surface" IsEnabled="False">surface</rune:Button><rune:Button Variant="outline" IsEnabled="False">outline</rune:Button><rune:Button Variant="ghost" IsEnabled="False">ghost</rune:Button><rune:Button Variant="link" IsEnabled="False">link</rune:Button></WrapPanel>
  </StackPanel>
</UserControl>
