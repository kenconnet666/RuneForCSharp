<UserControl x:Class="Rune.Wpf.Examples.ButtonLinks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <!-- 桌面没有站内地址，链接都是绝对地址，用系统打开 -->
  <rune:Card>
    <rune:Flex Direction="column" Gap="md">
      <rune:Flex Direction="column" Gap="xs">
        <rune:Strong>还没有订单</rune:Strong>
        <rune:Paragraph Size="sm" Tone="muted">新建第一张订单，或者先看看怎么批量导入。</rune:Paragraph>
      </rune:Flex>
      <rune:Flex Gap="sm" Wrap="True">
        <rune:LinkButton Href="https://example.com/orders/new" Icon="{x:Static rune:Lucide.Plus}">新建订单</rune:LinkButton>
        <rune:LinkButton Href="https://example.com/guide/import" Variant="soft" Icon="{x:Static rune:Lucide.BookOpen}">导入指南</rune:LinkButton>
        <rune:LinkButton Href="https://vuejs.org" External="True" Variant="ghost" IconEnd="{x:Static rune:Lucide.ArrowRight}">Vue 文档</rune:LinkButton>
      </rune:Flex>
    </rune:Flex>
  </rune:Card>
</UserControl>
