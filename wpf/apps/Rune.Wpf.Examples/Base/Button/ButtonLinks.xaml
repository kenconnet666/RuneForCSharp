<UserControl x:Class="Rune.Wpf.Examples.ButtonLinks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <!-- 桌面没有站内地址，链接都是绝对地址，用系统打开 -->
  <rune:Card>
    <rune:Flex Direction="column" Gap="md">
      <rune:Flex Direction="column" Gap="xs">
        <rune:Strong>还没有订单</rune:Strong>
        <rune:Paragraph Size="sm" Tone="muted">新建第一张订单，或者先看看怎么批量导入。</rune:Paragraph>
      </rune:Flex>
      <rune:Flex Gap="sm" Wrap="True">
        <rune:LinkButton Href="https://example.com/orders/new" Icon="{x:Static rune:Lucide.Plus}">新建订单</rune:LinkButton>
        <rune:LinkButton Href="https://example.com/guide/import" Variant="soft" Icon="{x:Static rune:Lucide.BookOpen}">导入指南</rune:LinkButton>
        <rune:LinkButton Href="https://vuejs.org" External="True" Variant="ghost" IconEnd="{x:Static rune:Lucide.ArrowRight}">Vue 文档</rune:LinkButton>
      </rune:Flex>
      <rune:Separator />
      <!-- 页脚：只有图标的链接用 IconLinkButton -->
      <rune:Flex Align="center" Justify="between" Gap="md" Wrap="True">
        <rune:Small Tone="muted">© 2026 vue-tsx-pro</rune:Small>
        <rune:Flex Gap="xs">
          <rune:IconLinkButton Href="https://example.com/guide/getting-started" Icon="{x:Static rune:Lucide.BookOpen}" AutomationProperties.Name="文档" />
          <rune:IconLinkButton Href="https://example.com/feed.xml" External="True" Icon="{x:Static rune:Lucide.Rss}" AutomationProperties.Name="订阅" />
          <rune:IconLinkButton Href="https://youtube.com" External="True" Icon="{x:Static rune:Lucide.Video}" AutomationProperties.Name="视频教程" />
          <rune:IconLinkButton Href="mailto:hi@example.com" Icon="{x:Static rune:Lucide.Mail}" AutomationProperties.Name="发邮件" />
        </rune:Flex>
      </rune:Flex>
    </rune:Flex>
  </rune:Card>
</UserControl>
