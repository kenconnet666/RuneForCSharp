<UserControl x:Class="Rune.Wpf.Examples.ButtonLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <UserControl.Resources>
    <Style TargetType="rune:Button"><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  </UserControl.Resources>
  <!-- 点击后加载 1.5 秒；很快完成的加载不出现旋转指示（DelayedLoading），宽度始终不变 -->
  <WrapPanel>
    <rune:Button x:Name="Save" Icon="{x:Static rune:Lucide.Save}">保存</rune:Button>
    <rune:Button x:Name="Quick" Variant="outline">很快完成（0.1 秒）</rune:Button>
    <rune:Button IsLoading="True" Variant="soft">一直在加载</rune:Button>
  </WrapPanel>
</UserControl>
