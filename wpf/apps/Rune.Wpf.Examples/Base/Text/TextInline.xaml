<UserControl x:Class="Rune.Wpf.Examples.TextInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <!-- Code、Mark、Sub、Sup、Strike、Del、Ins 是行内文字（跟着段落换行），Kbd 是控件、放进 InlineUIContainer；段落里的加粗、斜体、小字用行内的 Span -->
  <StackPanel>
    <rune:Paragraph Margin="0,0,0,16">在任意页面按 <InlineUIContainer BaselineAlignment="Center"><rune:Kbd>Ctrl</rune:Kbd></InlineUIContainer> + <InlineUIContainer BaselineAlignment="Center"><rune:Kbd>K</rune:Kbd></InlineUIContainer> 打开搜索，输入 <rune:Code>button</rune:Code> 就能找到<rune:Mark>Button 按钮</rune:Mark>与它的全部示例。<Span FontWeight="{DynamicResource Rune.FontWeight.Semibold}">Strong</Span> 表示重要，<Italic>Em</Italic> 表示语气上的强调，<Span FontSize="{DynamicResource Rune.FontSize.Xs}">Small 用于附注与版权信息</Span>。</rune:Paragraph>
    <rune:Paragraph Margin="0,0,0,16">仓库面积 860 m<rune:Sup>2</rune:Sup>，冷却液的主要成分是 H<rune:Sub>2</rune:Sub>O；<InlineUIContainer BaselineAlignment="Baseline"><rune:Abbr Title="服务等级协议">SLA</rune:Abbr></InlineUIContainer> 承诺可用率 99.9%。会员价 <rune:Strike Foreground="{DynamicResource Rune.Brush.TextMuted}">¥199</rune:Strike> ¥149。交期从 <rune:Del>10 月 20 日</rune:Del> 改到 <rune:Ins>11 月 5 日</rune:Ins>。</rune:Paragraph>
    <rune:Blockquote Source="Vue 文档">
      <rune:Paragraph>渐进式框架：可以只在页面的一小块里用它，也可以用它搭建完整的单页应用。</rune:Paragraph>
    </rune:Blockquote>
  </StackPanel>
</UserControl>
