<UserControl x:Class="Rune.Wpf.Examples.TextOverflow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf"
             xmlns:local="clr-namespace:Rune.Wpf.Examples">
  <rune:Grid MinItemWidth="18em" Balanced="True" Gap="md">
    <rune:Card>
      <rune:Flex Direction="column" Gap="xs">
        <rune:Small Tone="muted">Truncate：单行省略</rune:Small>
        <rune:Strong Truncate="True">vue-tsx-pro / packages / ui / src / display / VirtualList.tsx</rune:Strong>
        <rune:Text Truncate="True" Tone="muted" Text="{x:Static local:TextOverflow.Long}" />
      </rune:Flex>
    </rune:Card>
    <rune:Card>
      <rune:Flex Direction="column" Gap="xs">
        <rune:Small Tone="muted">LineClamp="2"：最多两行</rune:Small>
        <rune:Paragraph LineClamp="2" Text="{x:Static local:TextOverflow.Long}" />
      </rune:Flex>
    </rune:Card>
    <rune:Card>
      <rune:Flex Direction="column" Gap="xs">
        <rune:Small Tone="muted">Wrap="Balance"：桌面上同普通换行</rune:Small>
        <rune:Paragraph Wrap="Balance" Size="lg" Weight="semibold" Align="Center">用更自然的 TSX 写 Vue 组件，符文让状态读写像普通变量</rune:Paragraph>
      </rune:Flex>
    </rune:Card>
  </rune:Grid>
</UserControl>
