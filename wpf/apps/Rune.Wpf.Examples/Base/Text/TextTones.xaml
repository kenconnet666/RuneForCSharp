<UserControl x:Class="Rune.Wpf.Examples.TextTones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <!-- 三张卡片；Card 做出来后换成 rune:Card -->
  <WrapPanel>
    <WrapPanel.Resources>
      <Style TargetType="Border">
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
      </Style>
    </WrapPanel.Resources>
    <Border>
      <StackPanel>
        <rune:Strong Text="部署完成" Margin="0,0,0,4" />
        <rune:Text Size="sm" Tone="muted" Text="production · 3 分钟前 · 由 @lin 触发" Margin="0,0,0,4" />
        <rune:Text Size="sm" Tone="success" Text="全部 128 项检查通过" />
      </StackPanel>
    </Border>
    <Border>
      <StackPanel>
        <rune:Strong Text="账单即将到期" Margin="0,0,0,4" />
        <rune:Text Size="sm" Tone="warning" Text="还有 2 天自动续费 ¥299" Margin="0,0,0,4" />
        <rune:Text Size="sm" Tone="accent" Text="查看账单详情" />
      </StackPanel>
    </Border>
    <Border>
      <StackPanel>
        <rune:Strong Text="同步失败" Margin="0,0,0,4" />
        <rune:Text Size="sm" Tone="danger" Text="网络连接中断，已暂停上传" Margin="0,0,0,4" />
        <rune:Paragraph Size="sm" Tone="info" Text="恢复联网后会自动重试，不用重新选择文件。" />
      </StackPanel>
    </Border>
  </WrapPanel>
</UserControl>
