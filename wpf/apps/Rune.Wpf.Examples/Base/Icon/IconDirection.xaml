<UserControl x:Class="Rune.Wpf.Examples.IconDirection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <!-- 两张卡片各设 FlowDirection：有方向的图标（箭头、chevron）设 FlipInRtl，时钟、勾号不翻。Card 做出来后换成 rune:Card -->
  <WrapPanel>
    <WrapPanel.Resources>
      <Style TargetType="Border">
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rune.Brush.Border}" />
        <Setter Property="Background" Value="{DynamicResource Rune.Brush.Surface}" />
      </Style>
      <Style x:Key="Row" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </Style>
      <Style TargetType="rune:Icon">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
      </Style>
    </WrapPanel.Resources>
    <Border FlowDirection="LeftToRight">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="从左到右（中文、英文）" />
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.ChevronLeft}" FlipInRtl="True" /><TextBlock Text="返回" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><TextBlock Text="下一步" /><rune:Icon Data="{x:Static rune:Lucide.ArrowRight}" FlipInRtl="True" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.Clock}" /><TextBlock Text="刚刚更新" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.Check}" /><TextBlock Text="已读" /></StackPanel>
      </StackPanel>
    </Border>
    <Border FlowDirection="RightToLeft">
      <StackPanel>
        <TextBlock Style="{StaticResource Caption}" Text="从右到左（阿拉伯语、希伯来语）" />
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.ChevronLeft}" FlipInRtl="True" /><TextBlock Text="返回" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><TextBlock Text="下一步" /><rune:Icon Data="{x:Static rune:Lucide.ArrowRight}" FlipInRtl="True" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.Clock}" /><TextBlock Text="刚刚更新" /></StackPanel>
        <StackPanel Style="{StaticResource Row}"><rune:Icon Data="{x:Static rune:Lucide.Check}" /><TextBlock Text="已读" /></StackPanel>
      </StackPanel>
    </Border>
  </WrapPanel>
</UserControl>
