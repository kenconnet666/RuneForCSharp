<UserControl x:Class="Rune.Wpf.Examples.IconBasic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <WrapPanel>
    <WrapPanel.Resources>
      <Style TargetType="StackPanel">
        <Setter Property="Width" Value="88" />
        <Setter Property="Margin" Value="0,0,12,12" />
      </Style>
      <Style TargetType="rune:Icon">
        <Setter Property="Size" Value="xl" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Rune.Brush.TextMuted}" />
      </Style>
    </WrapPanel.Resources>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Search}" /><TextBlock Text="Search" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Bell}" /><TextBlock Text="Bell" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Heart}" /><TextBlock Text="Heart" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Settings}" /><TextBlock Text="Settings" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.House}" /><TextBlock Text="House" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.User}" /><TextBlock Text="User" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Mail}" /><TextBlock Text="Mail" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Calendar}" /><TextBlock Text="Calendar" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Camera}" /><TextBlock Text="Camera" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Cloud}" /><TextBlock Text="Cloud" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Download}" /><TextBlock Text="Download" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Folder}" /><TextBlock Text="Folder" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.MapPin}" /><TextBlock Text="MapPin" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.ShoppingCart}" /><TextBlock Text="ShoppingCart" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Star}" /><TextBlock Text="Star" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Zap}" /><TextBlock Text="Zap" /></StackPanel>
  </WrapPanel>
</UserControl>
