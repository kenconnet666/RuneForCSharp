<UserControl x:Class="Rune.Wpf.Examples.IconTones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <rune:Grid MinItemWidth="9rem" Gap="md">
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="neutral" Size="xl" /><rune:Text Size="sm">中性：正文色</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="muted" Size="xl" /><rune:Text Size="sm">次要</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.Sparkles}" Tone="accent" Size="xl" /><rune:Text Size="sm">品牌色</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.Info}" Tone="info" Size="xl" /><rune:Text Size="sm">信息</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.CircleCheck}" Tone="success" Size="xl" /><rune:Text Size="sm">成功</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.TriangleExclamationPoint}" Tone="warning" Size="xl" /><rune:Text Size="sm">警告</rune:Text></rune:Flex>
    <rune:Flex Gap="sm" Align="center"><rune:Icon Data="{x:Static rune:Lucide.CircleExclamationPoint}" Tone="danger" Size="xl" /><rune:Text Size="sm">危险</rune:Text></rune:Flex>
  </rune:Grid>
</UserControl>
