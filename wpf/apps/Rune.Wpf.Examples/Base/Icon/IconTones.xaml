<UserControl x:Class="Rune.Wpf.Examples.IconTones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <WrapPanel>
    <WrapPanel.Resources>
      <Style TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Width" Value="144" />
        <Setter Property="Margin" Value="0,0,12,12" />
      </Style>
      <Style TargetType="rune:Icon">
        <Setter Property="Size" Value="xl" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Rune.FontSize.Sm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </WrapPanel.Resources>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="neutral" /><TextBlock Text="中性：正文色" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.CircleUser}" Tone="muted" /><TextBlock Text="次要" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Sparkles}" Tone="accent" /><TextBlock Text="品牌色" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.Info}" Tone="info" /><TextBlock Text="信息" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.CircleCheck}" Tone="success" /><TextBlock Text="成功" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.TriangleExclamationPoint}" Tone="warning" /><TextBlock Text="警告" /></StackPanel>
    <StackPanel><rune:Icon Data="{x:Static rune:Lucide.CircleExclamationPoint}" Tone="danger" /><TextBlock Text="危险" /></StackPanel>
  </WrapPanel>
</UserControl>
