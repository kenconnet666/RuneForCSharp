<UserControl x:Class="Rune.Wpf.Examples.IconSizes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rune="https://github.com/kenconnet666/RuneForCSharp/wpf">
  <rune:Flex Direction="column" Gap="lg">
    <rune:Flex Gap="lg" Align="end" Wrap="True">
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="xs" /><rune:Small Tone="muted">xs</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="sm" /><rune:Small Tone="muted">sm</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="md" /><rune:Small Tone="muted">md</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="lg" /><rune:Small Tone="muted">lg</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="xl" /><rune:Small Tone="muted">xl</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Text Size="xl"><InlineUIContainer BaselineAlignment="Center"><rune:Icon Data="{x:Static rune:Lucide.Star}" /></InlineUIContainer> 星标</rune:Text><rune:Small Tone="muted">跟随文字</rune:Small></rune:Flex>
    </rune:Flex>
    <rune:Flex Gap="lg" Align="end" Wrap="True">
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="16" /><rune:Small Tone="muted">16px</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="24" /><rune:Small Tone="muted">24px</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" /><rune:Small Tone="muted">32px</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="48" /><rune:Small Tone="muted">48px</rune:Small></rune:Flex>
    </rune:Flex>
    <rune:Flex Gap="lg" Align="end" Wrap="True">
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" StrokeWidth="1" /><rune:Small Tone="muted">线宽 1</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" StrokeWidth="1.5" /><rune:Small Tone="muted">线宽 1.5</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" StrokeWidth="2" /><rune:Small Tone="muted">线宽 2</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" StrokeWidth="2.5" /><rune:Small Tone="muted">线宽 2.5</rune:Small></rune:Flex>
      <rune:Flex Direction="column" Align="center" Gap="xs"><rune:Icon Data="{x:Static rune:Lucide.Star}" Size="32" StrokeWidth="3" /><rune:Small Tone="muted">线宽 3</rune:Small></rune:Flex>
    </rune:Flex>
  </rune:Flex>
</UserControl>
