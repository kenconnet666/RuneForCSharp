<Project Sdk="Microsoft.NET.Sdk">

  <!-- 组件示例与登记表：Gallery 列出它们，inspect 按"组件/示例名"渲染与检查它们。示例名同 vue-tsx-pro 文档站上那一节的 id -->
  <PropertyGroup>
    <RootNamespace>Rune.Wpf.Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rune.Wpf\Rune.Wpf.csproj" />
  </ItemGroup>

  <!-- 示例的源文件作为嵌入资源：文档站的"显示代码"按示例切出来（ExampleSources） -->
  <ItemGroup>
    <EmbeddedResource Include="**\*.cs;**\*.xaml" Exclude="bin\**;obj\**" LogicalName="Source/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
